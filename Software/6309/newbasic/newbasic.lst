1016                  (     newbasic.asm):00048         FPA2      RMB  4              FLOATING POINT ACCUMULATOR #2 MANTISSA 
101A                  (     newbasic.asm):00049         BOTSTK    RMB  2              BOTTOM OF STACK AT LAST CHECK 
101C                  (     newbasic.asm):00050         TXTTAB    RMB  2              *PV BEGINNING OF BASIC PROGRAM 
101E                  (     newbasic.asm):00051         VARTAB    RMB  2              *PV START OF VARIABLES 
1020                  (     newbasic.asm):00052         ARYTAB    RMB  2              *PV START OF ARRAYS 
1022                  (     newbasic.asm):00053         ARYEND    RMB  2              *PV END OF ARRAYS (+1) 
1024                  (     newbasic.asm):00054         FRETOP    RMB  2              *PV START OF STRING STORAGE (TOP OF FREE RAM) 
1026                  (     newbasic.asm):00055         STRTAB    RMB  2              *PV START OF STRING VARIABLES 
1028                  (     newbasic.asm):00056         FRESPC    RMB  2              UTILITY STRING POINTER 
102A                  (     newbasic.asm):00057         MEMSIZ    RMB  2              *PV TOP OF STRING SPACE 
102C                  (     newbasic.asm):00058         OLDTXT    RMB  2              SAVED LINE NUMBER DURING A "STOP" 
102E                  (     newbasic.asm):00059         BINVAL    RMB  2              BINARY VALUE OF A CONVERTED LINE NUMBER 
1030                  (     newbasic.asm):00060         OLDPTR    RMB  2              SAVED INPUT PTR DURING A "STOP" 
1032                  (     newbasic.asm):00061         TINPTR    RMB  2              TEMPORARY INPUT POINTER STORAGE 
1034                  (     newbasic.asm):00062         DATTXT    RMB  2              *PV 'DATA' STATEMENT LINE NUMBER POINTER 
1036                  (     newbasic.asm):00063         DATPTR    RMB  2              *PV 'DATA' STATEMENT ADDRESS POINTER 
1038                  (     newbasic.asm):00064         DATTMP    RMB  2              DATA POINTER FOR 'INPUT' & 'READ' 
103A                  (     newbasic.asm):00065         VARNAM    RMB  2              *TV TEMP STORAGE FOR A VARIABLE NAME 
103C                  (     newbasic.asm):00066         VARPTR    RMB  2              *TV POINTER TO A VARIABLE DESCRIPTOR 
103E                  (     newbasic.asm):00067         VARDES    RMB  2              TEMP POINTER TO A VARIABLE DESCRIPTOR 
1040                  (     newbasic.asm):00068         RELPTR    RMB  2              POINTER TO RELATIONAL OPERATOR PROCESSING ROUTINE 
1042                  (     newbasic.asm):00069         TRELFL    RMB  1              TEMPORARY RELATIONAL OPERATOR FLAG BYTE 
                      (     newbasic.asm):00070         ; FLOATING POINT ACCUMULATORS #3,4 & 5 ARE MOSTLY                      
                      (     newbasic.asm):00071         ; USED AS SCRATCH PAD VARIABLES.                      
                      (     newbasic.asm):00072         ; FLOATING POINT ACCUMULATOR #3 :PACKED: ($40-$44)                      
1043                  (     newbasic.asm):00073         V40       RMB  1               
1044                  (     newbasic.asm):00074         V41       RMB  1               
1045                  (     newbasic.asm):00075         V42       RMB  1               
1046                  (     newbasic.asm):00076         V43       RMB  1               
1047                  (     newbasic.asm):00077         V44       RMB  1               
                      (     newbasic.asm):00078         ; FLOATING POINT ACCUMULATOR #4 :PACKED: ($45-$49)                      
1048                  (     newbasic.asm):00079         V45       RMB  1               
1049                  (     newbasic.asm):00080         V46       RMB  1               
104A                  (     newbasic.asm):00081         V47       RMB  1               
104B                  (     newbasic.asm):00082         V48       RMB  2               
                      (     newbasic.asm):00083         ; FLOATING POINT ACCUMULATOR #5 :PACKED: ($4A—$4E)                      
104D                  (     newbasic.asm):00084         V4A       RMB  1               
104E                  (     newbasic.asm):00085         V4B       RMB  2               
1050                  (     newbasic.asm):00086         V4D       RMB  2               
                      (     newbasic.asm):00087         ; FLOATING POINT ACCUMULATOR #0                      
1052                  (     newbasic.asm):00088         FP0EXP    RMB  1              *PV FLOATING POINT ACCUMULATOR #0 EXPONENT 
1053                  (     newbasic.asm):00089         FPA0      RMB  4              *PV FLOATING POINT ACCUMULATOR #0 MANTISSA 
1057                  (     newbasic.asm):00090         FP0SGN    RMB  1              *PV FLOATING POINT ACCUMULATOR #0 SIGN 
1058                  (     newbasic.asm):00091         COEFCT    RMB  1              POLYNOMIAL COEFFICIENT COUNTER 
1059                  (     newbasic.asm):00092         STRDES    RMB  5              TEMPORARY STRING DESCRIPTOR 
105E                  (     newbasic.asm):00093         FPCARY    RMB  1              FLOATING POINT CARRY BYTE 
                      (     newbasic.asm):00094         ; FLOATING POINT ACCUMULATOR #1                      
105F                  (     newbasic.asm):00095         FP1EXP    RMB  1              *PV FLOATING POINT ACCUMULATOR #1 EXPONENT 
1060                  (     newbasic.asm):00096         FPA1      RMB  4              *PV FLOATING POINT ACCUMULATOR #1 MANTISSA 
1064                  (     newbasic.asm):00097         FP1SGN    RMB  1              *PV FLOATING POINT ACCUMULATOR #1 SIGN 
1065                  (     newbasic.asm):00098         RESSGN    RMB  1              SIGN OF RESULT OF FLOATING POINT OPERATION 
1066                  (     newbasic.asm):00099         FPSBYT    RMB  1              FLOATING POINT SUB BYTE (FIFTH BYTE) 
1067                  (     newbasic.asm):00100         COEFPT    RMB  2              POLYNOMIAL COEFFICIENT POINTER 
1069                  (     newbasic.asm):00101         LSTTXT    RMB  2              CURRENT LINE POINTER DURING LIST 
106B                  (     newbasic.asm):00102         CURLIN    RMB  2              *PV CURRENT LINE # OF BASIC PROGRAM, $FFFF = DIRECT 
106D                  (     newbasic.asm):00103         DEVCFW    RMB  1              *TV TAB FIELD WIDTH 
106E                  (     newbasic.asm):00104         DEVLCF    RMB  1              *TV TAB ZONE 
106F                  (     newbasic.asm):00105         DEVPOS    RMB  1              *TV PRINT POSITION 
1070                  (     newbasic.asm):00106         DEVWID    RMB  1              *TV PRINT WIDTH 
1071                  (     newbasic.asm):00107         RSTFLG    RMB  1              *PV WARM START FLAG: $55=WARM, OTHER=COLD 
1072                  (     newbasic.asm):00108         RSTVEC    RMB  2              *PV WARM START VECTOR - JUMP ADDRESS FOR WARM START 
1074                  (     newbasic.asm):00109         TOPRAM    RMB  2              *PV TOP OF RAM 
1076                  (     newbasic.asm):00110         IKEYIM    RMB  1              *TV INKEY$ RAM IMAGE 
1077                  (     newbasic.asm):00111         ZERO      RMB  2              *PV DUMMY - THESE TWO BYTES ARE ALWAYS ZERO 
                      (     newbasic.asm):00112         ; THE FOLLOWING BYTES ARE MOVED DOWN FROM ROM                      
1079                  (     newbasic.asm):00113         LPTCFW    RMB  1              16 
107A                  (     newbasic.asm):00114         LPTLCF    RMB  1              112 
107B                  (     newbasic.asm):00115         LPTWID    RMB  1              132 
107C                  (     newbasic.asm):00116         LPTPOS    RMB  1              0 
107D                  (     newbasic.asm):00117         EXECJP    RMB  2              LB4AA 
                      (     newbasic.asm):00118                                        
                      (     newbasic.asm):00119         ; THIS ROUTINE PICKS UP THE NEXT INPUT CHARACTER FROM                      
                      (     newbasic.asm):00120         ; BASIC. THE ADDRESS OF THE NEXT BASIC BYTE TO BE                      
                      (     newbasic.asm):00121         ; INTERPRETED IS STORED AT CHARAD.
                      (     newbasic.asm):00122         ;
                      (     newbasic.asm):00123         ; this gets copied to RAM from ROM around LA123
                      (     newbasic.asm):00124         ;
107F                  (     newbasic.asm):00125         GETNCH    RMB  6
1085                  (     newbasic.asm):00126         GETCCH    RMB  1
1086                  (     newbasic.asm):00127         CHARAD    RMB  5
                      (     newbasic.asm):00128                                        
108B                  (     newbasic.asm):00129         VAB       RMB  1              LOW ORDER FOUR BYTES OF THE PRODUCT 
108C                  (     newbasic.asm):00130         VAC       RMB  1                 OF A FLOATING POINT MULTIPLICATION 
108D                  (     newbasic.asm):00131         VAD       RMB  1                 THESE BYTES ARE USE AS RANDOM DATA 
108E                  (     newbasic.asm):00132         VAE       RMB  1                 BY THE RND STATEMENT 
                      (     newbasic.asm):00133                                        
                      (     newbasic.asm):00134         ; EXTENDED BASIC VARIABLES                      
108F                  (     newbasic.asm):00135         TRCFLG    RMB  1              *PV TRACE FLAG 0=OFF ELSE=ON 
1090                  (     newbasic.asm):00136         USRADR    RMB  2              *PV ADDRESS OF THE START OF USR VECTORS 
                      (     newbasic.asm):00137                                        
                      (     newbasic.asm):00138         ; EXTENDED BASIC SCRATCH PAD VARIABLES                      
1092                  (     newbasic.asm):00139         VCF       RMB  2               
1094                  (     newbasic.asm):00140         VD1       RMB  2               
1096                  (     newbasic.asm):00141         VD3       RMB  2               
1098                  (     newbasic.asm):00142         VD5       RMB  2               
109A                  (     newbasic.asm):00143         VD7       RMB  1               
109B                  (     newbasic.asm):00144         VD8       RMB  1               
109C                  (     newbasic.asm):00145         VD9       RMB  1               
109D                  (     newbasic.asm):00146         VDA       RMB  1               
109E                  (     newbasic.asm):00147         SW3VEC    RMB  3               
10A1                  (     newbasic.asm):00148         SW2VEC    RMB  3               
10A4                  (     newbasic.asm):00149         SWIVEC    RMB  3               
10A7                  (     newbasic.asm):00150         NMIVEC    RMB  3               
10AA                  (     newbasic.asm):00151         IRQVEC    RMB  3               
10AD                  (     newbasic.asm):00152         FRQVEC    RMB  3               
10B0                  (     newbasic.asm):00153         USRJMP    RMB  3              JUMP ADDRESS FOR BASIC'S USR FUNCTION 
10B3                  (     newbasic.asm):00154         RVSEED    RMB  1              * FLOATING POINT RANDOM NUMBER SEED EXPONENT 
10B4                  (     newbasic.asm):00155                   RMB  4              * MANTISSA: INITIALLY SET TO $804FC75259 
                      (     newbasic.asm):00156                                        
                      (     newbasic.asm):00157         ;** USR FUNCTION VECTOR ADDRESSES (EX BASIC ONLY)                      
10B8                  (     newbasic.asm):00158         USR0      RMB  2              USR 0 VECTOR 
10BA                  (     newbasic.asm):00159                   RMB  2              USR 1 
10BC                  (     newbasic.asm):00160                   RMB  2              USR 2 
10BE                  (     newbasic.asm):00161                   RMB  2              USR 3 
10C0                  (     newbasic.asm):00162                   RMB  2              USR 4 
10C2                  (     newbasic.asm):00163                   RMB  2              USR 5 
10C4                  (     newbasic.asm):00164                   RMB  2              USR 6 
10C6                  (     newbasic.asm):00165                   RMB  2              USR 7 
10C8                  (     newbasic.asm):00166                   RMB  2              USR 8 
10CA                  (     newbasic.asm):00167                   RMB  2              USR 9 
                      (     newbasic.asm):00168                                        
10CC                  (     newbasic.asm):00169         STRSTK    RMB  8*5            STRING DESCRIPTOR STACK 
10F4                  (     newbasic.asm):00170         LINHDR    RMB  2              LINE INPUT BUFFER HEADER 
10F6                  (     newbasic.asm):00171         LINBUF    RMB  LBUFMX+1       BASIC LINE INPUT BUFFER 
11F1                  (     newbasic.asm):00172         STRBUF    RMB  41             STRING BUFFER 
                      (     newbasic.asm):00173                                        
