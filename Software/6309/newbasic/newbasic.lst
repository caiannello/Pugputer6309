                      (     newbasic.asm):00175         ;------------------------------------------------------------------------------
                      (     newbasic.asm):00176         ; BEGIN PROGRAM CODE
                      (     newbasic.asm):00177         ;------------------------------------------------------------------------------
                      (     newbasic.asm):00178                   ORG  $9000           
                      (     newbasic.asm):00179         ;------------------------------------------------------------------------------
                      (     newbasic.asm):00180         ; SERIAL ROUTINES
                      (     newbasic.asm):00181         ;------------------------------------------------------------------------------                               
                      (     newbasic.asm):00182         ; Wait for a keystroke from the console.
9000 8D03             (     newbasic.asm):00183         KEYWAIT   BSR  KEYIN          ; GET A CHARACTER FROM CONSOLE IN 
9002 27FC             (     newbasic.asm):00184                   BEQ  KEYWAIT        ; LOOP IF NO KEY DOWN 
9004 39               (     newbasic.asm):00185                   RTS                  
                      (     newbasic.asm):00186                                        
                      (     newbasic.asm):00187         ; THIS ROUTINE GETS A KEYSTROKE FROM THE KEYBOARD IF A KEY                      
                      (     newbasic.asm):00188         ; IS DOWN. IT RETURNS ZERO TRUE IF THERE WAS NO KEY DOWN.                      
9005 BDFEA3           (     newbasic.asm):00189         KEYIN     JSR  BF_UT_GETC
9008 847F             (     newbasic.asm):00190                   ANDA #$7F            
900A 39               (     newbasic.asm):00191                   RTS                  
                      (     newbasic.asm):00192                                        
                      (     newbasic.asm):00193         ; CONSOLE OUT                      
900B BDFEAF           (     newbasic.asm):00194         PUTCHR    JSR  BF_UT_WAITTX
900E 3402             (     newbasic.asm):00195                   PSHS A               
9010 810D             (     newbasic.asm):00196                   CMPA #CR            IS IT CARRIAGE RETURN? 
9012 270E             (     newbasic.asm):00197                   BEQ  NEWLINE        YES 
9014 BDFEA9           (     newbasic.asm):00198                   JSR  BF_UT_PUTC
9017 7C107C           (     newbasic.asm):00199                   INC  LPTPOS         INCREMENT CHARACTER COUNTER 
901A B6107C           (     newbasic.asm):00200                   LDA  LPTPOS         CHECK FOR END OF LINE PRINTER LINE 
901D B1107B           (     newbasic.asm):00201                   CMPA LPTWID         AT END OF LINE PRINTER LINE? 
9020 2513             (     newbasic.asm):00202                   BLO  PUTEND         NO 
9022 7F107C           (     newbasic.asm):00203         NEWLINE   CLR  LPTPOS         RESET CHARACTER COUNTER 
9025 BDFEAF           (     newbasic.asm):00204                   JSR  BF_UT_WAITTX
9028 860D             (     newbasic.asm):00205                   LDA  #CR
902A BDFEA9           (     newbasic.asm):00206                   JSR  BF_UT_PUTC
