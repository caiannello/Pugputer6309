                      (     newbasic.asm):00992         ; FOR                          
                      (     newbasic.asm):00993         ;                              
                      (     newbasic.asm):00994         ; THE FOR COMMAND WILL STORE 18 BYTES ON THE STACK FOR                      
                      (     newbasic.asm):00995         ; EACH FOR-NEXT LOOP WHICH IS BEING PROCESSED. THESE                      
                      (     newbasic.asm):00996         ; BYTES ARE DEFINED AS FOLLOWS: 0- $80 (FOR FLAG);                      
                      (     newbasic.asm):00997         ;         1,2=INDEX VARIABLE DESCRIPTOR POINTER; 3-7=FP VALUE OF STEP;  
                      (     newbasic.asm):00998         ;         8=STEP DIRECTION: $FF IF NEGATIVE; 0 IF ZERO; 1 IF POSITIVE;  
                      (     newbasic.asm):00999         ; 9-13=FP VALUE OF ‘TO’ PARAMETER;                      
                      (     newbasic.asm):01000         ; 14,15=CURRENT LINE NUMBER; 16,17=RAM ADDRESS OF THE END                      
                      (     newbasic.asm):01001         ;         OF   THE LINE CONTAINING THE ‘FOR’ STATEMENT  
