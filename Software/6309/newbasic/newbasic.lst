                      (     newbasic.asm):03707         ; SIN                          
                      (     newbasic.asm):03708         ; THE SIN FUNCTION REQUIRES AN ARGUMENT IN RADIANS AND WILL REPEAT ITSELF EVERY                      
                      (     newbasic.asm):03709         ; 2*PI RADIANS. THE ARGUMENT IS DIVIDED BY 2*PI AND ONLY THE FRACTIONAL PART IS                      
                      (     newbasic.asm):03710         ; RETAINED. SINCE THE ARGUMENT WAS DIVIDED BY 2*P1, THE COEFFICIENTS MUST BE                      
                      (     newbasic.asm):03711         ; MULTIPLIED BY THE APPROPRIATE POWER OF 2*PI.                      
                      (     newbasic.asm):03712                                        
                      (     newbasic.asm):03713         ; SIN IS EVALUATED USING THE TRIGONOMETRIC IDENTITIES BELOW:                      
                      (     newbasic.asm):03714         ; SIN(X)=SIN(PI-X) & -SIN(PI/2-X)=SIN((3*PI)/2+X)                      
EB27 BDE79A           (     newbasic.asm):03715         SIN       JSR  LBC5F          COPY FPA0 TO FPA1 
EB2A 8EEB73           (     newbasic.asm):03716                   LDX  #LBFBD         POINT (X) TO 2*PI 
EB2D F61064           (     newbasic.asm):03717                   LDB  FP1SGN         *GET MANTISSA SIGN OF FPA1 
EB30 BDE68B           (     newbasic.asm):03718                   JSR  LBB89          *AND DIVIDE FPA0 BY 2*PI 
EB33 BDE79A           (     newbasic.asm):03719                   JSR  LBC5F          COPY FPA0 TO FPA1 
EB36 8DA3             (     newbasic.asm):03720                   BSR  LBF38          CONVERT FPA0 TO AN INTEGER 
EB38 7F1065           (     newbasic.asm):03721                   CLR  RESSGN         SET RESULT SIGN = POSITIVE 
EB3B B6105F           (     newbasic.asm):03722                   LDA  FP1EXP         *GET EXPONENT OF FPA1 
EB3E F61052           (     newbasic.asm):03723                   LDB  FP0EXP         *GET EXPONENT OF FPA0 
