                      (     newbasic.asm):01010         ; MATCHED ‘FOR/NEXT’ DATA SO THE NEW DATA WILL                      
                      (     newbasic.asm):01011         ; OVERLAY THE OLD DATA. THIS WILL ALSO DESTROY                      
                      (     newbasic.asm):01012         ; ALL OF THE ‘RETURN’ AND ‘FOR/NEXT’ DATA BELOW                      
                      (     newbasic.asm):01013         ; THIS POINT ON THE STACK                      
