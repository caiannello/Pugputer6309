335A 35C0             (../MS Extended BA):05313         L9200     PULS U,PC           RESTORE BUFFER POINTER AND RETURN 
                      (../MS Extended BA):05314         ;                              
                      (../MS Extended BA):05315         ; CONVERT FPA0 INTO AN INTEGER, THEN DECODE IT                      
                      (../MS Extended BA):05316         ; INTO A DECIMAL ASCII STRING IN THE BUFFER                      
335C 3440             (../MS Extended BA):05317         L9202     PSHS U              SAVE BUFFER POINTER 
335E BD2118           (../MS Extended BA):05318                   JSR  LB9B4          ADD .5 TO FPA0 (ROUND OFF) 
3361 BD242C           (../MS Extended BA):05319                   JSR  LBCC8          CONVERT FPA0 TO INTEGER FORMAT 
3364 3540             (../MS Extended BA):05320                   PULS U              RESTORE BUFFER POINTER 
                      (../MS Extended BA):05321         ;                              
                      (../MS Extended BA):05322         ; CONVERT FPA0 INTO A DECIMAL ASCII STRING                      
3366 8E2629           (../MS Extended BA):05323                   LDX  #LBEC5         POINT X TO UNNORMALIZED POWERS OF 10 
3369 C680             (../MS Extended BA):05324                   LDB  #$80           INITIALIZE DIGIT COUNTER TO 0 + $80. 
                      (../MS Extended BA):05325         ; BIT 7 SET IS USED TO INDICATE THAT THE POWER OF 10 MANTISSA                      
                      (../MS Extended BA):05326         ; IS NEGATIVE. WHEN YOU ‘ADD’ A NEGATIVE MANTISSA, IT IS                      
                      (../MS Extended BA):05327         ; THE SAME AS SUBTRACTING A POSITIVE ONE AND BIT 7 OF ACCB                      
                      (../MS Extended BA):05328         ; IS HOW THIS ROUTINE KNOWS THAT A ‘SUBTRACTION’ IS OCCURRING.                      
336B 8D36             (../MS Extended BA):05329         L9211     BSR  L9249          CHECK FOR COMMA INSERTION 
336D 9653             (../MS Extended BA):05330         L9213     LDA  FPA0+3         * ‘ADD’ A POWER OF 10 MANTISSA TO FPA0. 
336F AB03             (../MS Extended BA):05331                   ADDA $03,X          * IF THE MANTISSA IS NEGATIVE, A SUBTRACTION 
3371 9753             (../MS Extended BA):05332                   STA  FPA0+3         * WILL BE WHAT REALLY TAKES PLACE. 
3373 9652             (../MS Extended BA):05333                   LDA  FPA0+2         * 
3375 A902             (../MS Extended BA):05334                   ADCA $02,X          * 
3377 9752             (../MS Extended BA):05335                   STA  FPA0+2         * 
3379 9651             (../MS Extended BA):05336                   LDA  FPA0+1         * 
337B A901             (../MS Extended BA):05337                   ADCA $01,X          * 
337D 9751             (../MS Extended BA):05338                   STA  FPA0+1         * 
337F 9650             (../MS Extended BA):05339                   LDA  FPA0           * 
3381 A984             (../MS Extended BA):05340                   ADCA ,X             * 
3383 9750             (../MS Extended BA):05341                   STA  FPA0           * 
3385 5C               (../MS Extended BA):05342                   INCB                ADD ONE TO DIGIT COUNTER 
3386 56               (../MS Extended BA):05343                   RORB ROTATE CARRY INTO BIT 7  
3387 59               (../MS Extended BA):05344                   ROLB                * SET OVERFLOW FLAG - BRANCH IF CARRY SET AND 
3388 28E3             (../MS Extended BA):05345                   BVC  L9213          * ADDING MANTISSA OR CARRY CLEAR AND SUBTRACTING MANTISSA 
338A 2403             (../MS Extended BA):05346                   BCC  L9235          BRANCH IF SUBTRACTING MANTISSA 
338C C00B             (../MS Extended BA):05347                   SUBB #10+1          WAS SUBB #10+1 
338E 50               (../MS Extended BA):05348                   NEGB                * IF ADDING MANTISSA 
338F CB2F             (../MS Extended BA):05349         L9235     ADDB #$2F           WAS ADDB #'0'-1 
3391 3004             (../MS Extended BA):05350                   LEAX $04,X          MOVE TO NEXT POWER OF 10 MANTISSA 
3393 1F98             (../MS Extended BA):05351                   TFR  B,A            SAVE DIGIT IN ACCA 
3395 847F             (../MS Extended BA):05352                   ANDA #$7F           MASK OFF ADD/SUBTRACT FLAG (BIT 7) 
3397 A7C0             (../MS Extended BA):05353                   STA  ,U+            STORE DIGIT IN BUFFER 
3399 53               (../MS Extended BA):05354                   COMB                TOGGLE ADD/SUBTRACT FLAG 
339A C480             (../MS Extended BA):05355                   ANDB #$80           MASK OFF EVERYTHING BUT ADD/SUB FLAG 
339C 8C264D           (../MS Extended BA):05356                   CMPX #LBEE9         COMPARE TO END OF UNNORMALIZED POWERS OF 10 
339F 26CA             (../MS Extended BA):05357                   BNE  L9211          BRANCH IF NOT DONE 
33A1 6FC4             (../MS Extended BA):05358                   CLR  ,U             PUT A ZERO AT END OF INTEGER 
                      (../MS Extended BA):05359                                        
                      (../MS Extended BA):05360         ; DECREMENT DECIMAL POINT COUNTER AND CHECK FOR COMMA INSERTION                      
33A3 0A45             (../MS Extended BA):05361         L9249     DEC  V45            DECREMENT DECIMAL POINT COUNTER 
33A5 2609             (../MS Extended BA):05362                   BNE  L9256          NOT TIME FOR DECIMAL POINT 
33A7 DF39             (../MS Extended BA):05363         L924D     STU  VARPTR         SAVE BUFFER POINTER-POSITION OF THE DECIMAL POINT 
33A9 862E             (../MS Extended BA):05364                   LDA  #'.'           * STORE A DECIMAL 
33AB A7C0             (../MS Extended BA):05365                   STA  ,U+            * POINT IN THE OUTPUT BUFFER 
33AD 0F97             (../MS Extended BA):05366                   CLR  VD7            * CLEAR COMMA COUNTER - NOW IT WILL TAKE 255 
                      (../MS Extended BA):05367         ;                             * DECREMENTS BEFORE ANOTHER COMMA WILL BE INSERTED 
33AF 39               (../MS Extended BA):05368                   RTS                  
33B0 0A97             (../MS Extended BA):05369         L9256     DEC  VD7            DECREMENT COMMA COUNTER 
33B2 2608             (../MS Extended BA):05370                   BNE  L9262          RETURN IF NOT TIME FOR COMMA 
33B4 8603             (../MS Extended BA):05371                   LDA  #$03           * RESET COMMA COUNTER TO 3; THREE 
33B6 9797             (../MS Extended BA):05372                   STA  VD7            * DIGITS BETWEEN COMMAS 
33B8 862C             (../MS Extended BA):05373                   LDA  #','           * PUT A COMMA INTO 
33BA A7C0             (../MS Extended BA):05374                   STA  ,U+            * THE BUFFER 
33BC 39               (../MS Extended BA):05375         L9262     RTS                  
                      (../MS Extended BA):05376                                        
                      (../MS Extended BA):05377         ; INITIALIZE DECIMAL POINT AND COMMA COUNTERS                      
33BD 9647             (../MS Extended BA):05378         L9263     LDA  V47            GET THE BASE 10 EXPONENT OFFSET 
33BF 8B0A             (../MS Extended BA):05379                   ADDA #10            * ADD 10 (FPA0 WAS ‘NORMALIZED’ TO 9 PLACES LEFT 
33C1 9745             (../MS Extended BA):05380                   STA  V45            * OF DECIMAL POINT) - SAVE IN DECIMAL POINT COUNTER 
33C3 4C               (../MS Extended BA):05381                   INCA                ADD ONE FOR THE DECIMAL POINT 
33C4 8003             (../MS Extended BA):05382         L926A     SUBA #$03           * DIVIDE DECIMAL POINT COUNTER BY 3; LEAVE 
33C6 24FC             (../MS Extended BA):05383                   BCC  L926A          * THE REMAINDER IN ACCA 
33C8 8B05             (../MS Extended BA):05384                   ADDA #$05           CONVERT REMAINDER INTO A NUMBER FROM 1-3 
33CA 9797             (../MS Extended BA):05385                   STA  VD7            SAVE COMMA COUNTER 
33CC 969A             (../MS Extended BA):05386                   LDA  VDA            GET STATUS BYTE 
33CE 8440             (../MS Extended BA):05387                   ANDA #$40           CHECK FOR COMMA FLAG 
33D0 2602             (../MS Extended BA):05388                   BNE  L927A          BRANCH IF COMMA FLAG ACTIVE 
33D2 9797             (../MS Extended BA):05389                   STA  VD7            CLEAR COMMA COUNTER - 255 DIGITS OUTPUT BEFORE A COMMA 
33D4 39               (../MS Extended BA):05390         L927A     RTS                  
                      (../MS Extended BA):05391         ;                              
                      (../MS Extended BA):05392         ; INSERT ACCA ZEROES INTO THE BUFFER                      
33D5 3402             (../MS Extended BA):05393         L927B     PSHS A              SAVE ZEROES COUNTER 
33D7 8DCA             (../MS Extended BA):05394                   BSR  L9249          CHECK FOR DECIMAL POINT 
33D9 3502             (../MS Extended BA):05395                   PULS A              RESTORE ZEROES COUNTER 
33DB 4A               (../MS Extended BA):05396         L9281     DECA                * DECREMENT ZEROES COUNTER AND 
33DC 2B0A             (../MS Extended BA):05397                   BMI  L928E          * RETURN IF < 0 
33DE 3402             (../MS Extended BA):05398                   PSHS A              SAVE ZEROES COUNTER 
33E0 8630             (../MS Extended BA):05399                   LDA  #'0'           * PUT A ZERO INTO 
33E2 A7C0             (../MS Extended BA):05400                   STA  ,U+            * THE BUFFER 
33E4 A6E0             (../MS Extended BA):05401                   LDA  ,S+            RESTORE THE ZEROES COUNTER 
33E6 26ED             (../MS Extended BA):05402                   BNE  L927B          BRANCH IF NOT DONE 
33E8 39               (../MS Extended BA):05403         L928E     RTS                  
                      (../MS Extended BA):05404         
                      (../MS Extended BA):05405         
                      (../MS Extended BA):05406         ;
