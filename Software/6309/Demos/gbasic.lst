                      (       gbasic.asm):00001         ; -----------------------------------------------------------------------------
                      (       gbasic.asm):00002         ; Microsoft Extended BASIC adapted for the Pugputer 6309 bootloader.
                      (       gbasic.asm):00003         ; -----------------------------------------------------------------------------
                      (       gbasic.asm):00004         ; The original BASIC expects these console entry points.
     3427             (       gbasic.asm):00005         KEYIN       EQU  GBASIC_KEYIN
     3435             (       gbasic.asm):00006         PUTCHR      EQU  GBASIC_PUTCHR
     3453             (       gbasic.asm):00007         KEYWAIT     EQU  GBASIC_KEYWAIT
                      (       gbasic.asm):00008         
                      (       gbasic.asm):00009             INCLUDE "../MS Extended BASIC/gbasic.asm"
                      (../MS Extended BA):00001         ; -----------------------------------------------------------------------------
                      (../MS Extended BA):00002         ; Microsoft Extended BASIC for 6809, 1982 release
                      (../MS Extended BA):00003         ;
                      (../MS Extended BA):00004         ; Transcribed and stripped of Color-Computer specific stuff by Grant Searle, 
                      (../MS Extended BA):00005         ; working from the book "Extended BASIC Unravelled", by Walter K. Zydhek.
                      (../MS Extended BA):00006         ;
                      (../MS Extended BA):00007         ; In 2014, it was adapted by Tom Circuit to compile under lwtools 4.10.
                      (../MS Extended BA):00008         ;
                      (../MS Extended BA):00009         ; In 2022-2023 this version has been expanded by Craig Iannello to support
                      (../MS Extended BA):00010         ; the following additional hardware:
                      (../MS Extended BA):00011         ; 
                      (../MS Extended BA):00012         ; Rockwell  R65C51P2         Serial UART
                      (../MS Extended BA):00013         ; Yamaha    V9958            Video Display Processor
                      (../MS Extended BA):00014         ; Pugbutt   Mega-Multipass   Sound / SD Card / IO Card
                      (../MS Extended BA):00015         ;
                      (../MS Extended BA):00016         ; target toolchain: lwtools lwasm ver 4.10 
                      (../MS Extended BA):00017         ;
                      (../MS Extended BA):00018         ; Authors' sites:
                      (../MS Extended BA):00019         ;
                      (../MS Extended BA):00020         ; http://searle.x10host.com/6809/Simple6809.html
                      (../MS Extended BA):00021         ; https://github.com/tomcircuit/hd6309sbc
                      (../MS Extended BA):00022         ; https://github.com/caiannello/pugputer
                      (../MS Extended BA):00023         ; https://youtube.com/appliedcryogenics
                      (../MS Extended BA):00024         ;
                      (../MS Extended BA):00025         ; -----------------------------------------------------------------------------
                      (../MS Extended BA):00026             INCLUDE DEFINES.D           ; COMMON DEFINITIONS
                      (        DEFINES.D):00001         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00002         ; IO DEVICE BASE ADDRESSES
                      (        DEFINES.D):00003         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00004         
     FFEC             (        DEFINES.D):00005         BANK_BASE   EQU  $FFEC      : FFEC - FFEF: MEMORY BANK REGS 0...3 (BUILT-IN)
     FFE8             (        DEFINES.D):00006         ACIA_BASE   EQU  $FFE8      ; FFE8 - FFEB: SERIAL UART R65C51P2 (BUILT-IN)
     FFE4             (        DEFINES.D):00007         VDP_BASE    EQU  $FFE4      ; FFE4 - FFE7: VIDEO CHIP V9958
     FFE0             (        DEFINES.D):00008         OPL3_BASE   EQU  $FFE0      ; FFE0 - FFE3: MUSIC CHIP YMF262 (OPL3)
     FFB0             (        DEFINES.D):00009         VIA_BASE    EQU  $FFB0      ; FFB0 - FFBF: W65C22 VIA (SD CARD, SPI, KB, GPIO)
                      (        DEFINES.D):00010         
                      (        DEFINES.D):00011         ; V9958 VDP REGISTERS
     FFE4             (        DEFINES.D):00012         VDAT        EQU  VDP_BASE+0 ; PORT 0: VRAM DATA (R/W)
     FFE5             (        DEFINES.D):00013         VREG        EQU  VDP_BASE+1 ; PORT 1: STATUS REG (R), REGISTER/SETUP (W), VRAM ADDR (W)
     FFE6             (        DEFINES.D):00014         VPAL        EQU  VDP_BASE+2 ; PORT 2: PALETTE REGISTERS (W)
     FFE7             (        DEFINES.D):00015         VIND        EQU  VDP_BASE+3 ; PORT 3: REGISTER-INDIRECT ADDRESSING (W)
                      (        DEFINES.D):00016         
                      (        DEFINES.D):00017         ; MEMORY BANK REGISTERS 0..3 (BASE ADDRESS IN DEFINES.D)
                      (        DEFINES.D):00018         ; THESE ARE WRITE-ONLY, SO WE KEEP COPIES OF 1 THROUGH 3 IN 
                      (        DEFINES.D):00019         ; VARS IN MAIN.ASM: SBANK_1...SBANK_3
                      (        DEFINES.D):00020         
     FFEC             (        DEFINES.D):00021         MBANK_0     EQU  BANK_BASE+0
     FFED             (        DEFINES.D):00022         MBANK_1     EQU  BANK_BASE+1
     FFEE             (        DEFINES.D):00023         MBANK_2     EQU  BANK_BASE+2
     FFEF             (        DEFINES.D):00024         MBANK_3     EQU  BANK_BASE+3
                      (        DEFINES.D):00025         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00026         ; COMMON DEFINITIONS
                      (        DEFINES.D):00027         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00028         ; ASCII CODES
     001B             (        DEFINES.D):00029         ESC         EQU  $1B    ; ESCAPE
     000A             (        DEFINES.D):00030         LF          EQU  $0A    ; LINE FEED
     000D             (        DEFINES.D):00031         CR          EQU  $0D    ; CARRIAGE RETURN
     0000             (        DEFINES.D):00032         NUL         EQU  $00    ; NULL
     0020             (        DEFINES.D):00033         SPACE       EQU  $20
     007E             (        DEFINES.D):00034         TILDE       EQU  $7E
                      (        DEFINES.D):00035         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00036         _DATE       STRUCT
0000s                 (        DEFINES.D):00037         YEAR        RMB  2      ; DATE AS INTEGERS
0002s                 (        DEFINES.D):00038         DAYYR       RMB  2
0004s                 (        DEFINES.D):00039         MON         RMB  1
0005s                 (        DEFINES.D):00040         DAYMON      RMB  1
0006s                 (        DEFINES.D):00041         HOUR        RMB  1
0007s                 (        DEFINES.D):00042         MIN         RMB  1
0008s                 (        DEFINES.D):00043         SEC         RMB  1
0009s                 (        DEFINES.D):00044         HUND        RMB  1
000As                 (        DEFINES.D):00045         YEARBCD     RMB  2      ; DATE AS BCD
000Cs                 (        DEFINES.D):00046         DAYYRBCD    RMB  2
000Es                 (        DEFINES.D):00047         MONBCD      RMB  1
000Fs                 (        DEFINES.D):00048         DAYMONBCD   RMB  1
0010s                 (        DEFINES.D):00049         HOURBCD     RMB  1
0011s                 (        DEFINES.D):00050         MINBCD      RMB  1
0012s                 (        DEFINES.D):00051         SECBCD      RMB  1
0013s                 (        DEFINES.D):00052         HUNDBCD     RMB  1
0014s                 (        DEFINES.D):00053                     ENDS
                      (        DEFINES.D):00054         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00055         ; EOF
                      (        DEFINES.D):00056         ;------------------------------------------------------------------------------
                      (../MS Extended BA):00027             INCLUDE BIOS_FUNC_TAB.D     ; BIOS FCN JUMP TABLE AND CONSTANTS
                      (  BIOS_FUNC_TAB.D):00001         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00002         ; BIOS BIOS FUNCTION JUMP TABLE ADDRESSES
                      (  BIOS_FUNC_TAB.D):00003         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00004         FUNC_BASE       EQU  $FEA0          ; SEE 6309/BOOT/MAIN.ASM FOR DEFS
                      (  BIOS_FUNC_TAB.D):00005         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00006         BF_V_RESET      EQU  FUNC_BASE+0
     FEA3             (  BIOS_FUNC_TAB.D):00007         BF_UT_GETC      EQU  FUNC_BASE+3
     FEA6             (  BIOS_FUNC_TAB.D):00008         BF_UT_GETS      EQU  FUNC_BASE+6
     FEA9             (  BIOS_FUNC_TAB.D):00009         BF_UT_PUTC      EQU  FUNC_BASE+9    ;
     FEAC             (  BIOS_FUNC_TAB.D):00010         BF_UT_PUTS      EQU  FUNC_BASE+12
     FEAF             (  BIOS_FUNC_TAB.D):00011         BF_UT_WAITTX    EQU  FUNC_BASE+15
     FEB2             (  BIOS_FUNC_TAB.D):00012         BF_UT_CLRSCR    EQU  FUNC_BASE+18
     FEB5             (  BIOS_FUNC_TAB.D):00013         BF_S_HEXA       EQU  FUNC_BASE+21   ; CONVERT REG A TO HEX OCTET AT X, X+=2
     FEB8             (  BIOS_FUNC_TAB.D):00014         BF_S_EOL        EQU  FUNC_BASE+24   ; PUT CR, LF, $00 AT X, X+=3
     FEBB             (  BIOS_FUNC_TAB.D):00015         BF_S_LEN        EQU  FUNC_BASE+27   ; PUT LEN OF STRING AT X INTO REG B
     FEBE             (  BIOS_FUNC_TAB.D):00016         BF_S_CPY        EQU  FUNC_BASE+30   ; COPY STRING AT Y TO MEM AT X. X+=?
     FEC1             (  BIOS_FUNC_TAB.D):00017         BF_RTC_GETTIX   EQU  FUNC_BASE+33   ; GET CURRENT SYSTEM TICKS TO I64 AT X.
     FEC4             (  BIOS_FUNC_TAB.D):00018         BF_S_TOUPPER    EQU  FUNC_BASE+36   ; MAKE A UPPERCASE IF IT IS LOWERCASE
     FEC7             (  BIOS_FUNC_TAB.D):00019         BF_S_INTD       EQU  FUNC_BASE+39   ; CONVERT REG D TO STRING AT X, X+=?
     FECA             (  BIOS_FUNC_TAB.D):00020         BF_RTC_SETTIX   EQU  FUNC_BASE+42   ; SET CURRENT SYSTEM TICKS FROM I64 AT X.
                      (  BIOS_FUNC_TAB.D):00021         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00022         ; EOF
                      (  BIOS_FUNC_TAB.D):00023         ;------------------------------------------------------------------------------
                      (../MS Extended BA):00028         ; -----------------------------------------------------------------------------
                      (../MS Extended BA):00029         
                      (../MS Extended BA):00030         ; CONSTANTS AND DEFINES
                      (../MS Extended BA):00031         
     0008             (../MS Extended BA):00032         BS        EQU  8              BACKSPACE 
                      (../MS Extended BA):00033         ;LF        EQU  $A             LINEFEED
                      (../MS Extended BA):00034         ;CR        EQU  $D             ENTER KEY 
                      (../MS Extended BA):00035         ;ESC       EQU  $1B            ESCAPE CODE 
                      (../MS Extended BA):00036         ;SPACE     EQU  $20            SPACE (BLANK) 
     003A             (../MS Extended BA):00037         STKBUF    EQU  58             STACK BUFFER ROOM 
     00FA             (../MS Extended BA):00038         LBUFMX    EQU  250            MAX NUMBER OF CHARS IN A BASIC LINE 
     00FA             (../MS Extended BA):00039         MAXLIN    EQU  $FA            MAXIMUM MS BYTE OF LINE NUMBER 
                      (../MS Extended BA):00040         
                      (../MS Extended BA):00041         ; PSEUDO OPS                      
     0021             (../MS Extended BA):00042         SKP1      EQU  $21            OP CODE OF BRN — SKIP ONE BYTE 
     008C             (../MS Extended BA):00043         SKP2      EQU  $8C            OP CODE OF CMPX # - SKIP TWO BYTES 
     0086             (../MS Extended BA):00044         SKP1LD    EQU  $86            OP CODE OF LDA # - SKIP THE NEXT BYTE 
                      (../MS Extended BA):00045         ;                             AND LOAD THE VALUE OF THAT BYTE INTO ACCA — THIS 
                      (../MS Extended BA):00046         ;                             IS USUALLY USED TO LOAD ACCA WITH A NON ZERO VALUE 
     1000             (../MS Extended BA):00047         BASIC_CODE   EQU  $1000       ; Bootloader loads and enters applications here
     4000             (../MS Extended BA):00048         BASIC_STATE  EQU  $4000       ; BASIC state is outside the bootloader RAM area
     F000             (../MS Extended BA):00049         RAM_TOP      EQU  $F000       ; Exclusive end of the default 64K RAM mapping
                      (../MS Extended BA):00050                   ORG  BASIC_STATE
     40               (../MS Extended BA):00051                   SETDP $40
                      (../MS Extended BA):00052         
4000                  (../MS Extended BA):00053         ENDFLG    RMB  1              STOP/END FLAG: POSITIVE=STOP, NEG=END 
4001                  (../MS Extended BA):00054         CHARAC    RMB  1              TERMINATOR FLAG 1 
4002                  (../MS Extended BA):00055         ENDCHR    RMB  1              TERMINATOR FLAG 2 
4003                  (../MS Extended BA):00056         TMPLOC    RMB  1              SCRATCH VARIABLE 
4004                  (../MS Extended BA):00057         IFCTR     RMB  1              IF COUNTER - HOW MANY IF STATEMENTS IN A LINE 
4005                  (../MS Extended BA):00058         DIMFLG    RMB  1              *DV* ARRAY FLAG 0=EVALUATE, 1=DIMENSIONING 
4006                  (../MS Extended BA):00059         VALTYP    RMB  1              *DV* *PV TYPE FLAG: 0=NUMERIC, $FF=STRING 
4007                  (../MS Extended BA):00060         GARBFL    RMB  1              *TV STRING SPACE HOUSEKEEPING FLAG 
4008                  (../MS Extended BA):00061         ARYDIS    RMB  1              DISABLE ARRAY SEARCH: 00=ALLOW SEARCH 
4009                  (../MS Extended BA):00062         INPFLG    RMB  1              *TV INPUT FLAG: READ=0, INPUT<>0 
400A                  (../MS Extended BA):00063         RELFLG    RMB  1              *TV RELATIONAL OPERATOR FLAG 
400B                  (../MS Extended BA):00064         TEMPPT    RMB  2              *PV TEMPORARY STRING STACK POINTER 
400D                  (../MS Extended BA):00065         LASTPT    RMB  2              *PV ADDR OF LAST USED STRING STACK ADDRESS 
400F                  (../MS Extended BA):00066         TEMPTR    RMB  2              TEMPORARY POINTER 
4011                  (../MS Extended BA):00067         TMPTR1    RMB  2              TEMPORARY DESCRIPTOR STORAGE (STACK SEARCH) 
4013                  (../MS Extended BA):00068         FPA2      RMB  4              FLOATING POINT ACCUMULATOR #2 MANTISSA 
4017                  (../MS Extended BA):00069         BOTSTK    RMB  2              BOTTOM OF STACK AT LAST CHECK 
4019                  (../MS Extended BA):00070         TXTTAB    RMB  2              *PV BEGINNING OF BASIC PROGRAM 
401B                  (../MS Extended BA):00071         VARTAB    RMB  2              *PV START OF VARIABLES 
401D                  (../MS Extended BA):00072         ARYTAB    RMB  2              *PV START OF ARRAYS 
401F                  (../MS Extended BA):00073         ARYEND    RMB  2              *PV END OF ARRAYS (+1) 
4021                  (../MS Extended BA):00074         FRETOP    RMB  2              *PV START OF STRING STORAGE (TOP OF FREE RAM) 
4023                  (../MS Extended BA):00075         STRTAB    RMB  2              *PV START OF STRING VARIABLES 
4025                  (../MS Extended BA):00076         FRESPC    RMB  2              UTILITY STRING POINTER 
4027                  (../MS Extended BA):00077         MEMSIZ    RMB  2              *PV TOP OF STRING SPACE 
4029                  (../MS Extended BA):00078         OLDTXT    RMB  2              SAVED LINE NUMBER DURING A "STOP" 
402B                  (../MS Extended BA):00079         BINVAL    RMB  2              BINARY VALUE OF A CONVERTED LINE NUMBER 
402D                  (../MS Extended BA):00080         OLDPTR    RMB  2              SAVED INPUT PTR DURING A "STOP" 
402F                  (../MS Extended BA):00081         TINPTR    RMB  2              TEMPORARY INPUT POINTER STORAGE 
4031                  (../MS Extended BA):00082         DATTXT    RMB  2              *PV 'DATA' STATEMENT LINE NUMBER POINTER 
4033                  (../MS Extended BA):00083         DATPTR    RMB  2              *PV 'DATA' STATEMENT ADDRESS POINTER 
4035                  (../MS Extended BA):00084         DATTMP    RMB  2              DATA POINTER FOR 'INPUT' & 'READ' 
4037                  (../MS Extended BA):00085         VARNAM    RMB  2              *TV TEMP STORAGE FOR A VARIABLE NAME 
4039                  (../MS Extended BA):00086         VARPTR    RMB  2              *TV POINTER TO A VARIABLE DESCRIPTOR 
403B                  (../MS Extended BA):00087         VARDES    RMB  2              TEMP POINTER TO A VARIABLE DESCRIPTOR 
403D                  (../MS Extended BA):00088         RELPTR    RMB  2              POINTER TO RELATIONAL OPERATOR PROCESSING ROUTINE 
403F                  (../MS Extended BA):00089         TRELFL    RMB  1              TEMPORARY RELATIONAL OPERATOR FLAG BYTE 
                      (../MS Extended BA):00090         ; FLOATING POINT ACCUMULATORS #3,4 & 5 ARE MOSTLY                      
                      (../MS Extended BA):00091         ; USED AS SCRATCH PAD VARIABLES.                      
                      (../MS Extended BA):00092         ; FLOATING POINT ACCUMULATOR #3 :PACKED: ($40-$44)                      
4040                  (../MS Extended BA):00093         V40       RMB  1               
4041                  (../MS Extended BA):00094         V41       RMB  1               
4042                  (../MS Extended BA):00095         V42       RMB  1               
4043                  (../MS Extended BA):00096         V43       RMB  1               
4044                  (../MS Extended BA):00097         V44       RMB  1               
                      (../MS Extended BA):00098         ; FLOATING POINT ACCUMULATOR #4 :PACKED: ($45-$49)                      
4045                  (../MS Extended BA):00099         V45       RMB  1               
4046                  (../MS Extended BA):00100         V46       RMB  1               
4047                  (../MS Extended BA):00101         V47       RMB  1               
4048                  (../MS Extended BA):00102         V48       RMB  2               
                      (../MS Extended BA):00103         ; FLOATING POINT ACCUMULATOR #5 :PACKED: ($4A—$4E)                      
404A                  (../MS Extended BA):00104         V4A       RMB  1               
404B                  (../MS Extended BA):00105         V4B       RMB  2               
404D                  (../MS Extended BA):00106         V4D       RMB  2               
                      (../MS Extended BA):00107         ; FLOATING POINT ACCUMULATOR #0                      
404F                  (../MS Extended BA):00108         FP0EXP    RMB  1              *PV FLOATING POINT ACCUMULATOR #0 EXPONENT 
4050                  (../MS Extended BA):00109         FPA0      RMB  4              *PV FLOATING POINT ACCUMULATOR #0 MANTISSA 
4054                  (../MS Extended BA):00110         FP0SGN    RMB  1              *PV FLOATING POINT ACCUMULATOR #0 SIGN 
4055                  (../MS Extended BA):00111         COEFCT    RMB  1              POLYNOMIAL COEFFICIENT COUNTER 
4056                  (../MS Extended BA):00112         STRDES    RMB  5              TEMPORARY STRING DESCRIPTOR 
405B                  (../MS Extended BA):00113         FPCARY    RMB  1              FLOATING POINT CARRY BYTE 
                      (../MS Extended BA):00114         ; FLOATING POINT ACCUMULATOR #1                      
405C                  (../MS Extended BA):00115         FP1EXP    RMB  1              *PV FLOATING POINT ACCUMULATOR #1 EXPONENT 
405D                  (../MS Extended BA):00116         FPA1      RMB  4              *PV FLOATING POINT ACCUMULATOR #1 MANTISSA 
4061                  (../MS Extended BA):00117         FP1SGN    RMB  1              *PV FLOATING POINT ACCUMULATOR #1 SIGN 
4062                  (../MS Extended BA):00118         RESSGN    RMB  1              SIGN OF RESULT OF FLOATING POINT OPERATION 
4063                  (../MS Extended BA):00119         FPSBYT    RMB  1              FLOATING POINT SUB BYTE (FIFTH BYTE) 
4064                  (../MS Extended BA):00120         COEFPT    RMB  2              POLYNOMIAL COEFFICIENT POINTER 
4066                  (../MS Extended BA):00121         LSTTXT    RMB  2              CURRENT LINE POINTER DURING LIST 
4068                  (../MS Extended BA):00122         CURLIN    RMB  2              *PV CURRENT LINE # OF BASIC PROGRAM, $FFFF = DIRECT 
406A                  (../MS Extended BA):00123         DEVCFW    RMB  1              *TV TAB FIELD WIDTH 
406B                  (../MS Extended BA):00124         DEVLCF    RMB  1              *TV TAB ZONE 
406C                  (../MS Extended BA):00125         DEVPOS    RMB  1              *TV PRINT POSITION 
406D                  (../MS Extended BA):00126         DEVWID    RMB  1              *TV PRINT WIDTH 
406E                  (../MS Extended BA):00127         RSTFLG    RMB  1              *PV WARM START FLAG: $55=WARM, OTHER=COLD 
406F                  (../MS Extended BA):00128         RSTVEC    RMB  2              *PV WARM START VECTOR - JUMP ADDRESS FOR WARM START 
4071                  (../MS Extended BA):00129         TOPRAM    RMB  2              *PV TOP OF RAM 
4073                  (../MS Extended BA):00130         IKEYIM    RMB  1              *TV INKEY$ RAM IMAGE 
4074                  (../MS Extended BA):00131         ZERO      RMB  2              *PV DUMMY - THESE TWO BYTES ARE ALWAYS ZERO 
                      (../MS Extended BA):00132         ; THE FOLLOWING BYTES ARE MOVED DOWN FROM ROM                      
4076                  (../MS Extended BA):00133         LPTCFW    RMB  1              16 
4077                  (../MS Extended BA):00134         LPTLCF    RMB  1              112 
4078                  (../MS Extended BA):00135         LPTWID    RMB  1              80 
4079                  (../MS Extended BA):00136         LPTPOS    RMB  1              0 
407A                  (../MS Extended BA):00137         EXECJP    RMB  2              LB4AA 
                      (../MS Extended BA):00138                                        
                      (../MS Extended BA):00139         ; THIS ROUTINE PICKS UP THE NEXT INPUT CHARACTER FROM                      
                      (../MS Extended BA):00140         ; BASIC. THE ADDRESS OF THE NEXT BASIC BYTE TO BE                      
                      (../MS Extended BA):00141         ; INTERPRETED IS STORED AT CHARAD.
                      (../MS Extended BA):00142         ;
                      (../MS Extended BA):00143         ; this gets copied to RAM from ROM around LA123
                      (../MS Extended BA):00144         ;
407C                  (../MS Extended BA):00145         GETNCH    RMB  6
4082                  (../MS Extended BA):00146         GETCCH    RMB  1
4083                  (../MS Extended BA):00147         CHARAD    RMB  5
                      (../MS Extended BA):00148                                        
4088                  (../MS Extended BA):00149         VAB       RMB  1              LOW ORDER FOUR BYTES OF THE PRODUCT 
4089                  (../MS Extended BA):00150         VAC       RMB  1                 OF A FLOATING POINT MULTIPLICATION 
408A                  (../MS Extended BA):00151         VAD       RMB  1                 THESE BYTES ARE USE AS RANDOM DATA 
408B                  (../MS Extended BA):00152         VAE       RMB  1                 BY THE RND STATEMENT 
                      (../MS Extended BA):00153                                        
                      (../MS Extended BA):00154         ; EXTENDED BASIC VARIABLES                      
408C                  (../MS Extended BA):00155         TRCFLG    RMB  1              *PV TRACE FLAG 0=OFF ELSE=ON 
408D                  (../MS Extended BA):00156         USRADR    RMB  2              *PV ADDRESS OF THE START OF USR VECTORS 
                      (../MS Extended BA):00157                                        
