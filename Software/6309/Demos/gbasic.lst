                      (../MS Extended BA):03816         ; LOG - NATURAL LOGARITHM (LN)                      
                      (../MS Extended BA):03817                                        
                      (../MS Extended BA):03818         ; THE NATURAL OR NAPERIAN LOGARITHM IS CALCULATED USING                      
                      (../MS Extended BA):03819         ; MATHEMATICAL IDENTITIES. FPA0 IS OF THE FORM FPA0=A*(2**B) (SCIENTIFIC                      
                      (../MS Extended BA):03820         ; NOTATION). THEREFORE, THE LOG ROUTINE DETERMINES THE VALUE OF                      
                      (../MS Extended BA):03821         ; LN(A*(2**B)). A SERIES OF MATHEMATICAL IDENTITIES WILL EXPAND THIS                      
                      (../MS Extended BA):03822         ; TERM: LN(A*(2**B))=(-1/2+(1/LN(2))*(LN(A*SQR(2)))+B)*LN(2). ALL OF                      
                      (../MS Extended BA):03823         ; THE TERMS OF THE LATTER EXPRESSION ARE CONSTANTS EXCEPT FOR THE                      
                      (../MS Extended BA):03824         ; LN(A*SQR(2)) TERM WHICH IS EVALUATED USING THE TAYLOR SERIES EXPANSION                      
281E BD23D1           (../MS Extended BA):03825         LOG       JSR  LBC6D          CHECK STATUS OF FPA0 
2821 102FF3C4         (../MS Extended BA):03826                   LBLE LB44A          ‘FC’ ERROR IF NEGATIVE OR ZERO 
2825 8E280A           (../MS Extended BA):03827                   LDX  #L8432         POINT (X) TO FP NUMBER (1/SQR(2)) 
2828 964F             (../MS Extended BA):03828                   LDA  FP0EXP         *GET EXPONENT OF ARGUMENT 
282A 8080             (../MS Extended BA):03829                   SUBA #$80           *SUBTRACT OFF THE BIAS AND 
282C 3402             (../MS Extended BA):03830                   PSHS A              *SAVE IT ON THE STACK 
282E 8680             (../MS Extended BA):03831                   LDA  #$80            
2830 974F             (../MS Extended BA):03832                   STA  FP0EXP          
2832 BD2126           (../MS Extended BA):03833                   JSR  LB9C2          ADD FPA0 TO (X) 
2835 8E280F           (../MS Extended BA):03834                   LDX  #L8437         POINT X TO SQR(2) 
2838 BD22F3           (../MS Extended BA):03835                   JSR  LBB8F          DIVIDE SQR(2) BY FPA0 
283B 8E2229           (../MS Extended BA):03836                   LDX  #LBAC5         POINT X TO FP VALUE OF 1.00 
283E BD211D           (../MS Extended BA):03837                   JSR  LB9B9          SUBTRACT FPA0 FROM (X) 
                      (../MS Extended BA):03838         ;         NOW  FPA0 = (1-SQR(2)*X)/(1+SQR(2)*X) WHERE X IS ARGUMENT  
2841 8E27F5           (../MS Extended BA):03839                   LDX  #L841D         POINT X TO TABLE OF COEFFICIENTS 
2844 BD2654           (../MS Extended BA):03840                   JSR  LBEF0          EXPAND POLYNOMIAL 
2847 8E2814           (../MS Extended BA):03841                   LDX  #L843C         POINT X TO FP VALUE OF (-.5) 
284A BD2126           (../MS Extended BA):03842                   JSR  LB9C2          ADD FPA0 TO X 
284D 3504             (../MS Extended BA):03843                   PULS B              GET EXPONENT OF ARGUMENT BACK (WITHOUT BIAS) 
284F BD24FD           (../MS Extended BA):03844                   JSR  LBD99          ADD ACCB TO FPA0 
2852 8E2819           (../MS Extended BA):03845                   LDX  #L8441         POINT X TO LN(2) 
2855 7E222E           (../MS Extended BA):03846                   JMP  LBACA          MULTIPLY FPA0 * LN(2) 
