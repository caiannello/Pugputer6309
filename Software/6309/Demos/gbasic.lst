                      (../MS Extended BA):03672         ; SIN                          
                      (../MS Extended BA):03673         ; THE SIN FUNCTION REQUIRES AN ARGUMENT IN RADIANS AND WILL REPEAT ITSELF EVERY                      
                      (../MS Extended BA):03674         ; 2*PI RADIANS. THE ARGUMENT IS DIVIDED BY 2*PI AND ONLY THE FRACTIONAL PART IS                      
                      (../MS Extended BA):03675         ; RETAINED. SINCE THE ARGUMENT WAS DIVIDED BY 2*P1, THE COEFFICIENTS MUST BE                      
                      (../MS Extended BA):03676         ; MULTIPLIED BY THE APPROPRIATE POWER OF 2*PI.                      
                      (../MS Extended BA):03677                                        
                      (../MS Extended BA):03678         ; SIN IS EVALUATED USING THE TRIGONOMETRIC IDENTITIES BELOW:                      
                      (../MS Extended BA):03679         ; SIN(X)=SIN(PI-X) & -SIN(PI/2-X)=SIN((3*PI)/2+X)                      
26D8 BD23C3           (../MS Extended BA):03680         SIN       JSR  LBC5F          COPY FPA0 TO FPA1 
26DB 8E271D           (../MS Extended BA):03681                   LDX  #LBFBD         POINT (X) TO 2*PI 
26DE D661             (../MS Extended BA):03682                   LDB  FP1SGN         *GET MANTISSA SIGN OF FPA1 
26E0 BD22ED           (../MS Extended BA):03683                   JSR  LBB89          *AND DIVIDE FPA0 BY 2*PI 
26E3 BD23C3           (../MS Extended BA):03684                   JSR  LBC5F          COPY FPA0 TO FPA1 
26E6 8DB4             (../MS Extended BA):03685                   BSR  LBF38          CONVERT FPA0 TO AN INTEGER 
26E8 0F62             (../MS Extended BA):03686                   CLR  RESSGN         SET RESULT SIGN = POSITIVE 
26EA 965C             (../MS Extended BA):03687                   LDA  FP1EXP         *GET EXPONENT OF FPA1 
26EC D64F             (../MS Extended BA):03688                   LDB  FP0EXP         *GET EXPONENT OF FPA0 
26EE BD2120           (../MS Extended BA):03689                   JSR  LB9BC          *SUBTRACT FPA0 FROM FPA1 
                      (../MS Extended BA):03690         ; NOW FPA0 CONTAINS ONLY THE FRACTIONAL PART OF ARGUMENT/2*PI                      
26F1 8E2722           (../MS Extended BA):03691                   LDX  #LBFC2         POINT X TO FP (.25) 
26F4 BD211D           (../MS Extended BA):03692                   JSR  LB9B9          SUBTRACT FPA0 FROM .25 (PI/2) 
26F7 9654             (../MS Extended BA):03693                   LDA  FP0SGN         GET MANTISSA SIGN OF FPA0 
26F9 3402             (../MS Extended BA):03694                   PSHS A              SAVE IT ON STACK 
26FB 2A09             (../MS Extended BA):03695                   BPL  LBFA6          BRANCH IF MANTISSA POSITIVE 
26FD BD2118           (../MS Extended BA):03696                   JSR  LB9B4          ADD .5 (PI) TO FPA0 
2700 9654             (../MS Extended BA):03697                   LDA  FP0SGN         GET SIGN OF FPA0 
2702 2B05             (../MS Extended BA):03698                   BMI  LBFA9          BRANCH IF NEGATIVE 
2704 030A             (../MS Extended BA):03699                   COM  RELFLG         COM IF +(3*PI)/2 >= ARGUMENT >+ PI/2 (QUADRANT FLAG) 
2706 BD264D           (../MS Extended BA):03700         LBFA6     JSR  LBEE9          TOGGLE MANTISSA SIGN OF FPA0 
2709 8E2722           (../MS Extended BA):03701         LBFA9     LDX  #LBFC2         POINT X TO FP (.25) 
270C BD2126           (../MS Extended BA):03702                   JSR  LB9C2          ADD .25 (PI/2) TO FPA0 
270F 3502             (../MS Extended BA):03703                   PULS A              GET OLD MANTISSA SIGN 
2711 4D               (../MS Extended BA):03704                   TSTA                * BRANCH IF OLD 
2712 2A03             (../MS Extended BA):03705                   BPL  LBFB7          * SIGN WAS POSITIVE 
2714 BD264D           (../MS Extended BA):03706                   JSR  LBEE9          TOGGLE MANTISSA SIGN 
