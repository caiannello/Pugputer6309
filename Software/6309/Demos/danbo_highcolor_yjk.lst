                      (danbo_highcolor_y):00001         
                      (danbo_highcolor_y):00002         ;------------------------------------------------------------------------------
                      (danbo_highcolor_y):00003         ; PROJECT: Pugputer 6309 - vdp experiment
                      (danbo_highcolor_y):00004         ; VERSION: 0.0.2
                      (danbo_highcolor_y):00005         ;    FILE: CONV_HICOLOR.ASM
                      (danbo_highcolor_y):00006         ;  AUTHOR: CRAIG IANNELLO, PUGBUTT.COM
                      (danbo_highcolor_y):00007         ;
                      (danbo_highcolor_y):00008         ; Description:
                      (danbo_highcolor_y):00009         ;
                      (danbo_highcolor_y):00010         ; SHOWS "SAD DANBO"! (ART NOT BY ME, I CANT FIND AUTHOR.) 
                      (danbo_highcolor_y):00011         ;
                      (danbo_highcolor_y):00012         ; EXPERIMENTING WITH THE V9958 HIGHCOLOR MODES.
                      (danbo_highcolor_y):00013         ;
                      (danbo_highcolor_y):00014         ; I WROTE A PYTHON UTILITY, CONV_YJK.PY, WHICH CONVERTS 256X212-SIZED 
                      (danbo_highcolor_y):00015         ; PNG FILES INTO HUFFMAN-CODED YJK BINARIES AS SEEN BELOW.
                      (danbo_highcolor_y):00016         ;
                      (danbo_highcolor_y):00017         ;------------------------------------------------------------------------------
                      (danbo_highcolor_y):00018             INCLUDE DEFINES.D           ; COMMON DEFINITIONS
                      (        DEFINES.D):00001         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00002         ; IO DEVICE BASE ADDRESSES
                      (        DEFINES.D):00003         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00004         
     FFEC             (        DEFINES.D):00005         BANK_BASE   EQU  $FFEC      : FFEC - FFEF: MEMORY BANK REGS 0...3 (BUILT-IN)
     FFE8             (        DEFINES.D):00006         ACIA_BASE   EQU  $FFE8      ; FFE8 - FFEB: SERIAL UART R65C51P2 (BUILT-IN)
     FFE4             (        DEFINES.D):00007         VDP_BASE    EQU  $FFE4      ; FFE4 - FFE7: VIDEO CHIP V9958
     FFE0             (        DEFINES.D):00008         OPL3_BASE   EQU  $FFE0      ; FFE0 - FFE3: MUSIC CHIP YMF262 (OPL3)
     FFB0             (        DEFINES.D):00009         VIA_BASE    EQU  $FFB0      ; FFB0 - FFBF: W65C22 VIA (SD CARD, SPI, KB, GPIO)
                      (        DEFINES.D):00010         
                      (        DEFINES.D):00011         ; V9958 VDP REGISTERS
     FFE4             (        DEFINES.D):00012         VDAT        EQU  VDP_BASE+0 ; PORT 0: VRAM DATA (R/W)
     FFE5             (        DEFINES.D):00013         VREG        EQU  VDP_BASE+1 ; PORT 1: STATUS REG (R), REGISTER/SETUP (W), VRAM ADDR (W)
     FFE6             (        DEFINES.D):00014         VPAL        EQU  VDP_BASE+2 ; PORT 2: PALETTE REGISTERS (W)
     FFE7             (        DEFINES.D):00015         VIND        EQU  VDP_BASE+3 ; PORT 3: REGISTER-INDIRECT ADDRESSING (W)
                      (        DEFINES.D):00016         
                      (        DEFINES.D):00017         ; MEMORY BANK REGISTERS 0..3 (BASE ADDRESS IN DEFINES.D)
                      (        DEFINES.D):00018         ; THESE ARE WRITE-ONLY, SO WE KEEP COPIES OF 1 THROUGH 3 IN 
                      (        DEFINES.D):00019         ; VARS IN MAIN.ASM: SBANK_1...SBANK_3
                      (        DEFINES.D):00020         
     FFEC             (        DEFINES.D):00021         MBANK_0     EQU  BANK_BASE+0
     FFED             (        DEFINES.D):00022         MBANK_1     EQU  BANK_BASE+1
     FFEE             (        DEFINES.D):00023         MBANK_2     EQU  BANK_BASE+2
     FFEF             (        DEFINES.D):00024         MBANK_3     EQU  BANK_BASE+3
                      (        DEFINES.D):00025         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00026         ; COMMON DEFINITIONS
                      (        DEFINES.D):00027         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00028         ; ASCII CODES
     001B             (        DEFINES.D):00029         ESC         EQU  $1B    ; ESCAPE
     000A             (        DEFINES.D):00030         LF          EQU  $0A    ; LINE FEED
     000D             (        DEFINES.D):00031         CR          EQU  $0D    ; CARRIAGE RETURN
     0000             (        DEFINES.D):00032         NUL         EQU  $00    ; NULL
     0020             (        DEFINES.D):00033         SPACE       EQU  $20
     007E             (        DEFINES.D):00034         TILDE       EQU  $7E
                      (        DEFINES.D):00035         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00036         _DATE       STRUCT
0000s                 (        DEFINES.D):00037         YEAR        RMB  2      ; DATE AS INTEGERS
0002s                 (        DEFINES.D):00038         DAYYR       RMB  2
0004s                 (        DEFINES.D):00039         MON         RMB  1
0005s                 (        DEFINES.D):00040         DAYMON      RMB  1
0006s                 (        DEFINES.D):00041         HOUR        RMB  1
0007s                 (        DEFINES.D):00042         MIN         RMB  1
0008s                 (        DEFINES.D):00043         SEC         RMB  1
0009s                 (        DEFINES.D):00044         HUND        RMB  1
000As                 (        DEFINES.D):00045         YEARBCD     RMB  2      ; DATE AS BCD
000Cs                 (        DEFINES.D):00046         DAYYRBCD    RMB  2
000Es                 (        DEFINES.D):00047         MONBCD      RMB  1
000Fs                 (        DEFINES.D):00048         DAYMONBCD   RMB  1
0010s                 (        DEFINES.D):00049         HOURBCD     RMB  1
0011s                 (        DEFINES.D):00050         MINBCD      RMB  1
0012s                 (        DEFINES.D):00051         SECBCD      RMB  1
0013s                 (        DEFINES.D):00052         HUNDBCD     RMB  1
0014s                 (        DEFINES.D):00053                     ENDS
                      (        DEFINES.D):00054         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00055         ; EOF
                      (        DEFINES.D):00056         ;------------------------------------------------------------------------------
                      (danbo_highcolor_y):00019             INCLUDE BIOS_FUNC_TAB.D     ; BIOS FCN JUMP TABLE AND CONSTANTS
                      (  BIOS_FUNC_TAB.D):00001         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00002         ; BIOS BIOS FUNCTION JUMP TABLE ADDRESSES
                      (  BIOS_FUNC_TAB.D):00003         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00004         FUNC_BASE       EQU  $FEA0          ; SEE 6309/BOOT/MAIN.ASM FOR DEFS
                      (  BIOS_FUNC_TAB.D):00005         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00006         BF_V_RESET      EQU  FUNC_BASE+0
     FEA3             (  BIOS_FUNC_TAB.D):00007         BF_UT_GETC      EQU  FUNC_BASE+3
     FEA6             (  BIOS_FUNC_TAB.D):00008         BF_UT_GETS      EQU  FUNC_BASE+6
     FEA9             (  BIOS_FUNC_TAB.D):00009         BF_UT_PUTC      EQU  FUNC_BASE+9    ;
     FEAC             (  BIOS_FUNC_TAB.D):00010         BF_UT_PUTS      EQU  FUNC_BASE+12
     FEAF             (  BIOS_FUNC_TAB.D):00011         BF_UT_WAITTX    EQU  FUNC_BASE+15
     FEB2             (  BIOS_FUNC_TAB.D):00012         BF_UT_CLRSCR    EQU  FUNC_BASE+18
     FEB5             (  BIOS_FUNC_TAB.D):00013         BF_S_HEXA       EQU  FUNC_BASE+21   ; CONVERT REG A TO HEX OCTET AT X, X+=2
     FEB8             (  BIOS_FUNC_TAB.D):00014         BF_S_EOL        EQU  FUNC_BASE+24   ; PUT CR, LF, $00 AT X, X+=3
     FEBB             (  BIOS_FUNC_TAB.D):00015         BF_S_LEN        EQU  FUNC_BASE+27   ; PUT LEN OF STRING AT X INTO REG B
     FEBE             (  BIOS_FUNC_TAB.D):00016         BF_S_CPY        EQU  FUNC_BASE+30   ; COPY STRING AT Y TO MEM AT X. X+=?
     FEC1             (  BIOS_FUNC_TAB.D):00017         BF_RTC_GETTIX   EQU  FUNC_BASE+33   ; GET CURRENT SYSTEM TICKS TO I64 AT X.
     FEC4             (  BIOS_FUNC_TAB.D):00018         BF_S_TOUPPER    EQU  FUNC_BASE+36   ; MAKE A UPPERCASE IF IT IS LOWERCASE
     FEC7             (  BIOS_FUNC_TAB.D):00019         BF_S_INTD       EQU  FUNC_BASE+39   ; CONVERT REG D TO STRING AT X, X+=?
     FECA             (  BIOS_FUNC_TAB.D):00020         BF_RTC_SETTIX   EQU  FUNC_BASE+42   ; SET CURRENT SYSTEM TICKS FROM I64 AT X.
                      (  BIOS_FUNC_TAB.D):00021         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00022         ; EOF
                      (  BIOS_FUNC_TAB.D):00023         ;------------------------------------------------------------------------------
                      (danbo_highcolor_y):00020         ;------------------------------------------------------------------------------
                      (danbo_highcolor_y):00021             ORG     $1000               ; BEGIN CODE & VARS
                      (danbo_highcolor_y):00022         ; -----------------------------------------------------------------------------
                      (danbo_highcolor_y):00023         ; PROGRAM ENTRYPOINT
                      (danbo_highcolor_y):00024         ; -----------------------------------------------------------------------------
1000                  (danbo_highcolor_y):00025         ENTRYPOINT  
1000 7E117C           (danbo_highcolor_y):00026             JMP  VDP_INIT
                      (danbo_highcolor_y):00027         ; -----------------------------------------------------------------------------
1003 205449434B53     (danbo_highcolor_y):00028         MSG_END     FCC  " TICKS"
1009 0A0D0A0D00       (danbo_highcolor_y):00029         MSG_CR      FCB  LF,CR,LF,CR,0
                      (danbo_highcolor_y):00030         ; -----------------------------------------------------------------------------
100E 00870E8008994081 (danbo_highcolor_y):00031         VDP_SEQ     FCB $00,$87,$0E,$80,$08,$99,$40,$81,$0A,$88,$80,$89,$1F,$82,$00,$40
     0A8880891F820040
101E 008E004000900592 (danbo_highcolor_y):00032                     FCB $00,$8E,$00,$40,$00,$90,$05,$92  
                      (danbo_highcolor_y):00033         ; -----------------------------------------------------------------------------        
1026                  (danbo_highcolor_y):00034         VDP_GRAF7   
1026 8E100E           (danbo_highcolor_y):00035             LDX  #VDP_SEQ       ; SET 256 X 212 X YJK+YAE COLOR MODE
1029                  (danbo_highcolor_y):00036         VDP_ILOOP7
1029 A680             (danbo_highcolor_y):00037             LDA  ,X+
102B B7FFE5           (danbo_highcolor_y):00038             STA  VREG
102E 8C1026           (danbo_highcolor_y):00039             CMPX #VDP_GRAF7
1031 25F6             (danbo_highcolor_y):00040             BLO  VDP_ILOOP7
1033 8622             (danbo_highcolor_y):00041             LDA  #$22       ; SET BG/BORDER (R,B,G)
1035 B7FFE6           (danbo_highcolor_y):00042             STA  VPAL
1038 8602             (danbo_highcolor_y):00043             LDA  #$02
103A B7FFE6           (danbo_highcolor_y):00044             STA  VPAL
                      (danbo_highcolor_y):00045         
103D 39               (danbo_highcolor_y):00046             RTS                 
                      (danbo_highcolor_y):00047         ; -----------------------------------------------------------------------------
103E                  (danbo_highcolor_y):00048         SERBUF          RMB 32  ; SERIAL BUFFER FOR DEBUG LOGGING
105E                  (danbo_highcolor_y):00049         TSTART          RMB 8   ; START AND END TIMES FOR DURATION REPORT
1066                  (danbo_highcolor_y):00050         TEND            RMB 8
106E                  (danbo_highcolor_y):00051         QCOUNT          RMB 2   ; DRAWING LOOP ITERATIONS
1070                  (danbo_highcolor_y):00052         YY              RMB 1   ; CURRENT (Y,J,K) VALUES
1071                  (danbo_highcolor_y):00053         JJ              RMB 1
1072                  (danbo_highcolor_y):00054         KK              RMB 1
1073                  (danbo_highcolor_y):00055         KLO             RMB 1   ; PIECEWISE J,K FOR THE VDP
1074                  (danbo_highcolor_y):00056         KHI             RMB 1
1075                  (danbo_highcolor_y):00057         JLO             RMB 1
1076                  (danbo_highcolor_y):00058         JHI             RMB 1
1077                  (danbo_highcolor_y):00059         TCODELEN        RMB 1   ; HUFFMAN CODE LENGTH DURING INITIAL TABLE PARSE
1078                  (danbo_highcolor_y):00060         TNUMROWS        RMB 1   ; NUM TABLE ROWS DURING INITIAL PARSE
1079                  (danbo_highcolor_y):00061         REM             RMB 1   ; HOLDS LATEST UNPROCESSED INPUT BITS
107A                  (danbo_highcolor_y):00062         REMLEN          RMB 1   ; NUM BITS IN ABOVE
107B                  (danbo_highcolor_y):00063         CODETAB         RMB (1+2+1)*64 ; BYTE-ALIGNED CODE TABLE FOR SPEED
117B                  (danbo_highcolor_y):00064         ENDCODETAB              ; (PARSED FROM INITAL SECTION OF INPUT DATA)
117B                  (danbo_highcolor_y):00065         TMP8            RMB 1
                      (danbo_highcolor_y):00066         ; -----------------------------------------------------------------------------
                      (danbo_highcolor_y):00067         ; ENCODED IMAGE FORMAT OUTPUT BY CONV_YJK.PY:
                      (danbo_highcolor_y):00068         ;   PACKED_HUFFMAN_CODE_TABLE       # SEE BELOW
                      (danbo_highcolor_y):00069         ;   Y:06b                           # INITIAL LUMA
                      (danbo_highcolor_y):00070         ;   J:06b                           # INITIAL CHROMA J
                      (danbo_highcolor_y):00071         ;   K:06b                           # INITIAL CHROMA K
                      (danbo_highcolor_y):00072         ;   FOR EACH FOUR PIXELS OF IMAGE:
                      (danbo_highcolor_y):00073         ;     ENCODED DELTA J
                      (danbo_highcolor_y):00074         ;     ENCODED DELTA K
                      (danbo_highcolor_y):00075         ;     ENCODED DELTA Y
                      (danbo_highcolor_y):00076         ;     ENCODED DELTA Y
                      (danbo_highcolor_y):00077         ;     ENCODED DELTA Y
                      (danbo_highcolor_y):00078         ;     ENCODED DELTA Y
                      (danbo_highcolor_y):00079         ; -----------------------------------------------------------------------------
117C                  (danbo_highcolor_y):00080         VDP_INIT:    
117C BD1026           (danbo_highcolor_y):00081             JSR  VDP_GRAF7
117F 8E105E           (danbo_highcolor_y):00082             LDX  #TSTART    ; GET STARTING SYSTEM TIME IN 16THS OF SECS
1182 BDFEC1           (danbo_highcolor_y):00083             JSR  BF_RTC_GETTIX
                      (danbo_highcolor_y):00084         
1185 CE131E           (danbo_highcolor_y):00085             LDU  #HUFFIMG   ; START PARSING INPUT DATA.
1188 ECC1             (danbo_highcolor_y):00086             LDD  ,U++
118A F71078           (danbo_highcolor_y):00087             STB  TNUMROWS   ; FIRST, NOTE NUMBER OF HUFFMAN TABLE ROWS/
118D A6C0             (danbo_highcolor_y):00088             LDA  ,U+
118F B71079           (danbo_highcolor_y):00089             STA  REM        ; QUEUE UP LATEST 8 BITS OF INPUT,
1192 8608             (danbo_highcolor_y):00090             LDA  #8         ; AND THE LENGTH OF UNPROCESSED BITS.
1194 B7107A           (danbo_highcolor_y):00091             STA  REMLEN
                      (danbo_highcolor_y):00092         
1197 8600             (danbo_highcolor_y):00093             LDA  #0         
1199 B71077           (danbo_highcolor_y):00094             STA  TCODELEN   ; FOR BETTER DECODING SPEED,
119C 108E107B         (danbo_highcolor_y):00095             LDY  #CODETAB   ; UNPACK HUFF CODE TABLE TO BYTE-ALIGNED CODETAB
11A0                  (danbo_highcolor_y):00096         TBL_PARSE:    
11A0 11C604           (danbo_highcolor_y):00097             LDF  #4
11A3 BD1290           (danbo_highcolor_y):00098             JSR  GET_BITS   ; READ 4-BIT INCREASE IN CODE LENGTH
11A6 E7A0             (danbo_highcolor_y):00099             STB  ,Y+        ; STORE IT IN CODETAB TABLE AS A U8
11A8 FB1077           (danbo_highcolor_y):00100             ADDB TCODELEN   ; SUM TOTAL CODE LENGTH
11AB F71077           (danbo_highcolor_y):00101             STB  TCODELEN 
11AE 1F9F             (danbo_highcolor_y):00102             TFR  B,F
11B0 BD1290           (danbo_highcolor_y):00103             JSR  GET_BITS   ; READ IN THAT MANY BITS OF HUFFMAN CODE,
11B3 EDA1             (danbo_highcolor_y):00104             STD  ,Y++       ; AND STORE IT IN CODETAB AS A U16
11B5 11C606           (danbo_highcolor_y):00105             LDF  #6
11B8 BD1290           (danbo_highcolor_y):00106             JSR  GET_BITS   ; READ 6-BIT SIGNED DELTA
11BB BD127F           (danbo_highcolor_y):00107             JSR  SEX6       ; SIGN-EXTEND IT TO 8-BITS
11BE E7A0             (danbo_highcolor_y):00108             STB  ,Y+        ; STORE IN CODETAB AS A U16
11C0 7A1078           (danbo_highcolor_y):00109             DEC  TNUMROWS   ; COUNTDOWN TABLE ROWS
11C3 26DB             (danbo_highcolor_y):00110             BNE  TBL_PARSE  ; DO NEXT ROW, IF ANY.
                      (danbo_highcolor_y):00111         
11C5                  (danbo_highcolor_y):00112         INIT_YJK:           ; GET INITIAL VALUES OF Y,J, AND K.
11C5 11C606           (danbo_highcolor_y):00113             LDF  #6         ; (THE ENCODED DATA IS JUST CHANGES IN Y,J,K)
11C8 BD1290           (danbo_highcolor_y):00114             JSR  GET_BITS
11CB BD127F           (danbo_highcolor_y):00115             JSR  SEX6       ; SIGN-EXTEND THE 6-BIT VALS TO 8-BITS
11CE F71070           (danbo_highcolor_y):00116             STB  YY
11D1 11C606           (danbo_highcolor_y):00117             LDF  #6
11D4 BD1290           (danbo_highcolor_y):00118             JSR  GET_BITS
11D7 BD127F           (danbo_highcolor_y):00119             JSR  SEX6  
11DA F71071           (danbo_highcolor_y):00120             STB  JJ
11DD 11C606           (danbo_highcolor_y):00121             LDF  #6
11E0 BD1290           (danbo_highcolor_y):00122             JSR  GET_BITS
11E3 BD127F           (danbo_highcolor_y):00123             JSR  SEX6  
11E6 F71072           (danbo_highcolor_y):00124             STB  KK
                      (danbo_highcolor_y):00125         
11E9                  (danbo_highcolor_y):00126         START_DRAWING:      ; WE ARE NOW AT THE ENCODED DATA,
11E9 CC3500           (danbo_highcolor_y):00127             LDD  #13568     ; AND WE'LL PLOT (64 * 212) PIXEL-QUARTETS.
11EC                  (danbo_highcolor_y):00128         DRAWLOOP:    
11EC FD106E           (danbo_highcolor_y):00129             STD  QCOUNT
                      (danbo_highcolor_y):00130         
11EF 8D4E             (danbo_highcolor_y):00131             BSR  DECODE     ; GET DJ
11F1 FB1071           (danbo_highcolor_y):00132             ADDB JJ         ; J = J + DJ
11F4 F71071           (danbo_highcolor_y):00133             STB  JJ
11F7 1F98             (danbo_highcolor_y):00134             TFR  B,A        ; SPLIT J INTO 2 3-BIT WORDS
11F9 8407             (danbo_highcolor_y):00135             ANDA #$7
11FB B71075           (danbo_highcolor_y):00136             STA  JLO
11FE 54               (danbo_highcolor_y):00137             LSRB
11FF 54               (danbo_highcolor_y):00138             LSRB
1200 54               (danbo_highcolor_y):00139             LSRB
1201 C407             (danbo_highcolor_y):00140             ANDB #$7
1203 F71076           (danbo_highcolor_y):00141             STB  JHI
                      (danbo_highcolor_y):00142         
1206 8D37             (danbo_highcolor_y):00143             BSR  DECODE     ; GET DK
1208 FB1072           (danbo_highcolor_y):00144             ADDB KK         ; K = K + DK
120B F71072           (danbo_highcolor_y):00145             STB  KK
120E 1F98             (danbo_highcolor_y):00146             TFR  B,A        ; SPLIT J INTO 2 3-BIT WORDS
1210 8407             (danbo_highcolor_y):00147             ANDA #$7
1212 B71073           (danbo_highcolor_y):00148             STA  KLO
1215 54               (danbo_highcolor_y):00149             LSRB
1216 54               (danbo_highcolor_y):00150             LSRB
1217 54               (danbo_highcolor_y):00151             LSRB
1218 C407             (danbo_highcolor_y):00152             ANDB #$7
121A F71074           (danbo_highcolor_y):00153             STB  KHI
                      (danbo_highcolor_y):00154         
121D 8E1073           (danbo_highcolor_y):00155             LDX  #KLO       ; FOR EACH OF KLO,KHI,JLO,JHI
1220                  (danbo_highcolor_y):00156         PIXLOOP
1220 8D1D             (danbo_highcolor_y):00157             BSR  DECODE     ; GET DY
1222 FB1070           (danbo_highcolor_y):00158             ADDB YY         ; Y = Y + DY
1225 F71070           (danbo_highcolor_y):00159             STB  YY
1228 58               (danbo_highcolor_y):00160             LSLB
1229 58               (danbo_highcolor_y):00161             LSLB
122A 58               (danbo_highcolor_y):00162             LSLB
122B EA80             (danbo_highcolor_y):00163             ORB  ,X+        ; PIXEL = (Y<<3) | JK_PIECE
122D F7FFE4           (danbo_highcolor_y):00164             STB  VDAT       ; SEND IT TO DISPLAY
1230 8C1077           (danbo_highcolor_y):00165             CMPX #(JHI+1)
1233 25EB             (danbo_highcolor_y):00166             BLO  PIXLOOP    
                      (danbo_highcolor_y):00167         
1235 FC106E           (danbo_highcolor_y):00168             LDD  QCOUNT     ; PIXEL QUARTET COUNTDOWN
1238 104A             (danbo_highcolor_y):00169             DECD
123A 26B0             (danbo_highcolor_y):00170             BNE  DRAWLOOP   ; LOOP UNTIL SCREEN FILLED.
                      (danbo_highcolor_y):00171         
123C 7E12ED           (danbo_highcolor_y):00172             JMP  END_REPORT ; SHOW DECODE DURATION AND END PROGRAM.
                      (danbo_highcolor_y):00173         ; -----------------------------------------------------------------------------
                      (danbo_highcolor_y):00174         ; MATCH THE HUFFMAN CODE AT (U,REM) AND RETURN SIGNED INT (DELTA) IN B.
                      (danbo_highcolor_y):00175         ; ON RETURN, (U,REM) WILL POINT TO THE NEXT INPUT BIT.
                      (danbo_highcolor_y):00176         ; -----------------------------------------------------------------------------
123F                  (danbo_highcolor_y):00177         DECODE:
123F 104F             (danbo_highcolor_y):00178             CLRD            ; CLEAR INPUT SHIFT-REGISTER
1241 108E107B         (danbo_highcolor_y):00179             LDY  #CODETAB   ; POINT Y TO HUFFMAN CODE TABLE
1245                  (danbo_highcolor_y):00180         DEC_LOOP:           ; PER EACH ROW OF CODE TABLE
1245 11A6A4           (danbo_highcolor_y):00181             LDE  ,Y         ; NUM ADDL BITS OCCUPIED BY THIS CODE VS LAST ONE
1248 2720             (danbo_highcolor_y):00182             BEQ  COMPARE    ; IF WE HAVE ENOUGH INPUT BITS, GO TO COMPARISON.
124A                  (danbo_highcolor_y):00183         SHLOOP:
124A 11F6107A         (danbo_highcolor_y):00184             LDF  REMLEN
124E 260E             (danbo_highcolor_y):00185             BNE  GOTREM
1250 11E6C0           (danbo_highcolor_y):00186             LDF  ,U+
1253 11F71079         (danbo_highcolor_y):00187             STF  REM
1257 11C608           (danbo_highcolor_y):00188             LDF  #8
125A 11F7107A         (danbo_highcolor_y):00189             STF  REMLEN
125E                  (danbo_highcolor_y):00190         GOTREM:
125E 781079           (danbo_highcolor_y):00191             LSL  REM
1261 1049             (danbo_highcolor_y):00192             ROLD
1263 7A107A           (danbo_highcolor_y):00193             DEC REMLEN
1266 114A             (danbo_highcolor_y):00194             DECE
1268 26E0             (danbo_highcolor_y):00195             BNE  SHLOOP
126A                  (danbo_highcolor_y):00196         COMPARE:            ; COMPARE INPUT WORD TO HUFFMAN CODE.
126A 10A321           (danbo_highcolor_y):00197             CMPD 1,Y        ; INWORD == CODE?
126D 270A             (danbo_highcolor_y):00198             BEQ  DEC_DONE
126F 3124             (danbo_highcolor_y):00199             LEAY 4,Y        ; NOPE, TRY NEXT CODE OF TABLE.
1271 108C117B         (danbo_highcolor_y):00200             CMPY #ENDCODETAB
1275 2705             (danbo_highcolor_y):00201             BEQ  DEC_FAIL   ; IF RAN OUT OF TABLE, THE DECODE FAILED!
1277 20CC             (danbo_highcolor_y):00202             BRA  DEC_LOOP
1279                  (danbo_highcolor_y):00203         DEC_DONE:
1279 E623             (danbo_highcolor_y):00204             LDB  3,Y        ; MATCH! GET SIGNED INT8) DELTA
127B 39               (danbo_highcolor_y):00205             RTS
127C                  (danbo_highcolor_y):00206         DEC_FAIL:  
127C C600             (danbo_highcolor_y):00207             LDB  #0
127E 39               (danbo_highcolor_y):00208             RTS
                      (danbo_highcolor_y):00209         ; -----------------------------------------------------------------------------
                      (danbo_highcolor_y):00210         ; SIGN-EXTEND TO 8-BITS THE 6-BIT VALUE IN REG B
                      (danbo_highcolor_y):00211         ; -----------------------------------------------------------------------------
127F                  (danbo_highcolor_y):00212         SEX6:
127F F7117B           (danbo_highcolor_y):00213             STB  TMP8
1282 C420             (danbo_highcolor_y):00214             ANDB #$20
1284 2706             (danbo_highcolor_y):00215             BEQ  SEXDONE
1286 F6117B           (danbo_highcolor_y):00216             LDB  TMP8
1289 CAC0             (danbo_highcolor_y):00217             ORB  #$C0
128B 39               (danbo_highcolor_y):00218             RTS
128C                  (danbo_highcolor_y):00219         SEXDONE:
128C F6117B           (danbo_highcolor_y):00220             LDB  TMP8
128F 39               (danbo_highcolor_y):00221             RTS    
                      (danbo_highcolor_y):00222         ;------------------------------------------------------------------------------
                      (danbo_highcolor_y):00223         ; COPIES BITSTRING OF LEN. F FROM (U,REM) TO D, RIGHT-JUSTIFIED.
                      (danbo_highcolor_y):00224         ; U,REM ARE ADVANCED TO NEXT BIT.
                      (danbo_highcolor_y):00225         ;------------------------------------------------------------------------------
1290                  (danbo_highcolor_y):00226         GET_BITS:
1290 104F             (danbo_highcolor_y):00227             CLRD            ; INIT DEST WORD
1292 11B6107A         (danbo_highcolor_y):00228             LDE  REMLEN
1296                  (danbo_highcolor_y):00229         GB_LOOP:
1296 114D             (danbo_highcolor_y):00230             TSTE
1298 260A             (danbo_highcolor_y):00231             BNE  GB_GOTREM
129A 11A6C0           (danbo_highcolor_y):00232             LDE  ,U+
129D 11B71079         (danbo_highcolor_y):00233             STE  REM
12A1 118608           (danbo_highcolor_y):00234             LDE  #8
12A4                  (danbo_highcolor_y):00235         GB_GOTREM:
12A4 781079           (danbo_highcolor_y):00236             LSL  REM
12A7 1049             (danbo_highcolor_y):00237             ROLD
12A9 114A             (danbo_highcolor_y):00238             DECE    
12AB 115A             (danbo_highcolor_y):00239             DECF    
12AD 26E7             (danbo_highcolor_y):00240             BNE  GB_LOOP
12AF 11B7107A         (danbo_highcolor_y):00241             STE  REMLEN
12B3 39               (danbo_highcolor_y):00242             RTS   
                      (danbo_highcolor_y):00243         ;------------------------------------------------------------------------------
                      (danbo_highcolor_y):00244         ; GIVEN I64'S AT X AND U, SUBTRACT U FROM X, LEAVING RESULT IN X.
                      (danbo_highcolor_y):00245         ;------------------------------------------------------------------------------
12B4                  (danbo_highcolor_y):00246         SUB64_XU:
12B4 EC06             (danbo_highcolor_y):00247             LDD  6,X
12B6 A346             (danbo_highcolor_y):00248             SUBD 6,U
12B8 ED06             (danbo_highcolor_y):00249             STD  6,X
12BA EC04             (danbo_highcolor_y):00250             LDD  4,X
12BC 10A244           (danbo_highcolor_y):00251             SBCD 4,U
12BF ED04             (danbo_highcolor_y):00252             STD  4,X
12C1 EC02             (danbo_highcolor_y):00253             LDD  2,X
12C3 10A242           (danbo_highcolor_y):00254             SBCD 2,U
12C6 ED02             (danbo_highcolor_y):00255             STD  2,X
12C8 EC00             (danbo_highcolor_y):00256             LDD  0,X
12CA 10A240           (danbo_highcolor_y):00257             SBCD 0,U
12CD ED00             (danbo_highcolor_y):00258             STD  0,X
12CF 39               (danbo_highcolor_y):00259             RTS
                      (danbo_highcolor_y):00260         ;------------------------------------------------------------------------------
                      (danbo_highcolor_y):00261         ; CONVERTS VAL IN A TO HEX STRING AT Y. IT DOES INCREMENT Y, BUT DOESN'T 
                      (danbo_highcolor_y):00262         ; NULL-TERMINATE THE STRING. (I THINK I GOT THIS FROM L. LEVENTHAL'S BOOK.)
                      (danbo_highcolor_y):00263         ;------------------------------------------------------------------------------
12D0                  (danbo_highcolor_y):00264         S_HEXY:
12D0 1F89             (danbo_highcolor_y):00265             TFR  A,B        ; SAVE ORIGINAL BINARY VALUE
12D2 44               (danbo_highcolor_y):00266             LSRA            ; MOVE HIGH DIGIT TO LOW DIGIT
12D3 44               (danbo_highcolor_y):00267             LSRA
12D4 44               (danbo_highcolor_y):00268             LSRA
12D5 44               (danbo_highcolor_y):00269             LSRA
12D6 8109             (danbo_highcolor_y):00270             CMPA #9
12D8 2302             (danbo_highcolor_y):00271             BLS  AD30       ; BRANCH IF HIGH DIGIT IS DECIMAL
12DA 8B07             (danbo_highcolor_y):00272             ADDA #7         ; ELSE ADD 7 SO AFTER ADDING 'O' THE
                      (danbo_highcolor_y):00273                             ; CHARACTER WILL BE IN ‘'A'..'F'
12DC                  (danbo_highcolor_y):00274         AD30:
12DC 8B30             (danbo_highcolor_y):00275             ADDA #'0        ; ADD ASCII O TO MAKE A CHARACTER
12DE C40F             (danbo_highcolor_y):00276             ANDB #$0F       ; MASK OFF LOW DIGIT
12E0 C109             (danbo_highcolor_y):00277             CMPB #9
12E2 2302             (danbo_highcolor_y):00278             BLS AD3OLD      ; BRANCH IF LOW DIGIT IS DECIMAL
12E4 CB07             (danbo_highcolor_y):00279             ADDB #7         ; ELSE ADD 7 SO AFTER ADDING 'O! THE
                      (danbo_highcolor_y):00280                             ; CHARACTER WILL BE IN '‘A'..'F!
12E6                  (danbo_highcolor_y):00281         AD3OLD:     
12E6 CB30             (danbo_highcolor_y):00282             ADDB #'0        ; ADD ASCII O TO MAKE A CHARACTER
12E8 A7A0             (danbo_highcolor_y):00283             STA ,Y+         ; INSERT HEX BYTES INTO DEST STRING AT X
12EA E7A0             (danbo_highcolor_y):00284             STB ,Y+         ; AND NCREMENT X
12EC 39               (danbo_highcolor_y):00285             RTS
                      (danbo_highcolor_y):00286         ;------------------------------------------------------------------------------
                      (danbo_highcolor_y):00287         ; SHOW HOW LONG IT TOOK TO DECODE/DRAW THE IMAGE AND END THE PROGRAM.
                      (danbo_highcolor_y):00288         ;------------------------------------------------------------------------------
12ED                  (danbo_highcolor_y):00289         END_REPORT
12ED 8E1066           (danbo_highcolor_y):00290             LDX  #TEND          ; GET END TIME. 
12F0 BDFEC1           (danbo_highcolor_y):00291             JSR  BF_RTC_GETTIX  
12F3 CE105E           (danbo_highcolor_y):00292             LDU  #TSTART        ; CALC ELAPSED TICKS,
12F6 BD12B4           (danbo_highcolor_y):00293             JSR  SUB64_XU
12F9 108E103E         (danbo_highcolor_y):00294             LDY  #SERBUF        ; AND PRINT DURATION.
12FD 118608           (danbo_highcolor_y):00295             LDE  #8
1300                  (danbo_highcolor_y):00296         TIXLOOP:
1300 A680             (danbo_highcolor_y):00297             LDA  ,X+
1302 8DCC             (danbo_highcolor_y):00298             BSR  S_HEXY
1304 114A             (danbo_highcolor_y):00299             DECE
1306 26F8             (danbo_highcolor_y):00300             BNE  TIXLOOP
1308 8600             (danbo_highcolor_y):00301             LDA  #NUL
130A A7A0             (danbo_highcolor_y):00302             STA  ,Y+
130C 108E103E         (danbo_highcolor_y):00303             LDY  #SERBUF
1310 BDFEAC           (danbo_highcolor_y):00304             JSR  BF_UT_PUTS
1313 108E1003         (danbo_highcolor_y):00305             LDY  #MSG_END
1317 BDFEAC           (danbo_highcolor_y):00306             JSR  BF_UT_PUTS
131A BDFEAF           (danbo_highcolor_y):00307             JSR  BF_UT_WAITTX
131D 39               (danbo_highcolor_y):00308             RTS             ; END OF PROGRAM
                      (danbo_highcolor_y):00309         ; -----------------------------------------------------------------------------
