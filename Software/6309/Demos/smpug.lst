1096                  (        smpug.asm):00117         DRAWPIXELS          ; SHIFT PIXEL INTO OUTPUT BYTE
1096 F61248           (        smpug.asm):00118             LDB  OUTBYTE
1099                  (        smpug.asm):00119         LOOPPIXELS16
