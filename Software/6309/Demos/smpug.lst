1041 B71249           (        smpug.asm):00068             STA  OUTELEMS
1044 CE1252           (        smpug.asm):00069             LDU  #IMG       ; POINT X TO START OF RLE DATA
                      (        smpug.asm):00070         
1047                  (        smpug.asm):00071         DRAWLOOP    
1047 A6C0             (        smpug.asm):00072             LDA  ,U+        ; GET NEXT BYTE OF RLE DATA
1049 2B35             (        smpug.asm):00073             BMI  U16ELEM    ; IF TOP BIT SET, NEED TO GET ANOTHER BYTE.
                      (        smpug.asm):00074         
104B                  (        smpug.asm):00075         U8ELEM              ; THIS PIXEL RUN IS ENCODED IN ONE BYTE:
104B 1F89             (        smpug.asm):00076             TFR  A,B 
