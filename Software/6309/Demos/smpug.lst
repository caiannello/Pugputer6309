10A5 F7FFE4           (        smpug.asm):00127             STB  VDAT       ; EVERY TWO PIXELS, SEND BYTE THE VDP
10A8 8602             (        smpug.asm):00128             LDA  #2
10AA B71249           (        smpug.asm):00129             STA  OUTELEMS       
10AD 2003             (        smpug.asm):00130             BRA  ELOOP
10AF                  (        smpug.asm):00131         SKIPPLOT
10AF F71248           (        smpug.asm):00132             STB  OUTBYTE
10B2                  (        smpug.asm):00133         ELOOP
