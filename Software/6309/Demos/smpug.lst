1065 260A             (        smpug.asm):00092             BNE  SKIPPLOT8
1067 F7FFE4           (        smpug.asm):00093             STB  VDAT       ; EVERY TWO PIXELS, SEND BYTE THE VDP
106A 8602             (        smpug.asm):00094             LDA  #2
106C B71249           (        smpug.asm):00095             STA  OUTELEMS       
106F 2003             (        smpug.asm):00096             BRA  ELOOP8
1071                  (        smpug.asm):00097         SKIPPLOT8
1071 F71248           (        smpug.asm):00098             STB  OUTBYTE
1074                  (        smpug.asm):00099         ELOOP8
1074 7A1247           (        smpug.asm):00100             DEC  PIXCNT+1   ; CHECK FOR END OF PIXEL RUN
1077 26E2             (        smpug.asm):00101             BNE  LOOPPIXELS8
