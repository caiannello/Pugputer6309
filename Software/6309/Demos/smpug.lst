105B 58               (        smpug.asm):00086             LSLB
105C 58               (        smpug.asm):00087             LSLB
105D 58               (        smpug.asm):00088             LSLB
105E 58               (        smpug.asm):00089             LSLB
105F FA1245           (        smpug.asm):00090             ORB  PIXCOLR
