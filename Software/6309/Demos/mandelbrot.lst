                      (   mandelbrot.asm):00001         ;------------------------------------------------------------------------------
                      (   mandelbrot.asm):00002         ; PROJECT: mandel 
                      (   mandelbrot.asm):00003         ; VERSION: 0.0.1
                      (   mandelbrot.asm):00004         ;    FILE: mandel.asm
                      (   mandelbrot.asm):00005         ;  AUTHOR: CRAIG IANNELLO, PUGBUTT.COM
                      (   mandelbrot.asm):00006         ;
                      (   mandelbrot.asm):00007         ; DESCRIPTION:
                      (   mandelbrot.asm):00008         ;
                      (   mandelbrot.asm):00009         ; DRAWS A MANDELBROT FRACTAL ON THE VIDEO DISPLAY.
                      (   mandelbrot.asm):00010         ;
                      (   mandelbrot.asm):00011         ; REQUIRES AN HD6309 CPU IN NATIVE MODE, A V9958 VDP, AND A COPY 
                      (   mandelbrot.asm):00012         ; OF THE MC6839 FLOATING-POINT ROM (8192 BYTES) STARTING AT ADDRESS $8000.
                      (   mandelbrot.asm):00013         ;
                      (   mandelbrot.asm):00014         ;------------------------------------------------------------------------------
                      (   mandelbrot.asm):00015                                     ; V9958 VDP CONSTANTS 
     FFE4             (   mandelbrot.asm):00016         VDP_BASE    EQU  $FFE4      ; ffe4 - ffe7: Video Chip V9958
                      (   mandelbrot.asm):00017         
     FFE4             (   mandelbrot.asm):00018         VDAT        EQU  VDP_BASE+0 ; PORT 0: VRAM DATA (R/W)
     FFE5             (   mandelbrot.asm):00019         VREG        EQU  VDP_BASE+1 ; PORT 1: STATUS REG (R), REGISTER/SETUP (W), VRAM ADDR (W)
     FFE6             (   mandelbrot.asm):00020         VPAL        EQU  VDP_BASE+2 ; PORT 2: PALETTE REGISTERS (W)
     FFE7             (   mandelbrot.asm):00021         VIND        EQU  VDP_BASE+3 ; PORT 3: REGISTER-INDIRECT ADDRESSING (W)
                      (   mandelbrot.asm):00022         
                      (   mandelbrot.asm):00023                                     ; MC6839 FLOATING-POINT ROM STARTS AT fp_rom
     12F3             (   mandelbrot.asm):00024         FPREG       EQU     FP_ROM+$3D   ; FP CALL ADDRESS WHEN ARGS ARE IN REGISTERS
     12F5             (   mandelbrot.asm):00025         FPSTAK      EQU     FP_ROM+$3F   ; FP CALL ADDRESS WHEN ARGS ARE ON STACK
                      (   mandelbrot.asm):00026         
                      (   mandelbrot.asm):00027         ; FLOATING POINT EXPERIMENT CONSTANTS -----------------------------------------
                      (   mandelbrot.asm):00028         
     00FF             (   mandelbrot.asm):00029         _XSZ        EQU     255     ; IMAGE WIDTH IN PIXELS
     00D3             (   mandelbrot.asm):00030         _YSZ        EQU     211     ; IMAGE HEIGHT IN SCANLINES
     FFFF             (   mandelbrot.asm):00031         _I1         EQU     -1      ; STARTING IMAGINARY PART
     0001             (   mandelbrot.asm):00032         _I2         EQU     1       ; ENDING IMAGINARY PART
     FFFE             (   mandelbrot.asm):00033         _R1         EQU     -2      ; STARTING REAL PART
     0001             (   mandelbrot.asm):00034         _R2         EQU     1       ; ENDING REAL PART
     0020             (   mandelbrot.asm):00035         _MAX_ITER   EQU     32      ; MAX ITERATIONS PER PIXEL TO TRY TO ESCAPE
     0002             (   mandelbrot.asm):00036         _TWO        EQU     2
     0004             (   mandelbrot.asm):00037         _FOUR       EQU     4
     0100             (   mandelbrot.asm):00038         _TWOFIVESIX EQU     256
                      (   mandelbrot.asm):00039         
                      (   mandelbrot.asm):00040         ; MC6839 FLOATING-POINT ROM OPCODES
                      (   mandelbrot.asm):00041         
     0000             (   mandelbrot.asm):00042         FADD        EQU     $00
     0002             (   mandelbrot.asm):00043         FSUB        EQU     $02
     0004             (   mandelbrot.asm):00044         FMUL        EQU     $04
     0006             (   mandelbrot.asm):00045         FDIV        EQU     $06
     0008             (   mandelbrot.asm):00046         FREM        EQU     $08
     00BA             (   mandelbrot.asm):00047         FCMP        EQU     $BA
     00CC             (   mandelbrot.asm):00048         FTCMP       EQU     $CC
     00BE             (   mandelbrot.asm):00049         FPCMP       EQU     $BE
     00D0             (   mandelbrot.asm):00050         FTPCMP      EQU     $D0
     009A             (   mandelbrot.asm):00051         FMOV        EQU     $9A
     0012             (   mandelbrot.asm):00052         FSQRT       EQU     $12
     0014             (   mandelbrot.asm):00053         FINT        EQU     $14
     0016             (   mandelbrot.asm):00054         FFIXS       EQU     $16
     0018             (   mandelbrot.asm):00055         FFIXD       EQU     $18
     0024             (   mandelbrot.asm):00056         FFLTS       EQU     $24
     0026             (   mandelbrot.asm):00057         FFLTD       EQU     $26
     001C             (   mandelbrot.asm):00058         BINDEC      EQU     $1C
     0022             (   mandelbrot.asm):00059         DECBIN      EQU     $22
     001E             (   mandelbrot.asm):00060         FABS        EQU     $1E
     0020             (   mandelbrot.asm):00061         FNEG        EQU     $20
                      (   mandelbrot.asm):00062         
                      (   mandelbrot.asm):00063         ; INITIAL VALUES OF BYTES IN FLOATING-POINT CONTROL BLOCK (FPCB)
                      (   mandelbrot.asm):00064         
     0009             (   mandelbrot.asm):00065         FPCB0       EQU     %00001001   ; CONTROL BYTE: SINGLE PRECISION, ROUND NEAREST, 
                      (   mandelbrot.asm):00066                                         ;   NORMALIZED, AFFINE CLOSURE
     0000             (   mandelbrot.asm):00067         FPCB1       EQU     $00         ; ENABLE BYTE: NO TRAPS ARE ENABLED
     0000             (   mandelbrot.asm):00068         FPCB2       EQU     $00         ; STATUS BYTE: NONE SET BY US
     0000             (   mandelbrot.asm):00069         FPCB3       EQU     $00         ; SECONDARY STATUS: NONE SET BY US 
     0000             (   mandelbrot.asm):00070         FPCB4       EQU     $00         ; TRAP ROUTINE ADDRESS HI
     0000             (   mandelbrot.asm):00071         FPCB5       EQU     $00         ; TRAP ROUTINE ADDRESS LO
                      (   mandelbrot.asm):00072         ; ENTRYPOINT, VARS, AND CODE --------------------------------------------------
                      (   mandelbrot.asm):00073                     ORG  $1000          
                      (   mandelbrot.asm):00074         
1000                  (   mandelbrot.asm):00075         ENTRYPOINT
1000 7E1073           (   mandelbrot.asm):00076                  JMP  FLOAT_EXPERIMENT
                      (   mandelbrot.asm):00077         
1003                  (   mandelbrot.asm):00078         FPCB        RMB     6   ; FLOATING POINT CONTROL BLOCK
1009                  (   mandelbrot.asm):00079         PX          RMW     1   ; PIXEL X LOOP VAR
100B                  (   mandelbrot.asm):00080         PY          RMW     1   ; PIXEL Y LOOP VAR
100D                  (   mandelbrot.asm):00081         PN          RMB     2   ; FUNC ITERATION LOOP VAR
100F                  (   mandelbrot.asm):00082         XSZ         RMB     4   ; IMAGE WIDTH IN PIXELS
1013                  (   mandelbrot.asm):00083         YSZ         RMB     4   ; IMAGE HEIGHT IN PIXELS
1017                  (   mandelbrot.asm):00084         I1          RMB     4   ; IMAGINARY START VAL
101B                  (   mandelbrot.asm):00085         I2          RMB     4   ; IMAGINARY END VAL AND LATER WORKING VAL
101F                  (   mandelbrot.asm):00086         R1          RMB     4   ; REAL START VAL
1023                  (   mandelbrot.asm):00087         R2          RMB     4   ; REAL END VAL AND LATER WORKING VAL
1027                  (   mandelbrot.asm):00088         S1          RMB     4   ; REAL VAL STEP PER HORIZONTAL PIXEL
102B                  (   mandelbrot.asm):00089         S2          RMB     4   ; IMAG VAL STEP VER VERTICAL PIXEL
102F                  (   mandelbrot.asm):00090         Z1          RMB     4   ; ITERATOR WORKING VAL
1033                  (   mandelbrot.asm):00091         Z2          RMB     4   ; ITERATOR WORKING VAL
1037                  (   mandelbrot.asm):00092         AA          RMB     4   ; ITERATOR WORKING VAL
103B                  (   mandelbrot.asm):00093         BB          RMB     4   ; ITERATOR WORKING VAL
103F                  (   mandelbrot.asm):00094         FTWO        RMB     4   ; 2.0
1043                  (   mandelbrot.asm):00095         FFOUR       RMB     4   ; 4.0
1047                  (   mandelbrot.asm):00096         FSUM        RMB     4   ; FOR DOING AA+BB
104B                  (   mandelbrot.asm):00097         F256        RMB     4   ; 256.0
104F                  (   mandelbrot.asm):00098         FPZ1        RMB     2
1051                  (   mandelbrot.asm):00099         FPZ2        RMB     2
1053                  (   mandelbrot.asm):00100         FPA         RMB     2
1055                  (   mandelbrot.asm):00101         FPB         RMB     2
1057                  (   mandelbrot.asm):00102         FPSUM       RMB     2
1059                  (   mandelbrot.asm):00103         FPI2        RMB     2
105B                  (   mandelbrot.asm):00104         FPR2        RMB     2
105D                  (   mandelbrot.asm):00105         SHVAL       RMW     1   ; INT16 TEMP VAL
                      (   mandelbrot.asm):00106         
     0014             (   mandelbrot.asm):00107         VDP_GRAF7_SZ EQU  20        ; NUMBER OF BYTES OF SEQ BELOW
105F 009911870E804081 (   mandelbrot.asm):00108         VDP_G7_SEQ  FCB $00,$99,$11,$87,$0E,$80,$40,$81,$0A,$88,$80,$89,$1F,$82,$00,$40
     0A8880891F820040
106F 008E0040         (   mandelbrot.asm):00109                     FCB $00,$8E,$00,$40  ; SET 256 X 212 X 256 COLOR MODE
                      (   mandelbrot.asm):00110         
                      (   mandelbrot.asm):00111         ; -----------------------------------------------------------------------------
                      (   mandelbrot.asm):00112         ; DRAW A FULLSCREEN MANDELBROT IN THE V9958'S 256 COLOR GRAPHICS MODE 
                      (   mandelbrot.asm):00113         ;
                      (   mandelbrot.asm):00114         ; FLOATING POINT IS USED IN THE INNER X-, AND Y-LOOPS FOR CALCULATING INITIAL
                      (   mandelbrot.asm):00115         ; VALUES. THE FLOAT LIBRARY IS A DUMP OF MOTOROLA'S MC6829 FLOATING POINT 
                      (   mandelbrot.asm):00116         ; ROM. THIS 8192-BYTE LIBRARY IS VERY PRECISE, BUT ALSO VERY SLOW. 
                      (   mandelbrot.asm):00117         ;
                      (   mandelbrot.asm):00118         ; FOR THE INNERMOST N-LOOP, 8.8 FIXED-POINT MATH IS USED INSTEAD, FOR SPEED.
                      (   mandelbrot.asm):00119         ; THIS PROVIDES A HUGE SPEEDUP AT THE EXPENSE OF PRECISION.
                      (   mandelbrot.asm):00120         ;
                      (   mandelbrot.asm):00121         ; ZOOMING IN TO THE FRACTAL IS NOT GOING TO LOOK GOOD WHILE USING THE 
                      (   mandelbrot.asm):00122         ; FIXED-POINT, SO THE MATH SHOULD BE SWITCHED BACK TO FLOATING POINT IF 
                      (   mandelbrot.asm):00123         ; ZOOMING IS NEEDED.
                      (   mandelbrot.asm):00124         ; -----------------------------------------------------------------------------
                      (   mandelbrot.asm):00125         
1073                  (   mandelbrot.asm):00126         FLOAT_EXPERIMENT
1073 8609             (   mandelbrot.asm):00127                     LDA  #FPCB0     ; INIT FLOATING-POINT CONTROL BLOCK
1075 B71003           (   mandelbrot.asm):00128                     STA  (FPCB+0)   ; (FLOATING POINT LIBRARY CONFIG., SPECIFYING
1078 8600             (   mandelbrot.asm):00129                     LDA  #FPCB1     ; SINGLE-PRECISION AND NO TRAPS)
107A B71004           (   mandelbrot.asm):00130                     STA  (FPCB+1)
107D 8600             (   mandelbrot.asm):00131                     LDA  #FPCB2
107F B71005           (   mandelbrot.asm):00132                     STA  (FPCB+2)
1082 8600             (   mandelbrot.asm):00133                     LDA  #FPCB3
1084 B71006           (   mandelbrot.asm):00134                     STA  (FPCB+3)
1087 8600             (   mandelbrot.asm):00135                     LDA  #FPCB4
1089 B71007           (   mandelbrot.asm):00136                     STA  (FPCB+4)
108C 8600             (   mandelbrot.asm):00137                     LDA  #FPCB5
108E B71008           (   mandelbrot.asm):00138                     STA  (FPCB+5)
                      (   mandelbrot.asm):00139         
1091 8E00FF           (   mandelbrot.asm):00140                     LDX  #_XSZ      ; INIT XSZ (FLOAT) FROM INTEGER VALUE
1094 BF105D           (   mandelbrot.asm):00141                     STX  SHVAL      ; 16-BIT TEMP VAL
1097 8E100F           (   mandelbrot.asm):00142                     LDX  #XSZ       ; PTR TO ARG1 (RESULT)
109A 108E105D         (   mandelbrot.asm):00143                     LDY  #SHVAL     ; PTR TO ARG2 (ARG)
109E CC1003           (   mandelbrot.asm):00144                     LDD  #FPCB      ; PTR TO FP CONTROL BLOCK
10A1 17024F           (   mandelbrot.asm):00145                     LBSR FPREG      ; FP CALL - ARGS IN REGISTERS
10A4 24               (   mandelbrot.asm):00146                     FCB  FFLTS      ; OPCODE: CONVERT INT16 TO FLOAT
10A5 8E00D3           (   mandelbrot.asm):00147                     LDX  #_YSZ      ; INIT YSZ
10A8 BF105D           (   mandelbrot.asm):00148                     STX  SHVAL
10AB 8E1013           (   mandelbrot.asm):00149                     LDX  #YSZ
10AE 108E105D         (   mandelbrot.asm):00150                     LDY  #SHVAL
10B2 CC1003           (   mandelbrot.asm):00151                     LDD  #FPCB
10B5 17023B           (   mandelbrot.asm):00152                     LBSR FPREG
10B8 24               (   mandelbrot.asm):00153                     FCB  FFLTS
10B9 8EFFFF           (   mandelbrot.asm):00154                     LDX  #_I1       ; INIT I1
10BC BF105D           (   mandelbrot.asm):00155                     STX  SHVAL
10BF 8E1017           (   mandelbrot.asm):00156                     LDX  #I1
10C2 108E105D         (   mandelbrot.asm):00157                     LDY  #SHVAL
10C6 CC1003           (   mandelbrot.asm):00158                     LDD  #FPCB
10C9 170227           (   mandelbrot.asm):00159                     LBSR FPREG
10CC 24               (   mandelbrot.asm):00160                     FCB  FFLTS
10CD 8E0001           (   mandelbrot.asm):00161                     LDX  #_I2       ; INIT I2
10D0 BF105D           (   mandelbrot.asm):00162                     STX  SHVAL
10D3 8E101B           (   mandelbrot.asm):00163                     LDX  #I2
