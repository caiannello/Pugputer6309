                      (lily_highcolor_yj):00001         
                      (lily_highcolor_yj):00002         ;------------------------------------------------------------------------------
                      (lily_highcolor_yj):00003         ; PROJECT: Pugputer 6309 - vdp experiment
                      (lily_highcolor_yj):00004         ; VERSION: 0.0.2
                      (lily_highcolor_yj):00005         ;    FILE: CONV_HICOLOR.ASM
                      (lily_highcolor_yj):00006         ;  AUTHOR: CRAIG IANNELLO, PUGBUTT.COM
                      (lily_highcolor_yj):00007         ;
                      (lily_highcolor_yj):00008         ; Description:
                      (lily_highcolor_yj):00009         ;
                      (lily_highcolor_yj):00010         ; EXPERIMENTING WITH THE V9958 HIGHCOLOR MODES.
                      (lily_highcolor_yj):00011         ;
                      (lily_highcolor_yj):00012         ; I WROTE A PYTHON UTILITY, CONV_YJK.PY, WHICH CONVERTS 256X212-SIZED 
                      (lily_highcolor_yj):00013         ; PNG FILES INTO HUFFMAN-CODED YJK BINARIES AS SEEN BELOW.
                      (lily_highcolor_yj):00014         ;
                      (lily_highcolor_yj):00015         ; ENCODED IMAGE FORMAT OUTPUT BY CONV_YJK.PY:
                      (lily_highcolor_yj):00016         ;   PACKED_HUFFMAN_CODE_TABLE       # SEE BELOW
                      (lily_highcolor_yj):00017         ;   Y:06b                           # INITIAL LUMA
                      (lily_highcolor_yj):00018         ;   J:06b                           # INITIAL CHROMA J
                      (lily_highcolor_yj):00019         ;   K:06b                           # INITIAL CHROMA K
                      (lily_highcolor_yj):00020         ;   FOR EACH FOUR PIXELS OF IMAGE:
                      (lily_highcolor_yj):00021         ;     ENCODED DELTA J
                      (lily_highcolor_yj):00022         ;     ENCODED DELTA K
                      (lily_highcolor_yj):00023         ;     ENCODED DELTA Y
                      (lily_highcolor_yj):00024         ;     ENCODED DELTA Y
                      (lily_highcolor_yj):00025         ;     ENCODED DELTA Y
                      (lily_highcolor_yj):00026         ;     ENCODED DELTA Y
                      (lily_highcolor_yj):00027         ;
                      (lily_highcolor_yj):00028         ; HUFFMAN TABLE FORMAT:
                      (lily_highcolor_yj):00029         ;   WORD16  N (NUM ROWS IN THIS TABLE)
                      (lily_highcolor_yj):00030         ;       ROW 0:
                      (lily_highcolor_yj):00031         ;           BITS[4]     L (LENGTH IN BITS OF FOLLOWING CODE)
                      (lily_highcolor_yj):00032         ;           BITS[L]     C (HUFFMAN CODE)
                      (lily_highcolor_yj):00033         ;           BITS[6]     S (SIGNED 6-BIT INTEGER REPRESENTED BY CODE)
                      (lily_highcolor_yj):00034         ;       ROW 1:
                      (lily_highcolor_yj):00035         ;           BITS[4]     DL  (LENGTH DIFFERENCE FROM PREVIOUS CODE LENGTH)
                      (lily_highcolor_yj):00036         ;           BITS[L+DL]  C   (HUFFMAN CODE)
                      (lily_highcolor_yj):00037         ;           BITS[6]     S   (SIGNED 6-BIT INTEGER REPRESENTED BY CODE)
                      (lily_highcolor_yj):00038         ;       ...
                      (lily_highcolor_yj):00039         ;       ROW (N-1):
                      (lily_highcolor_yj):00040         ;           BITS[4]     DL  (LENGTH DIFFERENCE FROM PREVIOUS CODE LENGTH)
                      (lily_highcolor_yj):00041         ;           BITS[L+DL]  C   (HUFFMAN CODE)
                      (lily_highcolor_yj):00042         ;           BITS[6]     S   (SIGNED 6-BIT INTEGER REPRESENTED BY CODE)
                      (lily_highcolor_yj):00043         ;
                      (lily_highcolor_yj):00044         ; ON STARTUP, THE TABLE IS PARSED INTO A BYTE-ALIGNED STRUCTURE, AT ADDRESS
                      (lily_highcolor_yj):00045         ; #CODETAB, FOR FASTER DECODING. IN THEORY, THERE SHOULD BE NO MORE THAN 64 
                      (lily_highcolor_yj):00046         ; CODES. IN THE FUTURE, IT MIGHT BE HELPFUL TO DEDICATE SOME CODES FOR USE 
                      (lily_highcolor_yj):00047         ; AS ESCAPE-SYMBOLS TO DO SOME RUN-LENGTH ENCODING OR SIMILAR.
                      (lily_highcolor_yj):00048         ; -----------------------------------------------------------------------------
                      (lily_highcolor_yj):00049             INCLUDE DEFINES.D           ; COMMON DEFINITIONS
                      (        DEFINES.D):00001         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00002         ; IO DEVICE BASE ADDRESSES
                      (        DEFINES.D):00003         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00004         
     FFEC             (        DEFINES.D):00005         BANK_BASE   EQU  $FFEC      : FFEC - FFEF: MEMORY BANK REGS 0...3 (BUILT-IN)
     FFE8             (        DEFINES.D):00006         ACIA_BASE   EQU  $FFE8      ; FFE8 - FFEB: SERIAL UART R65C51P2 (BUILT-IN)
     FFE4             (        DEFINES.D):00007         VDP_BASE    EQU  $FFE4      ; FFE4 - FFE7: VIDEO CHIP V9958
     FFE0             (        DEFINES.D):00008         OPL3_BASE   EQU  $FFE0      ; FFE0 - FFE3: MUSIC CHIP YMF262 (OPL3)
     FFB0             (        DEFINES.D):00009         VIA_BASE    EQU  $FFB0      ; FFB0 - FFBF: W65C22 VIA (SD CARD, SPI, KB, GPIO)
                      (        DEFINES.D):00010         
                      (        DEFINES.D):00011         ; V9958 VDP REGISTERS
     FFE4             (        DEFINES.D):00012         VDAT        EQU  VDP_BASE+0 ; PORT 0: VRAM DATA (R/W)
     FFE5             (        DEFINES.D):00013         VREG        EQU  VDP_BASE+1 ; PORT 1: STATUS REG (R), REGISTER/SETUP (W), VRAM ADDR (W)
     FFE6             (        DEFINES.D):00014         VPAL        EQU  VDP_BASE+2 ; PORT 2: PALETTE REGISTERS (W)
     FFE7             (        DEFINES.D):00015         VIND        EQU  VDP_BASE+3 ; PORT 3: REGISTER-INDIRECT ADDRESSING (W)
                      (        DEFINES.D):00016         
                      (        DEFINES.D):00017         ; MEMORY BANK REGISTERS 0..3 (BASE ADDRESS IN DEFINES.D)
                      (        DEFINES.D):00018         ; THESE ARE WRITE-ONLY, SO WE KEEP COPIES OF 1 THROUGH 3 IN 
                      (        DEFINES.D):00019         ; VARS IN MAIN.ASM: SBANK_1...SBANK_3
                      (        DEFINES.D):00020         
     FFEC             (        DEFINES.D):00021         MBANK_0     EQU  BANK_BASE+0
     FFED             (        DEFINES.D):00022         MBANK_1     EQU  BANK_BASE+1
     FFEE             (        DEFINES.D):00023         MBANK_2     EQU  BANK_BASE+2
     FFEF             (        DEFINES.D):00024         MBANK_3     EQU  BANK_BASE+3
                      (        DEFINES.D):00025         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00026         ; COMMON DEFINITIONS
                      (        DEFINES.D):00027         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00028         ; ASCII CODES
     001B             (        DEFINES.D):00029         ESC         EQU  $1B    ; ESCAPE
     000A             (        DEFINES.D):00030         LF          EQU  $0A    ; LINE FEED
     000D             (        DEFINES.D):00031         CR          EQU  $0D    ; CARRIAGE RETURN
     0000             (        DEFINES.D):00032         NUL         EQU  $00    ; NULL
     0020             (        DEFINES.D):00033         SPACE       EQU  $20
     007E             (        DEFINES.D):00034         TILDE       EQU  $7E
                      (        DEFINES.D):00035         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00036         _DATE       STRUCT
0000s                 (        DEFINES.D):00037         YEAR        RMB  2      ; DATE AS INTEGERS
0002s                 (        DEFINES.D):00038         DAYYR       RMB  2
0004s                 (        DEFINES.D):00039         MON         RMB  1
0005s                 (        DEFINES.D):00040         DAYMON      RMB  1
0006s                 (        DEFINES.D):00041         HOUR        RMB  1
0007s                 (        DEFINES.D):00042         MIN         RMB  1
0008s                 (        DEFINES.D):00043         SEC         RMB  1
0009s                 (        DEFINES.D):00044         HUND        RMB  1
000As                 (        DEFINES.D):00045         YEARBCD     RMB  2      ; DATE AS BCD
000Cs                 (        DEFINES.D):00046         DAYYRBCD    RMB  2
000Es                 (        DEFINES.D):00047         MONBCD      RMB  1
000Fs                 (        DEFINES.D):00048         DAYMONBCD   RMB  1
0010s                 (        DEFINES.D):00049         HOURBCD     RMB  1
0011s                 (        DEFINES.D):00050         MINBCD      RMB  1
0012s                 (        DEFINES.D):00051         SECBCD      RMB  1
0013s                 (        DEFINES.D):00052         HUNDBCD     RMB  1
0014s                 (        DEFINES.D):00053                     ENDS
                      (        DEFINES.D):00054         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00055         ; EOF
                      (        DEFINES.D):00056         ;------------------------------------------------------------------------------
                      (lily_highcolor_yj):00050             INCLUDE BIOS_FUNC_TAB.D     ; BIOS FCN JUMP TABLE AND CONSTANTS
                      (  BIOS_FUNC_TAB.D):00001         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00002         ; BIOS BIOS FUNCTION JUMP TABLE ADDRESSES
                      (  BIOS_FUNC_TAB.D):00003         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00004         FUNC_BASE       EQU  $FEA0          ; SEE 6309/BOOT/MAIN.ASM FOR DEFS
                      (  BIOS_FUNC_TAB.D):00005         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00006         BF_V_RESET      EQU  FUNC_BASE+0
     FEA3             (  BIOS_FUNC_TAB.D):00007         BF_UT_GETC      EQU  FUNC_BASE+3
     FEA6             (  BIOS_FUNC_TAB.D):00008         BF_UT_GETS      EQU  FUNC_BASE+6
     FEA9             (  BIOS_FUNC_TAB.D):00009         BF_UT_PUTC      EQU  FUNC_BASE+9    ;
     FEAC             (  BIOS_FUNC_TAB.D):00010         BF_UT_PUTS      EQU  FUNC_BASE+12
     FEAF             (  BIOS_FUNC_TAB.D):00011         BF_UT_WAITTX    EQU  FUNC_BASE+15
     FEB2             (  BIOS_FUNC_TAB.D):00012         BF_UT_CLRSCR    EQU  FUNC_BASE+18
     FEB5             (  BIOS_FUNC_TAB.D):00013         BF_S_HEXA       EQU  FUNC_BASE+21   ; CONVERT REG A TO HEX OCTET AT X, X+=2
     FEB8             (  BIOS_FUNC_TAB.D):00014         BF_S_EOL        EQU  FUNC_BASE+24   ; PUT CR, LF, $00 AT X, X+=3
     FEBB             (  BIOS_FUNC_TAB.D):00015         BF_S_LEN        EQU  FUNC_BASE+27   ; PUT LEN OF STRING AT X INTO REG B
     FEBE             (  BIOS_FUNC_TAB.D):00016         BF_S_CPY        EQU  FUNC_BASE+30   ; COPY STRING AT Y TO MEM AT X. X+=?
     FEC1             (  BIOS_FUNC_TAB.D):00017         BF_RTC_GETTIX   EQU  FUNC_BASE+33   ; GET CURRENT SYSTEM TICKS TO I64 AT X.
     FEC4             (  BIOS_FUNC_TAB.D):00018         BF_S_TOUPPER    EQU  FUNC_BASE+36   ; MAKE A UPPERCASE IF IT IS LOWERCASE
     FEC7             (  BIOS_FUNC_TAB.D):00019         BF_S_INTD       EQU  FUNC_BASE+39   ; CONVERT REG D TO STRING AT X, X+=?
     FECA             (  BIOS_FUNC_TAB.D):00020         BF_RTC_SETTIX   EQU  FUNC_BASE+42   ; SET CURRENT SYSTEM TICKS FROM I64 AT X.
                      (  BIOS_FUNC_TAB.D):00021         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00022         ; EOF
                      (  BIOS_FUNC_TAB.D):00023         ;------------------------------------------------------------------------------
                      (lily_highcolor_yj):00051         ;------------------------------------------------------------------------------
                      (lily_highcolor_yj):00052             ORG     $1000               ; BEGIN CODE & VARS
                      (lily_highcolor_yj):00053         ; -----------------------------------------------------------------------------
                      (lily_highcolor_yj):00054         ; PROGRAM ENTRYPOINT
                      (lily_highcolor_yj):00055         ; -----------------------------------------------------------------------------
1000                  (lily_highcolor_yj):00056         ENTRYPOINT  
1000 7E1141           (lily_highcolor_yj):00057             JMP  VDP_INIT
                      (lily_highcolor_yj):00058         ; -----------------------------------------------------------------------------
                      (lily_highcolor_yj):00059         ; VARS
                      (lily_highcolor_yj):00060         ; -----------------------------------------------------------------------------
1003                  (lily_highcolor_yj):00061         CODETAB         RMB (1+2+1)*64 ; BYTE-ALIGNED CODE TABLE FOR SPEED
1103                  (lily_highcolor_yj):00062         ENDCODETAB              ; (CAN WE MAKE THIS FASTER USING DIRECT-PAGE?)
                      (lily_highcolor_yj):00063         
1103                  (lily_highcolor_yj):00064         REM             RMB 1   ; HOLDS LATEST UNPROCESSED INPUT BITS
1104                  (lily_highcolor_yj):00065         REMLEN          RMB 1   ; NUM BITS IN ABOVE
1105                  (lily_highcolor_yj):00066         QCOUNT          RMB 2   ; MAIN DRAWLOOP ITERATION
                      (lily_highcolor_yj):00067         
1107                  (lily_highcolor_yj):00068         YY              RMB 1   ; CURRENT (Y,J,K) VALUES
1108                  (lily_highcolor_yj):00069         JJ              RMB 1
1109                  (lily_highcolor_yj):00070         KK              RMB 1
                      (lily_highcolor_yj):00071         
110A                  (lily_highcolor_yj):00072         KLO             RMB 1   ; PIECEWISE J,K FOR THE VDP
110B                  (lily_highcolor_yj):00073         KHI             RMB 1
110C                  (lily_highcolor_yj):00074         JLO             RMB 1
110D                  (lily_highcolor_yj):00075         JHI             RMB 1
                      (lily_highcolor_yj):00076         
110E                  (lily_highcolor_yj):00077         TCODELEN        RMB 1   ; HUFFMAN CODE LENGTH DURING INITIAL TABLE PARSE
110F                  (lily_highcolor_yj):00078         TNUMROWS        RMB 1   ; NUM TABLE ROWS DURING INITIAL PARSE
1110                  (lily_highcolor_yj):00079         TMP8            RMB 1
                      (lily_highcolor_yj):00080         
1111                  (lily_highcolor_yj):00081         TSTART          RMB 8   ; START AND END TIMES FOR DURATION REPORT
1119                  (lily_highcolor_yj):00082         TEND            RMB 8
1121                  (lily_highcolor_yj):00083         SERBUF          RMB 8   ; SERIAL OUTPUT BUFFER FOR LOGGING
                      (lily_highcolor_yj):00084         ; -----------------------------------------------------------------------------
                      (lily_highcolor_yj):00085         ; CONSTS
                      (lily_highcolor_yj):00086         ; -----------------------------------------------------------------------------
1129 00870E8008994081 (lily_highcolor_yj):00087         VDP_SEQ     FCB $00,$87,$0E,$80,$08,$99,$40,$81,$0A,$88,$80,$89,$1F,$82,$00,$40
     0A8880891F820040
1139 008E0040E5920090 (lily_highcolor_yj):00088                     FCB $00,$8E,$00,$40,$E5,$92,$00,$90
                      (lily_highcolor_yj):00089         ; -----------------------------------------------------------------------------
1141                  (lily_highcolor_yj):00090         VDP_INIT:    
1141 8E1129           (lily_highcolor_yj):00091             LDX  #VDP_SEQ   ; SET 256 X 212 X YJK COLOR MODE
1144                  (lily_highcolor_yj):00092         VDP_ILOOP
1144 A680             (lily_highcolor_yj):00093             LDA  ,X+
1146 B7FFE5           (lily_highcolor_yj):00094             STA  VREG
1149 8C1141           (lily_highcolor_yj):00095             CMPX #VDP_INIT
114C 25F6             (lily_highcolor_yj):00096             BLO  VDP_ILOOP
114E 8612             (lily_highcolor_yj):00097             LDA  #$12       ; SET BG/BORDER (R,B,G) TODO: INCLUDE BG COLOR IN IMG DATA
1150 B7FFE6           (lily_highcolor_yj):00098             STA  VPAL
1153 8600             (lily_highcolor_yj):00099             LDA  #$00
1155 B7FFE6           (lily_highcolor_yj):00100             STA  VPAL    
1158 8E1111           (lily_highcolor_yj):00101             LDX  #TSTART    ; NOTE START TIME IN TICKS (16THS OF SECS)
115B BDFEC1           (lily_highcolor_yj):00102             JSR  BF_RTC_GETTIX
                      (lily_highcolor_yj):00103         
115E CE12F2           (lily_highcolor_yj):00104             LDU  #HUFFIMG   ; START PARSING INPUT DATA AT #HUFFIMG.
1161 ECC1             (lily_highcolor_yj):00105             LDD  ,U++       ; TODO: MAKE THIS FIELD A BYTE, AND INCLUDE IMG (X,Y,W,H)
1163 F7110F           (lily_highcolor_yj):00106             STB  TNUMROWS   ; FIRST, NOTE NUMBER OF HUFFMAN TABLE ROWS.
1166 A6C0             (lily_highcolor_yj):00107             LDA  ,U+
1168 B71103           (lily_highcolor_yj):00108             STA  REM        ; QUEUE UP THE NEXT 8 BITS OF INPUT,
116B 8608             (lily_highcolor_yj):00109             LDA  #8         ; AND NOTE LENGTH OF UNPROCESSED BITS.
116D B71104           (lily_highcolor_yj):00110             STA  REMLEN     ; (WE USE REM,REMLEN THROUGHOUT THE PROGRAM TO AID
                      (lily_highcolor_yj):00111                             ; BITWISE PROCESSING OF INPUT)
1170 8600             (lily_highcolor_yj):00112             LDA  #0         
1172 B7110E           (lily_highcolor_yj):00113             STA  TCODELEN   ; FOR BETTER DECODING SPEED, UNPACK THE HUFFMAN
1175 108E1003         (lily_highcolor_yj):00114             LDY  #CODETAB   ; TABLE TO BYTE-ALIGNED VALUES AT #CODETAB.
1179                  (lily_highcolor_yj):00115         TBL_PARSE:
1179 118604           (lily_highcolor_yj):00116             LDE  #4
117C BD1261           (lily_highcolor_yj):00117             JSR  GET_BITS   ; READ 4-BIT INCREASE IN CODE LENGTH
117F E7A0             (lily_highcolor_yj):00118             STB  ,Y+        ; STORE IT IN CODETAB TABLE AS A UINT8
1181 FB110E           (lily_highcolor_yj):00119             ADDB TCODELEN   ; SUM TOTAL CODE LENGTH
1184 F7110E           (lily_highcolor_yj):00120             STB  TCODELEN
1187 1F9E             (lily_highcolor_yj):00121             TFR  B,E
1189 BD1261           (lily_highcolor_yj):00122             JSR  GET_BITS   ; READ IN THAT MANY BITS OF HUFFMAN CODE,
118C EDA1             (lily_highcolor_yj):00123             STD  ,Y++       ; AND STORE IT IN CODETAB AS A UINT16
118E 118606           (lily_highcolor_yj):00124             LDE  #6
1191 BD1261           (lily_highcolor_yj):00125             JSR  GET_BITS   ; READ 6-BIT SIGNED DELTA
1194 BD1250           (lily_highcolor_yj):00126             JSR  SEX6       ; SIGN-EXTEND IT TO 8-BITS,
1197 E7A0             (lily_highcolor_yj):00127             STB  ,Y+        ; AND STORE IN CODETAB AS A UINT8
1199 7A110F           (lily_highcolor_yj):00128             DEC  TNUMROWS   ; COUNTDOWN TABLE ROWS
119C 26DB             (lily_highcolor_yj):00129             BNE  TBL_PARSE  ; DO NEXT ROW, IF ANY.
                      (lily_highcolor_yj):00130         
119E                  (lily_highcolor_yj):00131         INIT_YJK:           ; GET INITIAL VALUES OF Y,J, AND K.
119E 118606           (lily_highcolor_yj):00132             LDE  #6         ; (THE ENCODED DATA IS JUST CHANGES IN Y,J,K)
11A1 BD1261           (lily_highcolor_yj):00133             JSR  GET_BITS
11A4 BD1250           (lily_highcolor_yj):00134             JSR  SEX6       ; SIGN-EXTEND THE 6-BIT VALS TO 8-BITS
11A7 F71107           (lily_highcolor_yj):00135             STB  YY
11AA 118606           (lily_highcolor_yj):00136             LDE  #6
11AD BD1261           (lily_highcolor_yj):00137             JSR  GET_BITS
11B0 BD1250           (lily_highcolor_yj):00138             JSR  SEX6  
11B3 F71108           (lily_highcolor_yj):00139             STB  JJ
11B6 118606           (lily_highcolor_yj):00140             LDE  #6
11B9 BD1261           (lily_highcolor_yj):00141             JSR  GET_BITS
11BC BD1250           (lily_highcolor_yj):00142             JSR  SEX6  
11BF F71109           (lily_highcolor_yj):00143             STB  KK
                      (lily_highcolor_yj):00144         
11C2                  (lily_highcolor_yj):00145         START_DRAWING:      ; WE ARE NOW AT THE ENCODED DATA.
11C2 CC3500           (lily_highcolor_yj):00146             LDD  #13568     ; WE'LL PLOT (64 * 212) PIXEL-QUARTETS.
11C5                  (lily_highcolor_yj):00147         DRAWLOOP:    
11C5 FD1105           (lily_highcolor_yj):00148             STD  QCOUNT
11C8 8D4E             (lily_highcolor_yj):00149             BSR  DECODE     ; GET DJ
11CA FB1108           (lily_highcolor_yj):00150             ADDB JJ         ; J = J + DJ
11CD F71108           (lily_highcolor_yj):00151             STB  JJ
11D0 1F98             (lily_highcolor_yj):00152             TFR  B,A        ; SPLIT J INTO 2 3-BIT WORDS
11D2 8407             (lily_highcolor_yj):00153             ANDA #$7
11D4 B7110C           (lily_highcolor_yj):00154             STA  JLO
11D7 54               (lily_highcolor_yj):00155             LSRB
11D8 54               (lily_highcolor_yj):00156             LSRB
11D9 54               (lily_highcolor_yj):00157             LSRB
11DA C407             (lily_highcolor_yj):00158             ANDB #$7
11DC F7110D           (lily_highcolor_yj):00159             STB  JHI
11DF 8D37             (lily_highcolor_yj):00160             BSR  DECODE     ; GET DK
11E1 FB1109           (lily_highcolor_yj):00161             ADDB KK         ; K = K + DK
11E4 F71109           (lily_highcolor_yj):00162             STB  KK
11E7 1F98             (lily_highcolor_yj):00163             TFR  B,A        ; SPLIT K INTO 2 3-BIT WORDS
11E9 8407             (lily_highcolor_yj):00164             ANDA #$7
11EB B7110A           (lily_highcolor_yj):00165             STA  KLO
11EE 54               (lily_highcolor_yj):00166             LSRB
11EF 54               (lily_highcolor_yj):00167             LSRB
11F0 54               (lily_highcolor_yj):00168             LSRB
11F1 C407             (lily_highcolor_yj):00169             ANDB #$7
11F3 F7110B           (lily_highcolor_yj):00170             STB  KHI
11F6 8E110A           (lily_highcolor_yj):00171             LDX  #KLO       ; FOR EACH OF KLO,KHI,JLO,JHI:
11F9                  (lily_highcolor_yj):00172         PIXLOOP
11F9 8D1D             (lily_highcolor_yj):00173             BSR  DECODE     ;     GET DY
11FB FB1107           (lily_highcolor_yj):00174             ADDB YY         ;     Y = Y + DY
11FE F71107           (lily_highcolor_yj):00175             STB  YY
1201 58               (lily_highcolor_yj):00176             LSLB
1202 58               (lily_highcolor_yj):00177             LSLB
1203 58               (lily_highcolor_yj):00178             LSLB
1204 EA80             (lily_highcolor_yj):00179             ORB  ,X+        ;     PIXEL = (Y<<3) | JK_PIECE
1206 F7FFE4           (lily_highcolor_yj):00180             STB  VDAT       ;     SEND IT TO DISPLAY
1209 8C110E           (lily_highcolor_yj):00181             CMPX #(JHI+1)
120C 25EB             (lily_highcolor_yj):00182             BLO  PIXLOOP    
120E FC1105           (lily_highcolor_yj):00183             LDD  QCOUNT     ; PIXEL QUARTET COUNTDOWN
1211 104A             (lily_highcolor_yj):00184             DECD
1213 26B0             (lily_highcolor_yj):00185             BNE  DRAWLOOP   ; LOOP UNTIL SCREEN FILLED.
1215 7E12C0           (lily_highcolor_yj):00186             JMP  END_REPORT ; SHOW DECODE DURATION AND END PROGRAM.
                      (lily_highcolor_yj):00187         ; -----------------------------------------------------------------------------
                      (lily_highcolor_yj):00188         ; MATCH THE INPUT AT (U,REM,REMLEN) TO A HUF CODE, AND RETURN SIGNED BYTE 
                      (lily_highcolor_yj):00189         ; (DELTA) IN B. ON RETURN, (U,REM,REMLEN) ARE ADVANCED TO THE NEXT INPUT BIT.
                      (lily_highcolor_yj):00190         ; -----------------------------------------------------------------------------
1218                  (lily_highcolor_yj):00191         DECODE:
1218 104F             (lily_highcolor_yj):00192             CLRD            ; CLEAR INPUT SHIFT-REGISTER
121A 11F61104         (lily_highcolor_yj):00193             LDF  REMLEN
121E 108E1003         (lily_highcolor_yj):00194             LDY  #CODETAB   ; POINT Y TO HUFFMAN CODE TABLE
1222                  (lily_highcolor_yj):00195         DEC_LOOP:           ; PER EACH ROW OF CODE TABLE
1222 11A6A4           (lily_highcolor_yj):00196             LDE  ,Y         ; NUM ADDL BITS OCCUPIED BY THIS CODE VS LAST ONE
1225 2719             (lily_highcolor_yj):00197             BEQ  COMPARE    ; IF WE HAVE ENOUGH INPUT BITS, GO TO COMPARISON.
1227                  (lily_highcolor_yj):00198         SHLOOP:             ; LEFT-SHIFT IN E BITS OF INPUT INTO D
1227 115D             (lily_highcolor_yj):00199             TSTF
1229 260A             (lily_highcolor_yj):00200             BNE  GOTREM     ; HAVE BITS IN OUR LITTLE INPUT BUFFER BYTE?
122B 11E6C0           (lily_highcolor_yj):00201             LDF  ,U+        ; READ ANOTHER BYTE INTO REM FROM INPUT AT U+
122E 11F71103         (lily_highcolor_yj):00202             STF  REM
1232 11C608           (lily_highcolor_yj):00203             LDF  #8         ; REMLEN IS EIGHT BITS AGAIN.
1235                  (lily_highcolor_yj):00204         GOTREM:
1235 781103           (lily_highcolor_yj):00205             LSL  REM        ; LEFT-SHIFT MSB FROM REM INTO LSB OF D
1238 1049             (lily_highcolor_yj):00206             ROLD
123A 115A             (lily_highcolor_yj):00207             DECF            ; REMLEN DECREASED
123C 114A             (lily_highcolor_yj):00208             DECE            ; NEEDED BITCOUNT DECREASED
123E 26E7             (lily_highcolor_yj):00209             BNE  SHLOOP     ; KEEP SHIFTING  UNTIL NO MORE BITS NEEDED.
1240                  (lily_highcolor_yj):00210         COMPARE:            ; COMPARE INPUT WORD TO HUFFMAN CODE.
1240 10A321           (lily_highcolor_yj):00211             CMPD 1,Y        ; INWORD == CODE?
1243 2704             (lily_highcolor_yj):00212             BEQ  DEC_DONE   ; IF YES, WE'RE DONE.
1245 3124             (lily_highcolor_yj):00213             LEAY 4,Y        ; IF NOPE, TRY NEXT CODE OF TABLE.
1247 20D9             (lily_highcolor_yj):00214             BRA  DEC_LOOP
1249                  (lily_highcolor_yj):00215         DEC_DONE:
1249 11F71104         (lily_highcolor_yj):00216             STF  REMLEN
124D E623             (lily_highcolor_yj):00217             LDB  3,Y        ; GET DECODED DELTA (SIGNED BYTE)
124F 39               (lily_highcolor_yj):00218             RTS
                      (lily_highcolor_yj):00219         ; -----------------------------------------------------------------------------
                      (lily_highcolor_yj):00220         ; SIGN-EXTEND TO 8-BITS THE 6-BIT VALUE IN REG B
                      (lily_highcolor_yj):00221         ; -----------------------------------------------------------------------------
1250                  (lily_highcolor_yj):00222         SEX6:
1250 F71110           (lily_highcolor_yj):00223             STB  TMP8
1253 C420             (lily_highcolor_yj):00224             ANDB #$20
1255 2706             (lily_highcolor_yj):00225             BEQ  SEXDONE
1257 F61110           (lily_highcolor_yj):00226             LDB  TMP8
125A CAC0             (lily_highcolor_yj):00227             ORB  #$C0
125C 39               (lily_highcolor_yj):00228             RTS
125D                  (lily_highcolor_yj):00229         SEXDONE:
125D F61110           (lily_highcolor_yj):00230             LDB  TMP8
1260 39               (lily_highcolor_yj):00231             RTS    
                      (lily_highcolor_yj):00232         ;------------------------------------------------------------------------------
                      (lily_highcolor_yj):00233         ; COPIES BITSTRING OF LEN. E FROM (U,REM,REMLEN) TO D, RIGHT-JUSTIFIED.
                      (lily_highcolor_yj):00234         ; ON RETURN, (U,REM,REMLEN) ARE ADVANCED TO NEXT BIT. 
                      (lily_highcolor_yj):00235         ;------------------------------------------------------------------------------
1261                  (lily_highcolor_yj):00236         GET_BITS:
1261 104F             (lily_highcolor_yj):00237             CLRD            ; INIT DEST WORD
1263 11F61104         (lily_highcolor_yj):00238             LDF  REMLEN
1267                  (lily_highcolor_yj):00239         GB_LOOP:
1267 115D             (lily_highcolor_yj):00240             TSTF
1269 260A             (lily_highcolor_yj):00241             BNE  GB_GOTREM
126B 11E6C0           (lily_highcolor_yj):00242             LDF  ,U+
126E 11F71103         (lily_highcolor_yj):00243             STF  REM
1272 11C608           (lily_highcolor_yj):00244             LDF  #8
1275                  (lily_highcolor_yj):00245         GB_GOTREM:
1275 781103           (lily_highcolor_yj):00246             LSL  REM
1278 1049             (lily_highcolor_yj):00247             ROLD
127A 115A             (lily_highcolor_yj):00248             DECF    
127C 114A             (lily_highcolor_yj):00249             DECE    
127E 26E7             (lily_highcolor_yj):00250             BNE  GB_LOOP
1280 11F71104         (lily_highcolor_yj):00251             STF  REMLEN
1284 39               (lily_highcolor_yj):00252             RTS   
                      (lily_highcolor_yj):00253         ;------------------------------------------------------------------------------
                      (lily_highcolor_yj):00254         ; GIVEN I64'S AT X AND U, SUBTRACT U FROM X, LEAVING RESULT IN X.
                      (lily_highcolor_yj):00255         ;------------------------------------------------------------------------------
1285                  (lily_highcolor_yj):00256         SUB64_XU:
1285 EC06             (lily_highcolor_yj):00257             LDD  6,X
1287 A346             (lily_highcolor_yj):00258             SUBD 6,U
1289 ED06             (lily_highcolor_yj):00259             STD  6,X
128B EC04             (lily_highcolor_yj):00260             LDD  4,X
128D 10A244           (lily_highcolor_yj):00261             SBCD 4,U
1290 ED04             (lily_highcolor_yj):00262             STD  4,X
1292 EC02             (lily_highcolor_yj):00263             LDD  2,X
1294 10A242           (lily_highcolor_yj):00264             SBCD 2,U
1297 ED02             (lily_highcolor_yj):00265             STD  2,X
1299 EC00             (lily_highcolor_yj):00266             LDD  0,X
129B 10A240           (lily_highcolor_yj):00267             SBCD 0,U
129E ED00             (lily_highcolor_yj):00268             STD  0,X
12A0 39               (lily_highcolor_yj):00269             RTS
                      (lily_highcolor_yj):00270         ;------------------------------------------------------------------------------
                      (lily_highcolor_yj):00271         ; SHOW HOW LONG IT TOOK TO DECODE/DRAW THE IMAGE AND END THE PROGRAM.
                      (lily_highcolor_yj):00272         ;------------------------------------------------------------------------------
12A1 0A0D             (lily_highcolor_yj):00273         MSG_TOOK    FCB  LF,CR
12A3 2A2A2A204465636F (lily_highcolor_yj):00274                     FCC  "*** Decode took "
     646520746F6F6B20
12B3 00               (lily_highcolor_yj):00275                     FCB  0
12B4 207469636B732E   (lily_highcolor_yj):00276         MSG_END     FCC  " ticks."
12BB 0A0D0A0D00       (lily_highcolor_yj):00277         MSG_CR      FCB  LF,CR,LF,CR,0
                      (lily_highcolor_yj):00278         ; -----------------------------------------------------------------------------
12C0                  (lily_highcolor_yj):00279         END_REPORT
12C0 8E1119           (lily_highcolor_yj):00280             LDX  #TEND          ; GET END TIME. 
12C3 BDFEC1           (lily_highcolor_yj):00281             JSR  BF_RTC_GETTIX  
12C6 CE1111           (lily_highcolor_yj):00282             LDU  #TSTART        ; CALC ELAPSED TICKS,
12C9 BD1285           (lily_highcolor_yj):00283             JSR  SUB64_XU    
12CC 108E12A1         (lily_highcolor_yj):00284             LDY  #MSG_TOOK
12D0 BDFEAC           (lily_highcolor_yj):00285             JSR  BF_UT_PUTS
12D3 8E1121           (lily_highcolor_yj):00286             LDX  #SERBUF        ; AND PRINT IT OUT
12D6 FC111F           (lily_highcolor_yj):00287             LDD  TEND+6
12D9 BDFEC7           (lily_highcolor_yj):00288             JSR  BF_S_INTD      ; IN DECIMAL.
12DC 8600             (lily_highcolor_yj):00289             LDA  #NUL
12DE A780             (lily_highcolor_yj):00290             STA  ,X+
12E0 108E1121         (lily_highcolor_yj):00291             LDY  #SERBUF
12E4 BDFEAC           (lily_highcolor_yj):00292             JSR  BF_UT_PUTS
12E7 108E12B4         (lily_highcolor_yj):00293             LDY  #MSG_END
12EB BDFEAC           (lily_highcolor_yj):00294             JSR  BF_UT_PUTS
12EE BDFEAF           (lily_highcolor_yj):00295             JSR  BF_UT_WAITTX
12F1 39               (lily_highcolor_yj):00296             RTS                 ; END OF PROGRAM
                      (lily_highcolor_yj):00297         ; -----------------------------------------------------------------------------
