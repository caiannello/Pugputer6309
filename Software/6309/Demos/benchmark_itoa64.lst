                      (benchmark_itoa64.):00229         ;------------------------------------------------------------------------------
                      (benchmark_itoa64.):00230         ; GIVEN AN I64 AT X, OUTPUTS IT AS A NULL-TERMINATED DECIMAL STRING AT Y.
                      (benchmark_itoa64.):00231         ; ON RETURN, X WILL BE PAST THE 8-BYTE INPUT, AND Y WILL POINT AT THE STR NULL.
                      (benchmark_itoa64.):00232         ;------------------------------------------------------------------------------
124A                  (benchmark_itoa64.):00233         ITOA64_8:
124A EC81             (benchmark_itoa64.):00234             LDD  ,X++           ; STASH I64 INPUT VALUE AT X TO TEMP WORKING VAR
124C FD1099           (benchmark_itoa64.):00235             STD  I64+0
124F EC81             (benchmark_itoa64.):00236             LDD  ,X++
1251 FD109B           (benchmark_itoa64.):00237             STD  I64+2
1254 EC81             (benchmark_itoa64.):00238             LDD  ,X++
1256 FD109D           (benchmark_itoa64.):00239             STD  I64+4
1259 EC81             (benchmark_itoa64.):00240             LDD  ,X++
125B FD109F           (benchmark_itoa64.):00241             STD  I64+6
125E 3410             (benchmark_itoa64.):00242             PSHS X
1260 B61099           (benchmark_itoa64.):00243             LDA  I64
1263 8480             (benchmark_itoa64.):00244             ANDA #$80
1265 270A             (benchmark_itoa64.):00245             BEQ  DIDNEG
1267 8E1099           (benchmark_itoa64.):00246             LDX  #I64           ; IF I64 IS NEGATIVE, NEGATE IT,
126A BD111D           (benchmark_itoa64.):00247             JSR  NEGATE64_8
126D 862D             (benchmark_itoa64.):00248             LDA  #'-'           ; AND OUTPUT A MINUS SIGN.
126F A7A0             (benchmark_itoa64.):00249             STA  ,Y+
1271                  (benchmark_itoa64.):00250         DIDNEG:
1271 8E1099           (benchmark_itoa64.):00251             LDX  #I64           ; X AT TMP64
1274 CE11B2           (benchmark_itoa64.):00252             LDU  #POWERS        ; U AT POWERS TABLE
1277 8601             (benchmark_itoa64.):00253             LDA  #1
1279 B710A2           (benchmark_itoa64.):00254             STA  LEADZ          ; IGNORING LEADING ZEROES
127C                  (benchmark_itoa64.):00255         IT64_LOOP:              ; FOR EACH POWER OF TEN (EACH DIGIT)
127C 8630             (benchmark_itoa64.):00256             LDA  #'0'
127E B710A1           (benchmark_itoa64.):00257             STA  DIGIT
1281                  (benchmark_itoa64.):00258         IT64_ILOOP:             ; CALCULATE A DIGIT
1281 BD117F           (benchmark_itoa64.):00259             JSR  CMP64_XU_8     ; WHILE TMP64 >= POWER:
1284 2508             (benchmark_itoa64.):00260             BLO  DONE_ILOOP
1286 7C10A1           (benchmark_itoa64.):00261             INC  DIGIT          ;     DIGIT++
1289 BD114E           (benchmark_itoa64.):00262             JSR  SUB64_XU_8     ;     TMP64 -= POWER
128C 20F3             (benchmark_itoa64.):00263             BRA  IT64_ILOOP
128E                  (benchmark_itoa64.):00264         DONE_ILOOP:
128E B610A2           (benchmark_itoa64.):00265             LDA  LEADZ          ; IF NOT IGNORING LEADING ZEROES,
1291 2712             (benchmark_itoa64.):00266             BEQ  ADDDIGIT       ; OUTPUT EVERY DIGIT.   
1293 B610A1           (benchmark_itoa64.):00267             LDA  DIGIT
1296 8130             (benchmark_itoa64.):00268             CMPA #'0'
1298 2608             (benchmark_itoa64.):00269             BNE  NONZERO        ; DIGIT IS NONZERO.
129A 11831377         (benchmark_itoa64.):00270             CMPU #TEST_VECTORS-8 ; IF ALL ZEROES, DO OUTPUT THE LAST ONE.
129E 2702             (benchmark_itoa64.):00271             BEQ  NONZERO
12A0 2008             (benchmark_itoa64.):00272             BRA  SKIPDIGIT      ; SKIP THIS ZERO DIGIT.
12A2                  (benchmark_itoa64.):00273         NONZERO:
12A2 7F10A2           (benchmark_itoa64.):00274             CLR  LEADZ          ; DONE IGNORING ZEROES.
12A5                  (benchmark_itoa64.):00275         ADDDIGIT:
12A5 B610A1           (benchmark_itoa64.):00276             LDA  DIGIT          ; ADD DIGIT TO OUTPUT
12A8 A7A0             (benchmark_itoa64.):00277             STA  ,Y+
12AA                  (benchmark_itoa64.):00278         SKIPDIGIT:
12AA 3348             (benchmark_itoa64.):00279             LEAU 8,U            ; POINT U AT NEXT (LOWER) POWER OF 10, IF ANY.
12AC 1183124A         (benchmark_itoa64.):00280             CMPU #POWERS+152    ; IF PLACE VALUES REMAINING,
12B0 26CA             (benchmark_itoa64.):00281             BNE  IT64_LOOP      ; DO NEXT ONE.
12B2                  (benchmark_itoa64.):00282         IT64_DONE:
12B2 8600             (benchmark_itoa64.):00283             LDA  #0
12B4 A7A4             (benchmark_itoa64.):00284             STA  ,Y
12B6 3510             (benchmark_itoa64.):00285             PULS X
12B8 39               (benchmark_itoa64.):00286             RTS
                      (benchmark_itoa64.):00287         ;------------------------------------------------------------------------------
                      (benchmark_itoa64.):00288         ; GIVEN AN I64 AT X, NEGATE IT. (COMPLEMENT ALL WORDS, THEN ADD 1.)
                      (benchmark_itoa64.):00289         ;------------------------------------------------------------------------------
12B9                  (benchmark_itoa64.):00290         NEGATE64_3:
12B9 CC0000           (benchmark_itoa64.):00291             LDD  #0
12BC A306             (benchmark_itoa64.):00292             SUBD 6,X
12BE ED06             (benchmark_itoa64.):00293             STD  6,X
12C0 CC0000           (benchmark_itoa64.):00294             LDD  #0
12C3 10A204           (benchmark_itoa64.):00295             SBCD 4,X
12C6 ED04             (benchmark_itoa64.):00296             STD  4,X
12C8 CC0000           (benchmark_itoa64.):00297             LDD  #0
12CB 10A202           (benchmark_itoa64.):00298             SBCD 2,X
12CE ED02             (benchmark_itoa64.):00299             STD  2,X
12D0 CC0000           (benchmark_itoa64.):00300             LDD  #0
12D3 10A200           (benchmark_itoa64.):00301             SBCD 0,X
12D6 ED00             (benchmark_itoa64.):00302             STD  0,X
12D8 39               (benchmark_itoa64.):00303             RTS
                      (benchmark_itoa64.):00304         ;------------------------------------------------------------------------------
                      (benchmark_itoa64.):00305         ; GIVEN I64'S AT X AND U, SUBTRACT U FROM X, LEAVING RESULT IN X.
                      (benchmark_itoa64.):00306         ;------------------------------------------------------------------------------
12D9                  (benchmark_itoa64.):00307         SUB64_XU_3:
12D9 EC06             (benchmark_itoa64.):00308             LDD   6,X
12DB A346             (benchmark_itoa64.):00309             SUBD  6,U
12DD ED06             (benchmark_itoa64.):00310             STD   6,X
12DF EC04             (benchmark_itoa64.):00311             LDD   4,X
12E1 10A244           (benchmark_itoa64.):00312             SBCD  4,U
12E4 ED04             (benchmark_itoa64.):00313             STD   4,X
12E6 EC02             (benchmark_itoa64.):00314             LDD   2,X
12E8 10A242           (benchmark_itoa64.):00315             SBCD  2,U
12EB ED02             (benchmark_itoa64.):00316             STD   2,X
12ED EC00             (benchmark_itoa64.):00317             LDD   0,X
12EF 10A240           (benchmark_itoa64.):00318             SBCD  0,U
12F2 ED00             (benchmark_itoa64.):00319             STD   0,X
12F4 39               (benchmark_itoa64.):00320             RTS
                      (benchmark_itoa64.):00321         ;------------------------------------------------------------------------------
                      (benchmark_itoa64.):00322         ; GIVEN I64'S AT X AND U, COMPARE X TO U.
                      (benchmark_itoa64.):00323         ;------------------------------------------------------------------------------
12F5                  (benchmark_itoa64.):00324         CMP64_XU_3:
12F5 1C7E             (benchmark_itoa64.):00325             ANDCC #$7E          ; CLEAR CARRY
12F7 EC00             (benchmark_itoa64.):00326             LDD   0,X
12F9 10A340           (benchmark_itoa64.):00327             CMPD  0,U
12FC 2613             (benchmark_itoa64.):00328             BNE   DONECMP64_3
12FE EC02             (benchmark_itoa64.):00329             LDD   2,X
1300 10A342           (benchmark_itoa64.):00330             CMPD  2,U
1303 260C             (benchmark_itoa64.):00331             BNE   DONECMP64_3
1305 EC04             (benchmark_itoa64.):00332             LDD   4,X
1307 10A344           (benchmark_itoa64.):00333             CMPD  4,U
130A 2605             (benchmark_itoa64.):00334             BNE   DONECMP64_3
130C EC06             (benchmark_itoa64.):00335             LDD   6,X
130E 10A346           (benchmark_itoa64.):00336             CMPD  6,U
1311                  (benchmark_itoa64.):00337         DONECMP64_3:
1311 39               (benchmark_itoa64.):00338             RTS      
                      (benchmark_itoa64.):00339         ;------------------------------------------------------------------------------
                      (benchmark_itoa64.):00340         ; GIVEN AN I64 AT X, OUTPUTS IT AS A NULL-TERMINATED DECIMAL STRING AT Y.
                      (benchmark_itoa64.):00341         ; ON RETURN, X WILL BE PAST THE 8-BYTE INPUT, AND Y WILL POINT AT THE STR NULL.
                      (benchmark_itoa64.):00342         ;------------------------------------------------------------------------------
1312                  (benchmark_itoa64.):00343         ITOA64_3:
1312 10EC81           (benchmark_itoa64.):00344             LDQ   ,X++          ; STASH I64 INPUT VALUE AT X TO TEMP WORKING VAR
1315 3002             (benchmark_itoa64.):00345             LEAX 2,X
1317 10FD1099         (benchmark_itoa64.):00346             STQ  I64+0
131B 10EC81           (benchmark_itoa64.):00347             LDQ   ,X++
131E 3002             (benchmark_itoa64.):00348             LEAX 2,X
1320 10FD109D         (benchmark_itoa64.):00349             STQ  I64+4
1324 3410             (benchmark_itoa64.):00350             PSHS X
1326 B61099           (benchmark_itoa64.):00351             LDA  I64
1329 8480             (benchmark_itoa64.):00352             ANDA #$80
132B 270A             (benchmark_itoa64.):00353             BEQ  DIDNEG_3
132D 8E1099           (benchmark_itoa64.):00354             LDX  #I64           ; IF I64 IS NEGATIVE, NEGATE IT,
1330 BD12B9           (benchmark_itoa64.):00355             JSR  NEGATE64_3
1333 862D             (benchmark_itoa64.):00356             LDA  #'-'           ; AND OUTPUT A MINUS SIGN.
1335 A7A0             (benchmark_itoa64.):00357             STA  ,Y+
1337                  (benchmark_itoa64.):00358         DIDNEG_3:
1337 8E1099           (benchmark_itoa64.):00359             LDX  #I64           ; X AT TMP64
133A CE11B2           (benchmark_itoa64.):00360             LDU  #POWERS        ; U AT POWERS TABLE
133D 8601             (benchmark_itoa64.):00361             LDA  #1
133F B710A2           (benchmark_itoa64.):00362             STA  LEADZ          ; IGNORING LEADING ZEROES
1342                  (benchmark_itoa64.):00363         IT64_LOOP_3:            ; FOR EACH POWER OF TEN (EACH DIGIT)
1342 8630             (benchmark_itoa64.):00364             LDA  #'0'
