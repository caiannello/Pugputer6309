                      (benchmark_itoa64.):00001         ;------------------------------------------------------------------------------
                      (benchmark_itoa64.):00002         ;
                      (benchmark_itoa64.):00003         ; ITOA64 - 64-BIT SIGNED INTEGER TO DECOMAL STRING - EXPERIMENTS
                      (benchmark_itoa64.):00004         ;
                      (benchmark_itoa64.):00005         ; THIS IS A FAIRLY NAIVE IMPLEMENTATION OF ITOA FOR 64-BIT INTEGERS.
                      (benchmark_itoa64.):00006         ;
                      (benchmark_itoa64.):00007         ; FOR FUN, AND TO COMPARE PERFORMANCE DIFFERENCES BETWEEN MC6809 AND HD6309,
                      (benchmark_itoa64.):00008         ; TWO DIFFERENT VERSIONS OF EACH FUNCTION ARE PROVIDED, ONE FOR EACH 
                      (benchmark_itoa64.):00009         ; ARCHITECTURE.
                      (benchmark_itoa64.):00010         ;
                      (benchmark_itoa64.):00011         ; THE PRIMARY DIFFERENCE BETWEEN THE TWO VERSIONS IS THAT THE 6809 DOES 
                      (benchmark_itoa64.):00012         ; EVERYTHING BYTE-WISE, WHILE THE HD6309 VERSION, WHERE POSSIBLE DOES 
                      (benchmark_itoa64.):00013         ; A LOT OF THINGS WORD-WISE. 
                      (benchmark_itoa64.):00014         ;
                      (benchmark_itoa64.):00015         ; (THE 6309 FCN NAMES HAVE A _3, WHILE 6809 ONES HAVE _8)
                      (benchmark_itoa64.):00016         ;
                      (benchmark_itoa64.):00017         ; FOR TIMING, IT GETS THE START AND END TIMES OF EACH TEST USING THE 
                      (benchmark_itoa64.):00018         ; PUGPUTER 6309'S INTERRUPT-BASED 16HZ TICK COUNTER.
                      (benchmark_itoa64.):00019         ; 
                      (benchmark_itoa64.):00020         ; HERE'S THE RESULTS I GOT (WITH A 3.58MHZ BUS CLOCK).
                      (benchmark_itoa64.):00021         ;
                      (benchmark_itoa64.):00022         ;   CPU-MODE            CODE_VERSION            16HZ_TICKS
                      (benchmark_itoa64.):00023         ;   --------------      ------------            ----------
                      (benchmark_itoa64.):00024         ;   6309-NATIVE         6809                    187
                      (benchmark_itoa64.):00025         ;   6309-NATIVE         6309                    133   
                      (benchmark_itoa64.):00026         ;   6809-EMULATION      6809                    196
                      (benchmark_itoa64.):00027         ;   6809-EMULATION      6309                    144
                      (benchmark_itoa64.):00028         ;
                      (benchmark_itoa64.):00029         ;------------------------------------------------------------------------------
                      (benchmark_itoa64.):00030             INCLUDE bios_func_tab.d     ; BIOS functions jump table
                      (  bios_func_tab.d):00001         ;------------------------------------------------------------------------------
                      (  bios_func_tab.d):00002         ; BIOS BIOS FUNCTION JUMP TABLE ADDRESSES
                      (  bios_func_tab.d):00003         ;------------------------------------------------------------------------------
     FEA0             (  bios_func_tab.d):00004         FUNC_BASE       EQU  $FEA0          ; SEE 6309/BOOT/MAIN.ASM FOR DEFS
                      (  bios_func_tab.d):00005         ;------------------------------------------------------------------------------
     FEA0             (  bios_func_tab.d):00006         BF_V_RESET      EQU  FUNC_BASE+0
     FEA3             (  bios_func_tab.d):00007         BF_UT_GETC      EQU  FUNC_BASE+3
     FEA6             (  bios_func_tab.d):00008         BF_UT_GETS      EQU  FUNC_BASE+6
     FEA9             (  bios_func_tab.d):00009         BF_UT_PUTC      EQU  FUNC_BASE+9    ;
     FEAC             (  bios_func_tab.d):00010         BF_UT_PUTS      EQU  FUNC_BASE+12
     FEAF             (  bios_func_tab.d):00011         BF_UT_WAITTX    EQU  FUNC_BASE+15
     FEB2             (  bios_func_tab.d):00012         BF_UT_CLRSCR    EQU  FUNC_BASE+18
     FEB5             (  bios_func_tab.d):00013         BF_S_HEXA       EQU  FUNC_BASE+21   ; CONVERT REG A TO HEX OCTET AT X, X+=2
     FEB8             (  bios_func_tab.d):00014         BF_S_EOL        EQU  FUNC_BASE+24   ; PUT CR, LF, $00 AT X, X+=3
     FEBB             (  bios_func_tab.d):00015         BF_S_LEN        EQU  FUNC_BASE+27   ; PUT LEN OF STRING AT X INTO REG B
     FEBE             (  bios_func_tab.d):00016         BF_S_CPY        EQU  FUNC_BASE+30   ; COPY STRING AT Y TO MEM AT X. X+=?
     FEC1             (  bios_func_tab.d):00017         BF_RTC_GETTIX   EQU  FUNC_BASE+33   ; GET CURRENT SYSTEM TICKS TO I64 AT X.
     FEC4             (  bios_func_tab.d):00018         BF_S_TOUPPER    EQU  FUNC_BASE+36   ; MAKE A UPPERCASE IF IT IS LOWERCASE
     FEC7             (  bios_func_tab.d):00019         BF_S_INTD       EQU  FUNC_BASE+39   ; CONVERT REG D TO STRING AT X, X+=?
     FECA             (  bios_func_tab.d):00020         BF_RTC_SETTIX   EQU  FUNC_BASE+42   ; SET CURRENT SYSTEM TICKS FROM I64 AT X.
                      (  bios_func_tab.d):00021         ;------------------------------------------------------------------------------
                      (  bios_func_tab.d):00022         ; EOF
                      (  bios_func_tab.d):00023         ;------------------------------------------------------------------------------
                      (benchmark_itoa64.):00031         ;------------------------------------------------------------------------------
     000A             (benchmark_itoa64.):00032         LF  EQU  $0A        ; LINE FEED
     000D             (benchmark_itoa64.):00033         CR  EQU  $0D        ; CARRIAGE RETURN
     0000             (benchmark_itoa64.):00034         NUL EQU  $00
                      (benchmark_itoa64.):00035         ;------------------------------------------------------------------------------
