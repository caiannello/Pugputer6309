                      (SCROLLING_MANA_TI):00206         ; PALETTE, TILE MAP, TILES, AND RELATED DEFS.
                      (SCROLLING_MANA_TI):00207         ;
                      (SCROLLING_MANA_TI):00208         ; TO MAKE THIS DATA, I FOUND ONLINE A FAN-MADE PNG IMAGE OF THE MAP AND WROTE
                      (SCROLLING_MANA_TI):00209         ; A PYTHON SCRIPT WHICH LOADS THIS FILE AND EXAMINE THE IMAGE AS A SERIES 
                      (SCROLLING_MANA_TI):00210         ; OF 8X8 PIXEL TILES:
                      (SCROLLING_MANA_TI):00211         ;
                      (SCROLLING_MANA_TI):00212         ; FOR EACH TILE, THE SCRIPT CHECKS IF IT HAS BEEN SEEN BEFORE, AND IF NOT, 
                      (SCROLLING_MANA_TI):00213         ; IT IS ADDED TO A TABLE OF UNIQUE TILES' GRAPHICS CALLED 'TILES'. WE NOW KNOW
                      (SCROLLING_MANA_TI):00214         ; WHICH TILE INDEX BELONGS IN THAT SQUARE OF THE MAP, SO THAT IS ADDED TO A 
                      (SCROLLING_MANA_TI):00215         ; TABLE CALLED 'TILEMAP'.
                      (SCROLLING_MANA_TI):00216         ;
                      (SCROLLING_MANA_TI):00217         ; IDEALLY, THERE WILL BE SEVERAL DUPLICATE TILES USED IN THE IMAGE, AND SINCE
                      (SCROLLING_MANA_TI):00218         ; WE ONLY NEED TO KEEP ONE COPY OF EACH UNIQUE TILE, THE FINAL FILE SIZE
                      (SCROLLING_MANA_TI):00219         ; SHOULD OCCUPY MUCH LESS SPACE THAN THE ORIGINAL IMAGE.
                      (SCROLLING_MANA_TI):00220         ;
                      (SCROLLING_MANA_TI):00221         ; -----------------------------------------------------------------------------
     006C             (SCROLLING_MANA_TI):00222         TILEMAP_W   EQU 108         ; MAP WIDTH IN TILES
     0024             (SCROLLING_MANA_TI):00223         TILEMAP_H   EQU  36         ; MAP HEIGHT IN TILES
     0206             (SCROLLING_MANA_TI):00224         NUM_TILES   EQU 518         ; NUM TILES IN TILESET
                      (SCROLLING_MANA_TI):00225         
1554                  (SCROLLING_MANA_TI):00226         PALETTE                     ; 16-COLOR PALETTE %.RRR.BBB %.....GGG
