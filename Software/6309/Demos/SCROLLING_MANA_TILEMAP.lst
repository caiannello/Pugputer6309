                      (SCROLLING_MANA_TI):00001         ;------------------------------------------------------------------------------
                      (SCROLLING_MANA_TI):00002         ; PROJECT: MANA 
                      (SCROLLING_MANA_TI):00003         ; VERSION: 0.0.1
                      (SCROLLING_MANA_TI):00004         ;    FILE: MANA.ASM
                      (SCROLLING_MANA_TI):00005         ;  AUTHOR: CRAIG IANNELLO, PUGBUTT.COM
                      (SCROLLING_MANA_TI):00006         ;
                      (SCROLLING_MANA_TI):00007         ; DESCRIPTION: 
                      (SCROLLING_MANA_TI):00008         ;   DRAWS A TILEMAP FROM SQUARESOFT'S SNES TITLE: "SEIKEN DENSETSU 3".
                      (SCROLLING_MANA_TI):00009         ;   REQUIRES AN HD6309 CPU IN NATIVE MODE AND A V9958 VIDEO DISPLAY PROCESSOR.
                      (SCROLLING_MANA_TI):00010         ;
                      (SCROLLING_MANA_TI):00011         ; THERE IS A COMBINATION COARSE/SMOOTH SCROLLER HAPPENING. THE WHOLE BITMAP 
                      (SCROLLING_MANA_TI):00012         ; IS REDRAWN EVERY EIGHT FRAMES, SCROLLED BY 8 PIXELS. FOR THE INTERIM FRAMES,
                      (SCROLLING_MANA_TI):00013         ; THE POS ADJUST REGISTER IS USED TO SMOOTH THE TRANSITION. THERE'S SOME 
                      (SCROLLING_MANA_TI):00014         ; VISUAL GLITCHES SINCE WE'RE NOT YET WAITING FOR VBLANK BEFORE PAGE-FLIPPING,
                      (SCROLLING_MANA_TI):00015         ; ETC.
                      (SCROLLING_MANA_TI):00016         ;
                      (SCROLLING_MANA_TI):00017         ;------------------------------------------------------------------------------
                      (SCROLLING_MANA_TI):00018             INCLUDE BIOS_FUNC_TAB.D     ; BIOS FCN JUMP TABLE AND CONSTANTS
                      (  BIOS_FUNC_TAB.D):00001         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00002         ; BIOS BIOS FUNCTION JUMP TABLE ADDRESSES
                      (  BIOS_FUNC_TAB.D):00003         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00004         FUNC_BASE       EQU  $FEA0          ; SEE 6309/BOOT/MAIN.ASM FOR DEFS
                      (  BIOS_FUNC_TAB.D):00005         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00006         BF_V_RESET      EQU  FUNC_BASE+0
     FEA3             (  BIOS_FUNC_TAB.D):00007         BF_UT_GETC      EQU  FUNC_BASE+3
     FEA6             (  BIOS_FUNC_TAB.D):00008         BF_UT_GETS      EQU  FUNC_BASE+6
     FEA9             (  BIOS_FUNC_TAB.D):00009         BF_UT_PUTC      EQU  FUNC_BASE+9    ;
     FEAC             (  BIOS_FUNC_TAB.D):00010         BF_UT_PUTS      EQU  FUNC_BASE+12
     FEAF             (  BIOS_FUNC_TAB.D):00011         BF_UT_WAITTX    EQU  FUNC_BASE+15
     FEB2             (  BIOS_FUNC_TAB.D):00012         BF_UT_CLRSCR    EQU  FUNC_BASE+18
     FEB5             (  BIOS_FUNC_TAB.D):00013         BF_S_HEXA       EQU  FUNC_BASE+21   ; CONVERT REG A TO HEX OCTET AT X, X+=2
     FEB8             (  BIOS_FUNC_TAB.D):00014         BF_S_EOL        EQU  FUNC_BASE+24   ; PUT CR, LF, $00 AT X, X+=3
     FEBB             (  BIOS_FUNC_TAB.D):00015         BF_S_LEN        EQU  FUNC_BASE+27   ; PUT LEN OF STRING AT X INTO REG B
     FEBE             (  BIOS_FUNC_TAB.D):00016         BF_S_CPY        EQU  FUNC_BASE+30   ; COPY STRING AT Y TO MEM AT X. X+=?
     FEC1             (  BIOS_FUNC_TAB.D):00017         BF_RTC_GETTIX   EQU  FUNC_BASE+33   ; GET CURRENT SYSTEM TICKS TO I64 AT X.
     FEC4             (  BIOS_FUNC_TAB.D):00018         BF_S_TOUPPER    EQU  FUNC_BASE+36   ; MAKE A UPPERCASE IF IT IS LOWERCASE
     FEC7             (  BIOS_FUNC_TAB.D):00019         BF_S_INTD       EQU  FUNC_BASE+39   ; CONVERT REG D TO STRING AT X, X+=?
     FECA             (  BIOS_FUNC_TAB.D):00020         BF_RTC_SETTIX   EQU  FUNC_BASE+42   ; SET CURRENT SYSTEM TICKS FROM I64 AT X.
                      (  BIOS_FUNC_TAB.D):00021         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00022         ; EOF
                      (  BIOS_FUNC_TAB.D):00023         ;------------------------------------------------------------------------------
                      (SCROLLING_MANA_TI):00019             INCLUDE DEFINES.D
                      (        DEFINES.D):00001         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00002         ; IO DEVICE BASE ADDRESSES
                      (        DEFINES.D):00003         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00004         
     FFEC             (        DEFINES.D):00005         BANK_BASE   EQU  $FFEC      : FFEC - FFEF: MEMORY BANK REGS 0...3 (BUILT-IN)
     FFE8             (        DEFINES.D):00006         ACIA_BASE   EQU  $FFE8      ; FFE8 - FFEB: SERIAL UART R65C51P2 (BUILT-IN)
     FFE4             (        DEFINES.D):00007         VDP_BASE    EQU  $FFE4      ; FFE4 - FFE7: VIDEO CHIP V9958
     FFE0             (        DEFINES.D):00008         OPL3_BASE   EQU  $FFE0      ; FFE0 - FFE3: MUSIC CHIP YMF262 (OPL3)
     FFB0             (        DEFINES.D):00009         VIA_BASE    EQU  $FFB0      ; FFB0 - FFBF: W65C22 VIA (SD CARD, SPI, KB, GPIO)
                      (        DEFINES.D):00010         
                      (        DEFINES.D):00011         ; V9958 VDP REGISTERS
     FFE4             (        DEFINES.D):00012         VDAT        EQU  VDP_BASE+0 ; PORT 0: VRAM DATA (R/W)
     FFE5             (        DEFINES.D):00013         VREG        EQU  VDP_BASE+1 ; PORT 1: STATUS REG (R), REGISTER/SETUP (W), VRAM ADDR (W)
     FFE6             (        DEFINES.D):00014         VPAL        EQU  VDP_BASE+2 ; PORT 2: PALETTE REGISTERS (W)
     FFE7             (        DEFINES.D):00015         VIND        EQU  VDP_BASE+3 ; PORT 3: REGISTER-INDIRECT ADDRESSING (W)
                      (        DEFINES.D):00016         
                      (        DEFINES.D):00017         ; MEMORY BANK REGISTERS 0..3 (BASE ADDRESS IN DEFINES.D)
                      (        DEFINES.D):00018         ; THESE ARE WRITE-ONLY, SO WE KEEP COPIES OF 1 THROUGH 3 IN 
                      (        DEFINES.D):00019         ; VARS IN MAIN.ASM: SBANK_1...SBANK_3
                      (        DEFINES.D):00020         
     FFEC             (        DEFINES.D):00021         MBANK_0     EQU  BANK_BASE+0
     FFED             (        DEFINES.D):00022         MBANK_1     EQU  BANK_BASE+1
     FFEE             (        DEFINES.D):00023         MBANK_2     EQU  BANK_BASE+2
     FFEF             (        DEFINES.D):00024         MBANK_3     EQU  BANK_BASE+3
                      (        DEFINES.D):00025         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00026         ; COMMON DEFINITIONS
                      (        DEFINES.D):00027         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00028         ; ASCII CODES
     001B             (        DEFINES.D):00029         ESC         EQU  $1B    ; ESCAPE
     000A             (        DEFINES.D):00030         LF          EQU  $0A    ; LINE FEED
     000D             (        DEFINES.D):00031         CR          EQU  $0D    ; CARRIAGE RETURN
     0000             (        DEFINES.D):00032         NUL         EQU  $00    ; NULL
     0020             (        DEFINES.D):00033         SPACE       EQU  $20
     007E             (        DEFINES.D):00034         TILDE       EQU  $7E
                      (        DEFINES.D):00035         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00036         _DATE       STRUCT
0000s                 (        DEFINES.D):00037         YEAR        RMB  2      ; DATE AS INTEGERS
0002s                 (        DEFINES.D):00038         DAYYR       RMB  2
0004s                 (        DEFINES.D):00039         MON         RMB  1
0005s                 (        DEFINES.D):00040         DAYMON      RMB  1
0006s                 (        DEFINES.D):00041         HOUR        RMB  1
0007s                 (        DEFINES.D):00042         MIN         RMB  1
0008s                 (        DEFINES.D):00043         SEC         RMB  1
0009s                 (        DEFINES.D):00044         HUND        RMB  1
000As                 (        DEFINES.D):00045         YEARBCD     RMB  2      ; DATE AS BCD
000Cs                 (        DEFINES.D):00046         DAYYRBCD    RMB  2
000Es                 (        DEFINES.D):00047         MONBCD      RMB  1
000Fs                 (        DEFINES.D):00048         DAYMONBCD   RMB  1
0010s                 (        DEFINES.D):00049         HOURBCD     RMB  1
0011s                 (        DEFINES.D):00050         MINBCD      RMB  1
0012s                 (        DEFINES.D):00051         SECBCD      RMB  1
0013s                 (        DEFINES.D):00052         HUNDBCD     RMB  1
0014s                 (        DEFINES.D):00053                     ENDS
                      (        DEFINES.D):00054         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00055         ; EOF
                      (        DEFINES.D):00056         ;------------------------------------------------------------------------------
                      (SCROLLING_MANA_TI):00020         ;------------------------------------------------------------------------------
     0023             (SCROLLING_MANA_TI):00021         JT_FIRQ EQU  $0023
                      (SCROLLING_MANA_TI):00022         
                      (SCROLLING_MANA_TI):00023                     ORG     $1000   ; VARS
                      (SCROLLING_MANA_TI):00024         ; -----------------------------------------------------------------------------
                      (SCROLLING_MANA_TI):00025         ; PROGRAM ENTRYPOINT
                      (SCROLLING_MANA_TI):00026         ; -----------------------------------------------------------------------------
1000                  (SCROLLING_MANA_TI):00027         ENTRYPOINT  
1000 8E113C           (SCROLLING_MANA_TI):00028             LDX  #VDP_G4_SEQ            ; SET MODE GRAPHICS4
1003                  (SCROLLING_MANA_TI):00029         VDP_INIT    
1003 A680             (SCROLLING_MANA_TI):00030             LDA  ,X+
1005 B7FFE5           (SCROLLING_MANA_TI):00031             STA  VREG
1008 8C114C           (SCROLLING_MANA_TI):00032             CMPX #(VDP_G4_SEQ+VDP_G4_SZ)
100B 25F6             (SCROLLING_MANA_TI):00033             BLO  VDP_INIT
100D 8E1554           (SCROLLING_MANA_TI):00034             LDX  #PALETTE               ; SET 16-COLOR PALETTE
1010 8600             (SCROLLING_MANA_TI):00035             LDA  #0
1012 B7FFE5           (SCROLLING_MANA_TI):00036             STA  VREG
1015 8690             (SCROLLING_MANA_TI):00037             LDA  #$90
1017 B7FFE5           (SCROLLING_MANA_TI):00038             STA  VREG
101A                  (SCROLLING_MANA_TI):00039         SET_PAL
101A A680             (SCROLLING_MANA_TI):00040             LDA  ,X+
101C B7FFE6           (SCROLLING_MANA_TI):00041             STA  VPAL
101F A680             (SCROLLING_MANA_TI):00042             LDA  ,X+
1021 B7FFE6           (SCROLLING_MANA_TI):00043             STA  VPAL
1024 8C1574           (SCROLLING_MANA_TI):00044             CMPX #END_PAL
1027 25F1             (SCROLLING_MANA_TI):00045             BLO  SET_PAL
1029 9E24             (SCROLLING_MANA_TI):00046             LDX  JT_FIRQ+1              ; PRESERVE DEFAULT FIRQ ISR ADDRESS,
102B BF1552           (SCROLLING_MANA_TI):00047             STX  VSNEXTISR              ; FOR USE WHEN A NON-VDP FIRQ HAPPENS.
102E 8E1124           (SCROLLING_MANA_TI):00048             LDX  #VDP_FIRQ              ; GET ADDRESS OF OUR ISR,
1031 9F24             (SCROLLING_MANA_TI):00049             STX  JT_FIRQ+1              ; AND INSERT IT IN FIRQ JUMP TABLE.
1033 CC0000           (SCROLLING_MANA_TI):00050             LDD  #0
1036 FD154C           (SCROLLING_MANA_TI):00051             STD  SCROLL_POS             ; INITIAL SMOOTH SCROLL POS 0
1039 7F154E           (SCROLLING_MANA_TI):00052             CLR  VID_PAGE               ; INITIAL GFX PAGE 0
103C                  (SCROLLING_MANA_TI):00053         DRAWLOOP    
103C 8600             (SCROLLING_MANA_TI):00054             LDA  #0         ; INITIAL SMOOTH SCROLL POS IS ZERO
103E B7154F           (SCROLLING_MANA_TI):00055             STA  SSH
1041 B7FFE5           (SCROLLING_MANA_TI):00056             STA  VREG
1044 8692             (SCROLLING_MANA_TI):00057             LDA  #$92
1046 B7FFE5           (SCROLLING_MANA_TI):00058             STA  VREG
1049 8603             (SCROLLING_MANA_TI):00059             LDA  #3         ; RESET SMOOTHSCROLLER'S 3-ROW COUNTDOWN
104B B71550           (SCROLLING_MANA_TI):00060             STA  SCD
104E B6154E           (SCROLLING_MANA_TI):00061             LDA  VID_PAGE   ; CHECK WHICH GFX PAGES WE WANT TO SHOW/UPDATE
1051 2626             (SCROLLING_MANA_TI):00062             BNE  DO_PAGE1
1053                  (SCROLLING_MANA_TI):00063         DO_PAGE0
1053 863F             (SCROLLING_MANA_TI):00064             LDA  #$3F       ; SELECT GRAPHIC PAGE 2/4 (MID 2 BYTES OF TOP NYBBLE)
1055 B7FFE5           (SCROLLING_MANA_TI):00065             STA  VREG
1058 8682             (SCROLLING_MANA_TI):00066             LDA  #$82
105A B7FFE5           (SCROLLING_MANA_TI):00067             STA  VREG
                      (SCROLLING_MANA_TI):00068             ; 1 101010 0000 0000
                      (SCROLLING_MANA_TI):00069             ; x   x   x   x   x   A16 A15 A14
105D 8600             (SCROLLING_MANA_TI):00070             LDA  #$00       ; SET VRAM WRITE ADRS TO $0000 (PAGE 1/4 )
105F B7FFE5           (SCROLLING_MANA_TI):00071             STA  VREG
1062 868E             (SCROLLING_MANA_TI):00072             LDA  #$8E
1064 B7FFE5           (SCROLLING_MANA_TI):00073             STA  VREG
                      (SCROLLING_MANA_TI):00074             ; A7  A6  A5  A4  A3  A2  A1  A0
1067 8600             (SCROLLING_MANA_TI):00075             LDA  #$00
1069 B7FFE5           (SCROLLING_MANA_TI):00076             STA  VREG
                      (SCROLLING_MANA_TI):00077             ; 0   /RD A13 A12 A11 A10 A9  A8
106C 8640             (SCROLLING_MANA_TI):00078             LDA  #$40   ; $40 pg 1
106E B7FFE5           (SCROLLING_MANA_TI):00079             STA  VREG
1071 8601             (SCROLLING_MANA_TI):00080             LDA  #1
1073 B7154E           (SCROLLING_MANA_TI):00081             STA  VID_PAGE
1076 7E109C           (SCROLLING_MANA_TI):00082             JMP  START_SCROLL
1079                  (SCROLLING_MANA_TI):00083         DO_PAGE1
1079 861F             (SCROLLING_MANA_TI):00084             LDA  #$1F       ; SELECT GRAPHIC PAGE 1/4 (MID 2 BYTES OF TOP NYBBLE)
107B B7FFE5           (SCROLLING_MANA_TI):00085             STA  VREG
107E 8682             (SCROLLING_MANA_TI):00086             LDA  #$82
1080 B7FFE5           (SCROLLING_MANA_TI):00087             STA  VREG
                      (SCROLLING_MANA_TI):00088             ; 1 101010 0000 0000
                      (SCROLLING_MANA_TI):00089             ; x   x   x   x   x   A16 A15 A14
1083 8602             (SCROLLING_MANA_TI):00090             LDA  #$02       ; SET VRAM WRITE ADRS TO $8000 (PAGE 2/4)
1085 B7FFE5           (SCROLLING_MANA_TI):00091             STA  VREG
1088 868E             (SCROLLING_MANA_TI):00092             LDA  #$8E
108A B7FFE5           (SCROLLING_MANA_TI):00093             STA  VREG
                      (SCROLLING_MANA_TI):00094             ; A7  A6  A5  A4  A3  A2  A1  A0
108D 8600             (SCROLLING_MANA_TI):00095             LDA  #$00
108F B7FFE5           (SCROLLING_MANA_TI):00096             STA  VREG
                      (SCROLLING_MANA_TI):00097             ; 0   /RD A13 A12 A11 A10 A9  A8
1092 8640             (SCROLLING_MANA_TI):00098             LDA  #$40   ; $40 pg 1
1094 B7FFE5           (SCROLLING_MANA_TI):00099             STA  VREG
1097 8600             (SCROLLING_MANA_TI):00100             LDA  #0
1099 B7154E           (SCROLLING_MANA_TI):00101             STA  VID_PAGE
109C                  (SCROLLING_MANA_TI):00102         START_SCROLL
109C CC5634           (SCROLLING_MANA_TI):00103             LDD  #TILEMAP   ; POINTER TO TILEMAP (ARRAY OF TILE ADDRESSES)
109F F3154C           (SCROLLING_MANA_TI):00104             ADDD SCROLL_POS
10A2 1F03             (SCROLLING_MANA_TI):00105             TFR  D,U
10A4 FC154C           (SCROLLING_MANA_TI):00106             LDD  SCROLL_POS
10A7 C30002           (SCROLLING_MANA_TI):00107             ADDD #2         ; COARSE SCROLL TILEMAP LEFT 1 TILE
10AA FD154C           (SCROLLING_MANA_TI):00108             STD  SCROLL_POS
10AD 10830360         (SCROLLING_MANA_TI):00109             CMPD #864       ; IF CANT COARSE SCROLL ANYMORE,
10B1 2C68             (SCROLLING_MANA_TI):00110             BGE  RESET_SCROLL ; RESET SCROLL POS.
10B3                  (SCROLLING_MANA_TI):00111         DONESCROLL            
10B3 C618             (SCROLLING_MANA_TI):00112             LDB  #24         ; TILE ROW COUNTER
10B5                  (SCROLLING_MANA_TI):00113         MAP_ROWS    
10B5 11C620           (SCROLLING_MANA_TI):00114             LDF  #32        ; TILE COLUMN COUNTER
10B8 108E114C         (SCROLLING_MANA_TI):00115             LDY  #TILEBUF   ; 1 KB DEST BUFFER FOR RENDERED TILES
10BC                  (SCROLLING_MANA_TI):00116         MAP_ROW     
10BC AEC1             (SCROLLING_MANA_TI):00117             LDX  ,U++       ; GET NEXT TILE ADDRESS FROM TILEMAP
10BE 118608           (SCROLLING_MANA_TI):00118             LDE  #8         ; TILE PIXEL ROW COUNTER
10C1                  (SCROLLING_MANA_TI):00119         TILE_DRAW
10C1 A680             (SCROLLING_MANA_TI):00120             LDA  ,X+        ; RENDER AN 8-PIXEL ROW OF TILE
10C3 A7A0             (SCROLLING_MANA_TI):00121             STA  ,Y+
10C5 A680             (SCROLLING_MANA_TI):00122             LDA  ,X+
10C7 A7A0             (SCROLLING_MANA_TI):00123             STA  ,Y+
10C9 A680             (SCROLLING_MANA_TI):00124             LDA  ,X+
10CB A7A0             (SCROLLING_MANA_TI):00125             STA  ,Y+
10CD A680             (SCROLLING_MANA_TI):00126             LDA  ,X+
10CF A7A0             (SCROLLING_MANA_TI):00127             STA  ,Y+
10D1 31A87C           (SCROLLING_MANA_TI):00128             LEAY 124,Y      ; STRIDE TO NEXT PIXEL ROW OF DEST BUFFER
10D4 114A             (SCROLLING_MANA_TI):00129             DECE
10D6 26E9             (SCROLLING_MANA_TI):00130             BNE  TILE_DRAW
10D8 31A9FC04         (SCROLLING_MANA_TI):00131             LEAY -1020,Y    ; RESET DEST BUF ADRS TO NEXT TILE POS.
10DC 115A             (SCROLLING_MANA_TI):00132             DECF 
10DE 26DC             (SCROLLING_MANA_TI):00133             BNE  MAP_ROW    ; LOOP TO RENDER ALL TILES OF THE MAP ROW
10E0 8E114C           (SCROLLING_MANA_TI):00134             LDX  #TILEBUF
10E3                  (SCROLLING_MANA_TI):00135         VDP_COPY
10E3 A680             (SCROLLING_MANA_TI):00136             LDA  ,X+        ; COPY RENDERED TILEROW TO VDP
10E5 B7FFE4           (SCROLLING_MANA_TI):00137             STA  VDAT
10E8 8C154C           (SCROLLING_MANA_TI):00138             CMPX #(TILEBUF+1024)
10EB 25F6             (SCROLLING_MANA_TI):00139             BLO  VDP_COPY
10ED 33C90098         (SCROLLING_MANA_TI):00140             LEAU ((TILEMAP_W-32)*2),U  ; STRIDE TO NEXT TILEMAP ROW
                      (SCROLLING_MANA_TI):00141             ; EVERY THREE TILE ROWS, SMOOTH-SCROLL BY ONE PIXEL
                      (SCROLLING_MANA_TI):00142             ; $VH,$92   H= (LEFTMOST) 7 .. 1 ,(CENTER) 0, H=15..8 (RIGHTMOST)
                      (SCROLLING_MANA_TI):00143             ; V=8..15 (BOTTOM), 1..7 (TOP)
10F1 7A1550           (SCROLLING_MANA_TI):00144             DEC  SCD
10F4 2613             (SCROLLING_MANA_TI):00145             BNE  SKIPSS
10F6 7C154F           (SCROLLING_MANA_TI):00146             INC  SSH
10F9 B6154F           (SCROLLING_MANA_TI):00147             LDA  SSH
10FC B7FFE5           (SCROLLING_MANA_TI):00148             STA  VREG
10FF 8692             (SCROLLING_MANA_TI):00149             LDA  #$92
1101 B7FFE5           (SCROLLING_MANA_TI):00150             STA  VREG
1104 8603             (SCROLLING_MANA_TI):00151             LDA  #3         ; RESET 3-ROW COUNTDOWN
1106 B71550           (SCROLLING_MANA_TI):00152             STA  SCD
1109                  (SCROLLING_MANA_TI):00153         SKIPSS
1109 5A               (SCROLLING_MANA_TI):00154             DECB
110A 26A9             (SCROLLING_MANA_TI):00155             BNE  MAP_ROWS   ; LOOP UNTIL ALL MAP ROWS ARE DRAWN.
110C                  (SCROLLING_MANA_TI):00156         LOOPEND
110C BDFEA3           (SCROLLING_MANA_TI):00157             JSR  BF_UT_GETC ; PRESS ESCAPE TO EXIT DEMO,
110F 811B             (SCROLLING_MANA_TI):00158             CMPA #$1B
1111 1026FF27         (SCROLLING_MANA_TI):00159             LBNE DRAWLOOP   ; OR WE'LL KEEP REDRAWING.
1115 BE1552           (SCROLLING_MANA_TI):00160             LDX  VSNEXTISR  ; REMOVE OUR JUMP TABLE ENTRY
1118 9F24             (SCROLLING_MANA_TI):00161             STX  JT_FIRQ+1  ; (REPLACE WITH ORIG VALUE)
111A 39               (SCROLLING_MANA_TI):00162             RTS             ; ALL DONE.
                      (SCROLLING_MANA_TI):00163         
111B                  (SCROLLING_MANA_TI):00164         RESET_SCROLL
111B CC0000           (SCROLLING_MANA_TI):00165             LDD  #0
111E FD154C           (SCROLLING_MANA_TI):00166             STD  SCROLL_POS            
1121 7E10B3           (SCROLLING_MANA_TI):00167             JMP  DONESCROLL
                      (SCROLLING_MANA_TI):00168         ; -----------------------------------------------------------------------------
                      (SCROLLING_MANA_TI):00169         ; FIRQ  - can be called by the VDP for VBLANK, HBLANK, scanline, sprite, etc.
                      (SCROLLING_MANA_TI):00170         ; -----------------------------------------------------------------------------
1124                  (SCROLLING_MANA_TI):00171         VDP_FIRQ:    
1124 3476             (SCROLLING_MANA_TI):00172             PSHS A,B,X,Y,U
1126 1038             (SCROLLING_MANA_TI):00173             PSHSW     ; PUSH W ALSO
                      (SCROLLING_MANA_TI):00174         
                      (SCROLLING_MANA_TI):00175             ; ALSO TODO: MAKE THE VDP VBLANK STUFF IN HERE ONLY HAPPEN IF IT THE
                      (SCROLLING_MANA_TI):00176             ; FIRQ WAS REALLY CAUSED BY A VBLANK AND NOT SOMETHING ELSE LIKE HBLANK
                      (SCROLLING_MANA_TI):00177             ; OR A NON-VDP FIRQ.
                      (SCROLLING_MANA_TI):00178         
1128 4F               (SCROLLING_MANA_TI):00179             CLRA        ; GET VDP STATUS REGISTER S#0 TO DETERMINE INTERRUPT SOURCE
1129 B7FFE5           (SCROLLING_MANA_TI):00180             STA VREG    ; AND CLEAR THE INTERRUPT.
112C 868F             (SCROLLING_MANA_TI):00181             LDA #143
112E B7FFE5           (SCROLLING_MANA_TI):00182             STA VREG
1131 B6FFE5           (SCROLLING_MANA_TI):00183             LDA VREG
1134 B71551           (SCROLLING_MANA_TI):00184             STA VDP_INTRRUPT_REASON ; NOTE REASON TODO: NON-VBLANK HANDLERS
                      (SCROLLING_MANA_TI):00185         
