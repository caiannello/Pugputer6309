                      ( mana_tilemap.asm):00001         ;------------------------------------------------------------------------------
                      ( mana_tilemap.asm):00002         ; PROJECT: MANA 
                      ( mana_tilemap.asm):00003         ; VERSION: 0.0.1
                      ( mana_tilemap.asm):00004         ;    FILE: mana.asm
                      ( mana_tilemap.asm):00005         ;  AUTHOR: CRAIG IANNELLO, PUGBUTT.COM
                      ( mana_tilemap.asm):00006         ;
                      ( mana_tilemap.asm):00007         ; DESCRIPTION: 
                      ( mana_tilemap.asm):00008         ;   DRAWS A TILEMAP FROM SQUARESOFT'S SNES TITLE: "SEIKEN DENSETSU 3".
                      ( mana_tilemap.asm):00009         ;   REQUIRES AN HD6309 CPU IN NATIVE MODE AND A V9958 VIDEO DISPLAY PROCESSOR.
                      ( mana_tilemap.asm):00010         ;
                      ( mana_tilemap.asm):00011         ;------------------------------------------------------------------------------
                      ( mana_tilemap.asm):00012                                     ; V9958 VDP ADDRESSES
     F400             ( mana_tilemap.asm):00013         VDAT        EQU     $F400   ; PORT 0: VRAM DATA (R/W)
     F401             ( mana_tilemap.asm):00014         VREG        EQU     $F401   ; PORT 1: (R) STATUS REG, (W) FCN REG / VRAM ADDR
     F402             ( mana_tilemap.asm):00015         VPAL        EQU     $F402   ; PORT 2: (W) PALETTE REGISTERS
     F403             ( mana_tilemap.asm):00016         VIND        EQU     $F403   ; PORT 3: (W) REGISTER-INDIRECT ADDRESSING
                      ( mana_tilemap.asm):00017         
                      ( mana_tilemap.asm):00018         ;------------------------------------------------------------------------------
                      ( mana_tilemap.asm):00019                     ORG     $4000   ; VARS
                      ( mana_tilemap.asm):00020         
4000                  ( mana_tilemap.asm):00021         TILEBUF     RMB     1024    ; FOR RASTERIZING ONE ROW OF TILES
                      ( mana_tilemap.asm):00022         
                      ( mana_tilemap.asm):00023                     ORG     $A000   ; CODE AND DATA
                      ( mana_tilemap.asm):00024         ; -----------------------------------------------------------------------------
     000E             ( mana_tilemap.asm):00025         VDP_G4_SZ   EQU     14      ; INIT SEQ FOR VDP MODE GRAPHICS4 (256 X 212 X 16)
A000 068040810A888089 ( mana_tilemap.asm):00026         VDP_G4_SEQ  FCB     $06,$80,$40,$81,$0A,$88,$80,$89,$1F,$82,$00,$8E,$00,$40
     1F82008E0040
                      ( mana_tilemap.asm):00027         ; -----------------------------------------------------------------------------
                      ( mana_tilemap.asm):00028         ; PROGRAM ENTRYPOINT
                      ( mana_tilemap.asm):00029         ; -----------------------------------------------------------------------------
A00E 8EA000           ( mana_tilemap.asm):00030         ENTRYPOINT  LDX  #VDP_G4_SEQ ; SET MODE GRAPHICS4
A011 A680             ( mana_tilemap.asm):00031         VDP_INIT    LDA  ,X+
A013 B7F401           ( mana_tilemap.asm):00032                     STA  VREG
A016 8CA00E           ( mana_tilemap.asm):00033                     CMPX #(VDP_G4_SEQ+VDP_G4_SZ)
A019 25F6             ( mana_tilemap.asm):00034                     BLO  VDP_INIT
A01B 8EA085           ( mana_tilemap.asm):00035                     LDX  #PALETTE   ; SET 16-COLOR PALETTE
A01E 8600             ( mana_tilemap.asm):00036                     LDA  #0
A020 B7F401           ( mana_tilemap.asm):00037                     STA  VREG
A023 8690             ( mana_tilemap.asm):00038                     LDA  #$90
A025 B7F401           ( mana_tilemap.asm):00039                     STA  VREG
A028 118600           ( mana_tilemap.asm):00040                     LDE  #0
A02B A680             ( mana_tilemap.asm):00041         SET_PAL     LDA  ,X+
A02D B7F402           ( mana_tilemap.asm):00042                     STA  VPAL
A030 A680             ( mana_tilemap.asm):00043                     LDA  ,X+
A032 B7F402           ( mana_tilemap.asm):00044                     STA  VPAL
A035 114C             ( mana_tilemap.asm):00045                     INCE
A037 118110           ( mana_tilemap.asm):00046                     CMPE #16
A03A 25EF             ( mana_tilemap.asm):00047                     BLO  SET_PAL
A03C CEA0A5           ( mana_tilemap.asm):00048                     LDU  #TILEMAP   ; POINTER TO TILEMAP (ARRAY OF TILE ADDRESSES)
A03F C600             ( mana_tilemap.asm):00049                     LDB  #0         ; TILE ROW COUNTER
A041 11C600           ( mana_tilemap.asm):00050         MAP_ROWS    LDF  #0         ; TILE COLUMN COUNTER
A044 108E4000         ( mana_tilemap.asm):00051                     LDY  #TILEBUF   ; DEST BUFFER FOR RENDERED TILES
A048 AEC1             ( mana_tilemap.asm):00052         MAP_ROW     LDX  ,U++       ; GET NEXT TILE ADDRESS FROM TILEMAP
A04A 118600           ( mana_tilemap.asm):00053                     LDE  #0         ; TILE PIXEL ROW COUNTER
A04D A680             ( mana_tilemap.asm):00054         TILE_DRAW   LDA  ,X+        ; RENDER AN 8-PIXEL ROW OF TILE
A04F A7A0             ( mana_tilemap.asm):00055                     STA  ,Y+
A051 A680             ( mana_tilemap.asm):00056                     LDA  ,X+
A053 A7A0             ( mana_tilemap.asm):00057                     STA  ,Y+
A055 A680             ( mana_tilemap.asm):00058                     LDA  ,X+
A057 A7A0             ( mana_tilemap.asm):00059                     STA  ,Y+
A059 A680             ( mana_tilemap.asm):00060                     LDA  ,X+
A05B A7A0             ( mana_tilemap.asm):00061                     STA  ,Y+
A05D 31A87C           ( mana_tilemap.asm):00062                     LEAY 124,Y      ; STRIDE TO NEXT PIXEL ROW OF DEST BUFFER
A060 114C             ( mana_tilemap.asm):00063                     INCE
A062 118108           ( mana_tilemap.asm):00064                     CMPE #8         ; REPEAT FOR ALL 8 PIXEL ROWS
A065 25E6             ( mana_tilemap.asm):00065                     BLO  TILE_DRAW
A067 31A9FC04         ( mana_tilemap.asm):00066                     LEAY -1020,Y    ; RESET DEST BUF ADRS TO NEXT TILE POS.
A06B 115C             ( mana_tilemap.asm):00067                     INCF 
A06D 11C120           ( mana_tilemap.asm):00068                     CMPF #32
A070 25D6             ( mana_tilemap.asm):00069                     BLO  MAP_ROW    ; LOOP TO RENDER ALL TILES OF THE MAP ROW
A072 8E4000           ( mana_tilemap.asm):00070                     LDX  #TILEBUF
A075 A680             ( mana_tilemap.asm):00071         VDP_COPY    LDA  ,X+        ; COPY RENDERED PIXELS TO VDP
A077 B7F400           ( mana_tilemap.asm):00072                     STA  VDAT
A07A 8C4400           ( mana_tilemap.asm):00073                     CMPX #(TILEBUF+1024)
A07D 25F6             ( mana_tilemap.asm):00074                     BLO  VDP_COPY
A07F 5C               ( mana_tilemap.asm):00075                     INCB            ; COUNT FINISHED ROWS
A080 C11A             ( mana_tilemap.asm):00076                     CMPB #26
A082 26BD             ( mana_tilemap.asm):00077                     BNE  MAP_ROWS   ; LOOP UNTIL ALL MAP ROWS ARE DRAWN.
A084 39               ( mana_tilemap.asm):00078                     RTS             ; ALL DONE.
                      ( mana_tilemap.asm):00079         ; -----------------------------------------------------------------------------
                      ( mana_tilemap.asm):00080         ; PALETTE, TILE MAP, TILES, AND RELATED DEFS.
                      ( mana_tilemap.asm):00081         ;
                      ( mana_tilemap.asm):00082         ; TO MAKE THIS DATA, I FOUND ONLINE A FAN-MADE PNG IMAGE OF THE MAP, LOADED
                      ( mana_tilemap.asm):00083         ; IT IN GIMP, CONVERTED TO 16-COLOR PALETTE, AND EXPORTED AS A C-LANGUAGE 
                      ( mana_tilemap.asm):00084         ; HEADER (UNCOMPRESSED TEXT) FILE. 
                      ( mana_tilemap.asm):00085         ;
                      ( mana_tilemap.asm):00086         ; I WROTE A PYTHON SCRIPT TO LOAD THIS FILE AND EXAMINE THE IMAGE AS A SERIES 
                      ( mana_tilemap.asm):00087         ; OF 8X8 PIXEL TILES:
                      ( mana_tilemap.asm):00088         ;
                      ( mana_tilemap.asm):00089         ; FOR EACH TILE, THE SCRIPT CHECKS IF IT HAS BEEN SEEN BEFORE, AND IF NOT, 
                      ( mana_tilemap.asm):00090         ; IT IS ADDED TO A TABLE OF UNIQUE TILES' GRAPHICS CALLED 'TILES'. WE NOW KNOW
                      ( mana_tilemap.asm):00091         ; WHICH TILE INDEX BELONGS IN THAT SQUARE OF THE MAP, SO THAT IS ADDED TO A 
                      ( mana_tilemap.asm):00092         ; TABLE CALLED 'TILEMAP'.
                      ( mana_tilemap.asm):00093         ;
                      ( mana_tilemap.asm):00094         ; IDEALLY, THERE WILL BE SEVERAL DUPLICATE TILES USED IN THE IMAGE, AND SINCE
                      ( mana_tilemap.asm):00095         ; WE ONLY NEED TO KEEP ONE COPY OF EACH UNIQUE TILE, THE FINAL FILE SIZE
                      ( mana_tilemap.asm):00096         ; SHOULD OCCUPY MUCH LESS SPACE THAN THE ORIGINAL IMAGE.
                      ( mana_tilemap.asm):00097         ;
                      ( mana_tilemap.asm):00098         ; -----------------------------------------------------------------------------
     0020             ( mana_tilemap.asm):00099         TILEMAP_W   EQU 32          ; MAP WIDTH IN TILES
     001A             ( mana_tilemap.asm):00100         TILEMAP_H   EQU 26          ; MAP HEIGHT IN TILES
     011F             ( mana_tilemap.asm):00101         NUM_TILES   EQU 287         ; NUM TILES IN TILESET
                      ( mana_tilemap.asm):00102         
A085                  ( mana_tilemap.asm):00103         PALETTE                     ; 16-COLOR PALETTE %.RRR.BBB %.....GGG
A085 1101120120011101 ( mana_tilemap.asm):00104             FDB $1101,$1201,$2001,$1101,$0102,$2102,$2102,$4002,$2103,$0104,$4203,$5103,$3004,$2005,$5105,$5106            
     0102210221024002
     2103010442035103
     3004200551055106
                      ( mana_tilemap.asm):00105         
A0A5                  ( mana_tilemap.asm):00106         TILEMAP                     ; TILE GRAPHIC ADDRESS PER MAP SQUARE -------------
A0A5 A725A745A765A785 ( mana_tilemap.asm):00107             FDB $0000*32+TILES,$0001*32+TILES,$0002*32+TILES,$0003*32+TILES,$0004*32+TILES,$0005*32+TILES,$0006*32+TILES,$0007*32+TILES,$0008*32+TILES,$0009*32+TILES,$000A*32+TILES,$0009*32+TILES,$000A*32+TILES,$0009*32+TILES,$000B*32+TILES,$0003*32+TILES
     A7A5A7C5A7E5A805
     A825A845A865A845
     A865A845A885A785
