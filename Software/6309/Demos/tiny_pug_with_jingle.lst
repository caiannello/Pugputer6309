                      (tiny_pug_with_jin):00001         ;------------------------------------------------------------------------------
                      (tiny_pug_with_jin):00002         ; PROJECT: PUGPUTER 6309 
                      (tiny_pug_with_jin):00003         ; VERSION: 0.0.1
                      (tiny_pug_with_jin):00004         ;    FILE: TINY_PUG_WITH_JINGLE.ASM
                      (tiny_pug_with_jin):00005         ;  AUTHOR: CRAIG IANNELLO, PUGBUTT.COM
                      (tiny_pug_with_jin):00006         ;
                      (tiny_pug_with_jin):00007         ; DESCRIPTION: 
                      (tiny_pug_with_jin):00008         ;
                      (tiny_pug_with_jin):00009         ; POSSIBLE PUGPUTER SPLASH SCREEN. FADES-IN A TINY B&W PUG ON A WHITE
                      (tiny_pug_with_jin):00010         ; BACKGROUND AND PLAYS THE JINGLE BY BISQWIT. 
                      (tiny_pug_with_jin):00011         ;
                      (tiny_pug_with_jin):00012         ;------------------------------------------------------------------------------
                      (tiny_pug_with_jin):00013             INCLUDE DEFINES.D           ; COMMON DEFINITIONS
                      (        DEFINES.D):00001         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00002         ; IO DEVICE BASE ADDRESSES
                      (        DEFINES.D):00003         ; -----------------------------------------------------------------------------
                      (        DEFINES.D):00004         
     FFEC             (        DEFINES.D):00005         BANK_BASE   EQU  $FFEC      : FFEC - FFEF: MEMORY BANK REGS 0...3 (BUILT-IN)
     FFE8             (        DEFINES.D):00006         ACIA_BASE   EQU  $FFE8      ; FFE8 - FFEB: SERIAL UART R65C51P2 (BUILT-IN)
     FFE4             (        DEFINES.D):00007         VDP_BASE    EQU  $FFE4      ; FFE4 - FFE7: VIDEO CHIP V9958
     FFE0             (        DEFINES.D):00008         OPL3_BASE   EQU  $FFE0      ; FFE0 - FFE3: MUSIC CHIP YMF262 (OPL3)
     FFB0             (        DEFINES.D):00009         VIA_BASE    EQU  $FFB0      ; FFB0 - FFBF: W65C22 VIA (SD CARD, SPI, KB, GPIO)
                      (        DEFINES.D):00010         
                      (        DEFINES.D):00011         ; V9958 VDP REGISTERS
     FFE4             (        DEFINES.D):00012         VDAT        EQU  VDP_BASE+0 ; PORT 0: VRAM DATA (R/W)
     FFE5             (        DEFINES.D):00013         VREG        EQU  VDP_BASE+1 ; PORT 1: STATUS REG (R), REGISTER/SETUP (W), VRAM ADDR (W)
     FFE6             (        DEFINES.D):00014         VPAL        EQU  VDP_BASE+2 ; PORT 2: PALETTE REGISTERS (W)
     FFE7             (        DEFINES.D):00015         VIND        EQU  VDP_BASE+3 ; PORT 3: REGISTER-INDIRECT ADDRESSING (W)
                      (        DEFINES.D):00016         
                      (        DEFINES.D):00017         ; MEMORY BANK REGISTERS 0..3 (BASE ADDRESS IN DEFINES.D)
                      (        DEFINES.D):00018         ; THESE ARE WRITE-ONLY, SO WE KEEP COPIES OF 1 THROUGH 3 IN 
                      (        DEFINES.D):00019         ; VARS IN MAIN.ASM: SBANK_1...SBANK_3
                      (        DEFINES.D):00020         
     FFEC             (        DEFINES.D):00021         MBANK_0     EQU  BANK_BASE+0
     FFED             (        DEFINES.D):00022         MBANK_1     EQU  BANK_BASE+1
     FFEE             (        DEFINES.D):00023         MBANK_2     EQU  BANK_BASE+2
     FFEF             (        DEFINES.D):00024         MBANK_3     EQU  BANK_BASE+3
                      (        DEFINES.D):00025         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00026         ; COMMON DEFINITIONS
                      (        DEFINES.D):00027         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00028         ; ASCII CODES
     001B             (        DEFINES.D):00029         ESC         EQU  $1B    ; ESCAPE
     000A             (        DEFINES.D):00030         LF          EQU  $0A    ; LINE FEED
     000D             (        DEFINES.D):00031         CR          EQU  $0D    ; CARRIAGE RETURN
     0000             (        DEFINES.D):00032         NUL         EQU  $00    ; NULL
     0020             (        DEFINES.D):00033         SPACE       EQU  $20
     007E             (        DEFINES.D):00034         TILDE       EQU  $7E
                      (        DEFINES.D):00035         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00036         _DATE       STRUCT
0000s                 (        DEFINES.D):00037         YEAR        RMB  2      ; DATE AS INTEGERS
0002s                 (        DEFINES.D):00038         DAYYR       RMB  2
0004s                 (        DEFINES.D):00039         MON         RMB  1
0005s                 (        DEFINES.D):00040         DAYMON      RMB  1
0006s                 (        DEFINES.D):00041         HOUR        RMB  1
0007s                 (        DEFINES.D):00042         MIN         RMB  1
0008s                 (        DEFINES.D):00043         SEC         RMB  1
0009s                 (        DEFINES.D):00044         HUND        RMB  1
000As                 (        DEFINES.D):00045         YEARBCD     RMB  2      ; DATE AS BCD
000Cs                 (        DEFINES.D):00046         DAYYRBCD    RMB  2
000Es                 (        DEFINES.D):00047         MONBCD      RMB  1
000Fs                 (        DEFINES.D):00048         DAYMONBCD   RMB  1
0010s                 (        DEFINES.D):00049         HOURBCD     RMB  1
0011s                 (        DEFINES.D):00050         MINBCD      RMB  1
0012s                 (        DEFINES.D):00051         SECBCD      RMB  1
0013s                 (        DEFINES.D):00052         HUNDBCD     RMB  1
0014s                 (        DEFINES.D):00053                     ENDS
                      (        DEFINES.D):00054         ;------------------------------------------------------------------------------
                      (        DEFINES.D):00055         ; EOF
                      (        DEFINES.D):00056         ;------------------------------------------------------------------------------
                      (tiny_pug_with_jin):00014             INCLUDE BIOS_FUNC_TAB.D     ; BIOS FCN JUMP TABLE AND CONSTANTS
                      (  BIOS_FUNC_TAB.D):00001         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00002         ; BIOS BIOS FUNCTION JUMP TABLE ADDRESSES
                      (  BIOS_FUNC_TAB.D):00003         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00004         FUNC_BASE       EQU  $FEA0          ; SEE 6309/BOOT/MAIN.ASM FOR DEFS
                      (  BIOS_FUNC_TAB.D):00005         ;------------------------------------------------------------------------------
     FEA0             (  BIOS_FUNC_TAB.D):00006         BF_V_RESET      EQU  FUNC_BASE+0
     FEA3             (  BIOS_FUNC_TAB.D):00007         BF_UT_GETC      EQU  FUNC_BASE+3
     FEA6             (  BIOS_FUNC_TAB.D):00008         BF_UT_GETS      EQU  FUNC_BASE+6
     FEA9             (  BIOS_FUNC_TAB.D):00009         BF_UT_PUTC      EQU  FUNC_BASE+9    ;
     FEAC             (  BIOS_FUNC_TAB.D):00010         BF_UT_PUTS      EQU  FUNC_BASE+12
     FEAF             (  BIOS_FUNC_TAB.D):00011         BF_UT_WAITTX    EQU  FUNC_BASE+15
     FEB2             (  BIOS_FUNC_TAB.D):00012         BF_UT_CLRSCR    EQU  FUNC_BASE+18
     FEB5             (  BIOS_FUNC_TAB.D):00013         BF_S_HEXA       EQU  FUNC_BASE+21   ; CONVERT REG A TO HEX OCTET AT X, X+=2
     FEB8             (  BIOS_FUNC_TAB.D):00014         BF_S_EOL        EQU  FUNC_BASE+24   ; PUT CR, LF, $00 AT X, X+=3
     FEBB             (  BIOS_FUNC_TAB.D):00015         BF_S_LEN        EQU  FUNC_BASE+27   ; PUT LEN OF STRING AT X INTO REG B
     FEBE             (  BIOS_FUNC_TAB.D):00016         BF_S_CPY        EQU  FUNC_BASE+30   ; COPY STRING AT Y TO MEM AT X. X+=?
     FEC1             (  BIOS_FUNC_TAB.D):00017         BF_RTC_GETTIX   EQU  FUNC_BASE+33   ; GET CURRENT SYSTEM TICKS TO I64 AT X.
     FEC4             (  BIOS_FUNC_TAB.D):00018         BF_S_TOUPPER    EQU  FUNC_BASE+36   ; MAKE A UPPERCASE IF IT IS LOWERCASE
     FEC7             (  BIOS_FUNC_TAB.D):00019         BF_S_INTD       EQU  FUNC_BASE+39   ; CONVERT REG D TO STRING AT X, X+=?
     FECA             (  BIOS_FUNC_TAB.D):00020         BF_RTC_SETTIX   EQU  FUNC_BASE+42   ; SET CURRENT SYSTEM TICKS FROM I64 AT X.
                      (  BIOS_FUNC_TAB.D):00021         ;------------------------------------------------------------------------------
                      (  BIOS_FUNC_TAB.D):00022         ; EOF
                      (  BIOS_FUNC_TAB.D):00023         ;------------------------------------------------------------------------------
                      (tiny_pug_with_jin):00015         ;------------------------------------------------------------------------------
                      (tiny_pug_with_jin):00016             ORG     $1000   ; VARS
                      (tiny_pug_with_jin):00017         ; -----------------------------------------------------------------------------
                      (tiny_pug_with_jin):00018         ; PROGRAM ENTRYPOINT
                      (tiny_pug_with_jin):00019         ; -----------------------------------------------------------------------------
1000                  (tiny_pug_with_jin):00020         ENTRYPOINT  
1000 BD102B           (tiny_pug_with_jin):00021             JSR  DRAW_STARTUP_IMAGE
1003 8600             (tiny_pug_with_jin):00022             LDA  #0
1005 B71193           (tiny_pug_with_jin):00023             STA  LASTVAL
1008 8E11C6           (tiny_pug_with_jin):00024             LDX  #FADEPALETTE
100B BF1191           (tiny_pug_with_jin):00025             STX  FADEPOS
100E BD10CA           (tiny_pug_with_jin):00026             JSR  PLAY_STARTUP_SOUND
1011 39               (tiny_pug_with_jin):00027             RTS
                      (tiny_pug_with_jin):00028         ; -----------------------------------------------------------------------------
                      (tiny_pug_with_jin):00029         ; SETS VDP COLOR PALETTE FROM U16 ARRAY AT X, COLOR COUNT IN E
                      (tiny_pug_with_jin):00030         ; -----------------------------------------------------------------------------
1012                  (tiny_pug_with_jin):00031         SET_PALETTE     
1012 8600             (tiny_pug_with_jin):00032             LDA  #0
1014 B7FFE5           (tiny_pug_with_jin):00033             STA  VREG
1017 8690             (tiny_pug_with_jin):00034             LDA  #$90
1019 B7FFE5           (tiny_pug_with_jin):00035             STA  VREG
101C                  (tiny_pug_with_jin):00036         PAL_LOOP     
101C A680             (tiny_pug_with_jin):00037             LDA  ,X+
101E B7FFE6           (tiny_pug_with_jin):00038             STA  VPAL
1021 A680             (tiny_pug_with_jin):00039             LDA  ,X+
1023 B7FFE6           (tiny_pug_with_jin):00040             STA  VPAL
1026 114A             (tiny_pug_with_jin):00041             DECE
1028 26F2             (tiny_pug_with_jin):00042             BNE  PAL_LOOP
102A 39               (tiny_pug_with_jin):00043             RTS    
                      (tiny_pug_with_jin):00044         ; -----------------------------------------------------------------------------
102B                  (tiny_pug_with_jin):00045         DRAW_STARTUP_IMAGE  
102B 8E1194           (tiny_pug_with_jin):00046             LDX  #VDP_G4_SEQ ; SET MODE GRAPHICS4
102E                  (tiny_pug_with_jin):00047         VDP_INIT    
102E A680             (tiny_pug_with_jin):00048             LDA  ,X+
1030 B7FFE5           (tiny_pug_with_jin):00049             STA  VREG
1033 8C11A6           (tiny_pug_with_jin):00050             CMPX #(VDP_G4_SEQ+VDP_G4_SZ)
1036 25F6             (tiny_pug_with_jin):00051             BLO  VDP_INIT
1038 8E11A6           (tiny_pug_with_jin):00052             LDX  #BLANKPALETTE   ; SET 16-COLOR PALETTE
103B 118610           (tiny_pug_with_jin):00053             LDE  #16
103E BD1012           (tiny_pug_with_jin):00054             JSR  SET_PALETTE
1041 8604             (tiny_pug_with_jin):00055             LDA  #4
1043 B71190           (tiny_pug_with_jin):00056             STA  OUTELEMS
1046 CE1206           (tiny_pug_with_jin):00057             LDU  #IMG       ; POINT X TO START OF RLE DATA
1049                  (tiny_pug_with_jin):00058         DRAWLOOP    
1049 A6C0             (tiny_pug_with_jin):00059             LDA  ,U+        ; GET NEXT BYTE OF RLE DATA
104B 2B35             (tiny_pug_with_jin):00060             BMI  U16ELEM    ; IF TOP BIT SET, NEED TO GET ANOTHER BYTE.
104D                  (tiny_pug_with_jin):00061         U8ELEM              ; THIS PIXEL RUN IS ENCODED IN ONE BYTE:
104D 1F89             (tiny_pug_with_jin):00062             TFR  A,B 
104F C403             (tiny_pug_with_jin):00063             ANDB #3
1051 F7118C           (tiny_pug_with_jin):00064             STB  PIXCOLR    ; PIXEL COLOR
1054 44               (tiny_pug_with_jin):00065             LSRA
1055 44               (tiny_pug_with_jin):00066             LSRA    
1056 4C               (tiny_pug_with_jin):00067             INCA
1057 B7118E           (tiny_pug_with_jin):00068             STA  PIXCNT+1   ; RUN LENGTH
105A                  (tiny_pug_with_jin):00069         DRAWPIXELS8  
105A F6118F           (tiny_pug_with_jin):00070             LDB  OUTBYTE
105D                  (tiny_pug_with_jin):00071         LOOPPIXELS8         ; SHIFT PIXEL INTO OUTPUT BYTE
105D 58               (tiny_pug_with_jin):00072             LSLB
105E 58               (tiny_pug_with_jin):00073             LSLB
105F FA118C           (tiny_pug_with_jin):00074             ORB  PIXCOLR
1062 7A1190           (tiny_pug_with_jin):00075             DEC  OUTELEMS
1065 260A             (tiny_pug_with_jin):00076             BNE  SKIPPLOT8
1067 F7FFE4           (tiny_pug_with_jin):00077             STB  VDAT       ; EVERY FOUR PIXELS, SEND BYTE THE VDP
106A 8604             (tiny_pug_with_jin):00078             LDA  #4
106C B71190           (tiny_pug_with_jin):00079             STA  OUTELEMS       
106F 2003             (tiny_pug_with_jin):00080             BRA  ELOOP8
1071                  (tiny_pug_with_jin):00081         SKIPPLOT8
1071 F7118F           (tiny_pug_with_jin):00082             STB  OUTBYTE
1074                  (tiny_pug_with_jin):00083         ELOOP8
1074 7A118E           (tiny_pug_with_jin):00084             DEC  PIXCNT+1   ; CHECK FOR END OF PIXEL RUN
1077 26E4             (tiny_pug_with_jin):00085             BNE  LOOPPIXELS8
1079 11831443         (tiny_pug_with_jin):00086             CMPU #ENDIMG    ; CHECK FOR END OF IMAGE
107D 26CA             (tiny_pug_with_jin):00087             BNE  DRAWLOOP
107F 7E10C4           (tiny_pug_with_jin):00088             JMP  DRAWING_DONE
1082                  (tiny_pug_with_jin):00089         U16ELEM             ; THIS PIXEL RUN IS ENCODED IN TWO BYTES:
1082 E6C0             (tiny_pug_with_jin):00090             LDB  ,U+  
1084 847F             (tiny_pug_with_jin):00091             ANDA #$7F
1086 1F06             (tiny_pug_with_jin):00092             TFR  D,W
1088 C403             (tiny_pug_with_jin):00093             ANDB #3
108A F7118C           (tiny_pug_with_jin):00094             STB  PIXCOLR    ; PIXEL COLOR
108D 1F60             (tiny_pug_with_jin):00095             TFR  W,D
108F 1044             (tiny_pug_with_jin):00096             LSRD
1091 1044             (tiny_pug_with_jin):00097             LSRD
1093 104C             (tiny_pug_with_jin):00098             INCD
1095 FD118D           (tiny_pug_with_jin):00099             STD  PIXCNT     ; RUN LENGTH   
1098                  (tiny_pug_with_jin):00100         DRAWPIXELS          ; SHIFT PIXEL INTO OUTPUT BYTE
1098 F6118F           (tiny_pug_with_jin):00101             LDB  OUTBYTE
109B                  (tiny_pug_with_jin):00102         LOOPPIXELS16
109B 58               (tiny_pug_with_jin):00103             LSLB
109C 58               (tiny_pug_with_jin):00104             LSLB
109D FA118C           (tiny_pug_with_jin):00105             ORB  PIXCOLR
10A0 7A1190           (tiny_pug_with_jin):00106             DEC  OUTELEMS
10A3 260A             (tiny_pug_with_jin):00107             BNE  SKIPPLOT
10A5 F7FFE4           (tiny_pug_with_jin):00108             STB  VDAT       ; EVERY FOUR PIXELS, SEND BYTE THE VDP
10A8 8604             (tiny_pug_with_jin):00109             LDA  #4
10AA B71190           (tiny_pug_with_jin):00110             STA  OUTELEMS       
10AD 2003             (tiny_pug_with_jin):00111             BRA  ELOOP
10AF                  (tiny_pug_with_jin):00112         SKIPPLOT
10AF F7118F           (tiny_pug_with_jin):00113             STB  OUTBYTE
10B2                  (tiny_pug_with_jin):00114         ELOOP
10B2 10B6118D         (tiny_pug_with_jin):00115             LDW  PIXCNT
10B6 105A             (tiny_pug_with_jin):00116             DECW
10B8 10B7118D         (tiny_pug_with_jin):00117             STW  PIXCNT     ; CHECK FOR END OF PIXEL RUN
10BC 26DD             (tiny_pug_with_jin):00118             BNE  LOOPPIXELS16
10BE 11831443         (tiny_pug_with_jin):00119             CMPU #ENDIMG    ; CHECK FOR END OF IMAGE
10C2 2685             (tiny_pug_with_jin):00120             BNE DRAWLOOP
10C4                  (tiny_pug_with_jin):00121         DRAWING_DONE:
10C4 C600             (tiny_pug_with_jin):00122             LDB  #0
10C6 F7FFE4           (tiny_pug_with_jin):00123             STB  VDAT       ; PLOT THAT LAST PIXEL
10C9 39               (tiny_pug_with_jin):00124             RTS             ; IMAGE DONE.
                      (tiny_pug_with_jin):00125         ; -----------------------------------------------------------------------------
                      (tiny_pug_with_jin):00126         ; PLAY STARTUP SOUND USING THE YAMAHA YMF262M (OPL3) MUSIC SYNTHESIZER
                      (tiny_pug_with_jin):00127         ; -----------------------------------------------------------------------------
10CA                  (tiny_pug_with_jin):00128         PLAY_STARTUP_SOUND   
10CA 8E1443           (tiny_pug_with_jin):00129             LDX  #SONG
10CD                  (tiny_pug_with_jin):00130         SONGLOOP
10CD A680             (tiny_pug_with_jin):00131             LDA  ,X+
10CF 815A             (tiny_pug_with_jin):00132             CMPA #$5A
10D1 2721             (tiny_pug_with_jin):00133             BEQ  WR_BANK0
10D3 815F             (tiny_pug_with_jin):00134             CMPA #$5F
10D5 2710             (tiny_pug_with_jin):00135             BEQ  WR_BANK1
10D7 8161             (tiny_pug_with_jin):00136             CMPA #$61
10D9 2703             (tiny_pug_with_jin):00137             BEQ  DLY_VAR0
10DB 7E10FE           (tiny_pug_with_jin):00138             JMP  LOOPEND                             
10DE                  (tiny_pug_with_jin):00139         DLY_VAR0
10DE 10AE81           (tiny_pug_with_jin):00140             LDY  ,X++
10E1 BD1163           (tiny_pug_with_jin):00141             JSR  DELAY
10E4 7E10FE           (tiny_pug_with_jin):00142             JMP  LOOPEND
10E7                  (tiny_pug_with_jin):00143         WR_BANK1
10E7 A680             (tiny_pug_with_jin):00144             LDA  ,X+
10E9 E680             (tiny_pug_with_jin):00145             LDB  ,X+
10EB 118601           (tiny_pug_with_jin):00146             LDE  #1
10EE BD1146           (tiny_pug_with_jin):00147             JSR  OPL_WRITE
10F1 7E10FE           (tiny_pug_with_jin):00148             JMP  LOOPEND
10F4                  (tiny_pug_with_jin):00149         WR_BANK0
10F4 A680             (tiny_pug_with_jin):00150             LDA  ,X+
10F6 E680             (tiny_pug_with_jin):00151             LDB  ,X+
10F8 118600           (tiny_pug_with_jin):00152             LDE  #0
10FB BD1146           (tiny_pug_with_jin):00153             JSR  OPL_WRITE
10FE                  (tiny_pug_with_jin):00154         LOOPEND
10FE BDFEA3           (tiny_pug_with_jin):00155             JSR  BF_UT_GETC
1101 811B             (tiny_pug_with_jin):00156             CMPA #$1B
1103 2722             (tiny_pug_with_jin):00157             BEQ  ENDLOOP
1105 1F10             (tiny_pug_with_jin):00158             TFR  X,D
1107 1044             (tiny_pug_with_jin):00159             LSRD
1109 1044             (tiny_pug_with_jin):00160             LSRD
110B 1044             (tiny_pug_with_jin):00161             LSRD
110D 1044             (tiny_pug_with_jin):00162             LSRD
110F 1044             (tiny_pug_with_jin):00163             LSRD
1111 1044             (tiny_pug_with_jin):00164             LSRD  
1113 1044             (tiny_pug_with_jin):00165             LSRD  
1115 F11193           (tiny_pug_with_jin):00166             CMPB LASTVAL 
1118 2706             (tiny_pug_with_jin):00167             BEQ  SKIPFADE
111A F71193           (tiny_pug_with_jin):00168             STB  LASTVAL
111D BD116D           (tiny_pug_with_jin):00169             JSR DOFADE
1120                  (tiny_pug_with_jin):00170         SKIPFADE
1120 8C19F2           (tiny_pug_with_jin):00171             CMPX #ENDSONG
1123 1026FFA6         (tiny_pug_with_jin):00172             LBNE SONGLOOP
1127                  (tiny_pug_with_jin):00173         ENDLOOP     
1127 BD112B           (tiny_pug_with_jin):00174             JSR  OPL_RESET
112A 39               (tiny_pug_with_jin):00175             RTS             ; ALL DONE.
                      (tiny_pug_with_jin):00176         ; -----------------------------------------------------------------------------
112B                  (tiny_pug_with_jin):00177         OPL_RESET:
112B 118600           (tiny_pug_with_jin):00178             LDE  #0
112E 8600             (tiny_pug_with_jin):00179             LDA  #0
1130 C600             (tiny_pug_with_jin):00180             LDB  #0
1132 BD1146           (tiny_pug_with_jin):00181         L0  JSR  OPL_WRITE
1135 4C               (tiny_pug_with_jin):00182             INCA  
1136 26FA             (tiny_pug_with_jin):00183             BNE  L0
1138 118601           (tiny_pug_with_jin):00184             LDE  #1
113B 8600             (tiny_pug_with_jin):00185             LDA  #0
113D C600             (tiny_pug_with_jin):00186             LDB  #0
113F BD1146           (tiny_pug_with_jin):00187         L1  JSR  OPL_WRITE
1142 4C               (tiny_pug_with_jin):00188             INCA  
1143 26FA             (tiny_pug_with_jin):00189             BNE  L1
1145 39               (tiny_pug_with_jin):00190             RTS
                      (tiny_pug_with_jin):00191         ; -----------------------------------------------------------------------------
                      (tiny_pug_with_jin):00192         ; POKES SPECIFIED VALUE INTO SPECIFIED REGISTER OF SOUNDCHIP (YMF-262M)
                      (tiny_pug_with_jin):00193         ; A = REG NUM, B = VALUE, E = OPL3 BANK NUMBER (0,1)           
                      (tiny_pug_with_jin):00194         ; -----------------------------------------------------------------------------
1146                  (tiny_pug_with_jin):00195         OPL_WRITE
1146 118100           (tiny_pug_with_jin):00196             CMPE #00
1149 270C             (tiny_pug_with_jin):00197             BEQ  BANK0
114B                  (tiny_pug_with_jin):00198         BANK1
114B B7FFE2           (tiny_pug_with_jin):00199             STA  OPL3_BASE+2
114E 12               (tiny_pug_with_jin):00200             NOP
114F 12               (tiny_pug_with_jin):00201             NOP
1150 12               (tiny_pug_with_jin):00202             NOP
1151 F7FFE3           (tiny_pug_with_jin):00203             STB  OPL3_BASE+3
1154 12               (tiny_pug_with_jin):00204             NOP
1155 12               (tiny_pug_with_jin):00205             NOP
1156 39               (tiny_pug_with_jin):00206             RTS
1157                  (tiny_pug_with_jin):00207         BANK0
1157 B7FFE0           (tiny_pug_with_jin):00208             STA  OPL3_BASE+0
115A 12               (tiny_pug_with_jin):00209             NOP
115B 12               (tiny_pug_with_jin):00210             NOP
115C 12               (tiny_pug_with_jin):00211             NOP
115D F7FFE1           (tiny_pug_with_jin):00212             STB  OPL3_BASE+1
1160 12               (tiny_pug_with_jin):00213             NOP
1161 12               (tiny_pug_with_jin):00214             NOP
