                      (benchmark_itoa64_):00001         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00002         ;
                      (benchmark_itoa64_):00003         ; ITOA64_ITOA64 - 64-BIT SIGNED INTEGER <--> DECOMAL STRING - EXPERIMENTS
                      (benchmark_itoa64_):00004         ;
                      (benchmark_itoa64_):00005         ; THESE ARE FAIRLY NAIVE 6309 IMPLEMENTATIONS OF ITOA AND ATOI FOR 64-BIT INTS
                      (benchmark_itoa64_):00006         ;
                      (benchmark_itoa64_):00007         ; A TIMED TEST HARNESS IS INCLUDED, WHICH GETS THE START AND END TIMES OF 
                      (benchmark_itoa64_):00008         ; THE TEST RUNS USING THE PUGPUTER 6309'S INTERRUPT-BASED 16HZ TICK COUNTER,
                      (benchmark_itoa64_):00009         ; AND CONVERTING 2000 INT64'S TO STRINGS AND BACK, WITH VERIFICATION.
                      (benchmark_itoa64_):00010         ;
                      (benchmark_itoa64_):00011         ; IN 6309 NATIVE MODE, WITH A BUS CLOCK OF 3.58MHZ, 
                      (benchmark_itoa64_):00012         ; THIS TEST CURRENTLY TAKES 223 TICKS (13.9 SECS)
                      (benchmark_itoa64_):00013         ; 
                      (benchmark_itoa64_):00014         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00015             INCLUDE bios_func_tab.d     ; BIOS functions jump table
                      (  bios_func_tab.d):00001         ;------------------------------------------------------------------------------
                      (  bios_func_tab.d):00002         ; BIOS BIOS FUNCTION JUMP TABLE ADDRESSES
                      (  bios_func_tab.d):00003         ;------------------------------------------------------------------------------
     FEA0             (  bios_func_tab.d):00004         FUNC_BASE       EQU  $FEA0          ; SEE 6309/BOOT/MAIN.ASM FOR DEFS
                      (  bios_func_tab.d):00005         ;------------------------------------------------------------------------------
     FEA0             (  bios_func_tab.d):00006         BF_V_RESET      EQU  FUNC_BASE+0
     FEA3             (  bios_func_tab.d):00007         BF_UT_GETC      EQU  FUNC_BASE+3
     FEA6             (  bios_func_tab.d):00008         BF_UT_GETS      EQU  FUNC_BASE+6
     FEA9             (  bios_func_tab.d):00009         BF_UT_PUTC      EQU  FUNC_BASE+9    ;
     FEAC             (  bios_func_tab.d):00010         BF_UT_PUTS      EQU  FUNC_BASE+12
     FEAF             (  bios_func_tab.d):00011         BF_UT_WAITTX    EQU  FUNC_BASE+15
     FEB2             (  bios_func_tab.d):00012         BF_UT_CLRSCR    EQU  FUNC_BASE+18
     FEB5             (  bios_func_tab.d):00013         BF_S_HEXA       EQU  FUNC_BASE+21   ; CONVERT REG A TO HEX OCTET AT X, X+=2
     FEB8             (  bios_func_tab.d):00014         BF_S_EOL        EQU  FUNC_BASE+24   ; PUT CR, LF, $00 AT X, X+=3
     FEBB             (  bios_func_tab.d):00015         BF_S_LEN        EQU  FUNC_BASE+27   ; PUT LEN OF STRING AT X INTO REG B
     FEBE             (  bios_func_tab.d):00016         BF_S_CPY        EQU  FUNC_BASE+30   ; COPY STRING AT Y TO MEM AT X. X+=?
     FEC1             (  bios_func_tab.d):00017         BF_RTC_GETTIX   EQU  FUNC_BASE+33   ; GET CURRENT SYSTEM TICKS TO I64 AT X.
     FEC4             (  bios_func_tab.d):00018         BF_S_TOUPPER    EQU  FUNC_BASE+36   ; MAKE A UPPERCASE IF IT IS LOWERCASE
     FEC7             (  bios_func_tab.d):00019         BF_S_INTD       EQU  FUNC_BASE+39   ; CONVERT REG D TO STRING AT X, X+=?
     FECA             (  bios_func_tab.d):00020         BF_RTC_SETTIX   EQU  FUNC_BASE+42   ; SET CURRENT SYSTEM TICKS FROM I64 AT X.
                      (  bios_func_tab.d):00021         ;------------------------------------------------------------------------------
                      (  bios_func_tab.d):00022         ; EOF
                      (  bios_func_tab.d):00023         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00016         ;------------------------------------------------------------------------------
     000A             (benchmark_itoa64_):00017         LF  EQU  $0A        ; LINE FEED
     000D             (benchmark_itoa64_):00018         CR  EQU  $0D        ; CARRIAGE RETURN
     0000             (benchmark_itoa64_):00019         NUL EQU  $00
     001B             (benchmark_itoa64_):00020         ESC EQU  $1B
                      (benchmark_itoa64_):00021         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00022         ; ENTRYPOINT
                      (benchmark_itoa64_):00023         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00024             ORG $1000
                      (benchmark_itoa64_):00025         ;------------------------------------------------------------------------------
1000                  (benchmark_itoa64_):00026         START:
                      (benchmark_itoa64_):00027             ;JSR  TICKSLOOP    
1000 BD1086           (benchmark_itoa64_):00028             JSR TEST
1003 39               (benchmark_itoa64_):00029             RTS
                      (benchmark_itoa64_):00030         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00031         ; CONSTS
                      (benchmark_itoa64_):00032         ;------------------------------------------------------------------------------
1004 0A0D             (benchmark_itoa64_):00033         MSG_START   FCB  LF,CR
1006 52554E4E494E4720 (benchmark_itoa64_):00034                     FCC  "RUNNING BENCHMARK ITOA64 <-> ATOI64... "
     42454E43484D4152
     4B2049544F413634
     203C2D3E2041544F
     4936342E2E2E20
102D 00               (benchmark_itoa64_):00035                     FCB  0
102E 444F4E452E2028   (benchmark_itoa64_):00036         MSG_TOOK    FCC  "DONE. ("
1035 00               (benchmark_itoa64_):00037                     FCB  0
1036 205449434B5329   (benchmark_itoa64_):00038         MSG_END     FCC  " TICKS)"
103D 0A0D0A0D00       (benchmark_itoa64_):00039         MSG_CR      FCB  LF,CR,LF,CR,0
                      (benchmark_itoa64_):00040         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00041         ; VARS
                      (benchmark_itoa64_):00042         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00043         ; USED BY TESTS
1042                  (benchmark_itoa64_):00044         SERBUF      RMB 32
1062                  (benchmark_itoa64_):00045         STARTTICKS  RMB 8
106A                  (benchmark_itoa64_):00046         ENDTICKS    RMB 8
                      (benchmark_itoa64_):00047         ; USED BY ITOA64, ATOI64
1072                  (benchmark_itoa64_):00048         I64         RMB 8       ; WORKING VALUE
107A                  (benchmark_itoa64_):00049         STASHED_I64 RMB 8
1082                  (benchmark_itoa64_):00050         DIGIT       RMB 1       ; WORKING DIGIT
1083                  (benchmark_itoa64_):00051         NDIGITS     RMB 1
1084                  (benchmark_itoa64_):00052         LEADZ       RMB 1       ; 1:IGNORING LEADING ZEROES
1085                  (benchmark_itoa64_):00053         ISNEG       RMB 1       ; 1:NEGATIVE NUM
                      (benchmark_itoa64_):00054         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00055         ; TEST - TIMES 2000 CONVERSIONS FROM INT64 TO TO DECIMAL STRING AND BACK, WHILE
                      (benchmark_itoa64_):00056         ; VERIFYING THE RESULTS.
                      (benchmark_itoa64_):00057         ;------------------------------------------------------------------------------
1086                  (benchmark_itoa64_):00058         TEST:
1086 108E1004         (benchmark_itoa64_):00059             LDY  #MSG_START
108A BDFEAC           (benchmark_itoa64_):00060             JSR  BF_UT_PUTS
108D BDFEAF           (benchmark_itoa64_):00061             JSR  BF_UT_WAITTX
1090 8E1062           (benchmark_itoa64_):00062             LDX  #STARTTICKS    ; GET STARTING SYS TICK COUNT (U64 16THS OF SECONDS)
1093 BDFEC1           (benchmark_itoa64_):00063             JSR  BF_RTC_GETTIX  
1096 8E1427           (benchmark_itoa64_):00064             LDX  #TEST_VECTORS
1099                  (benchmark_itoa64_):00065         TESTLOOP:
1099 10EC00           (benchmark_itoa64_):00066             LDQ  0,X            ; STASH THE ORIGINAL I64 VALUE FOR LATER VERIFICATION.
109C 10FD107A         (benchmark_itoa64_):00067             STQ  STASHED_I64+0
10A0 10EC04           (benchmark_itoa64_):00068             LDQ  4,X
10A3 10FD107E         (benchmark_itoa64_):00069             STQ  STASHED_I64+4
10A7 108E1042         (benchmark_itoa64_):00070             LDY  #SERBUF
10AB BD132E           (benchmark_itoa64_):00071             JSR  ITOA64         ; CONVERT I64 TO STRING,
                      (benchmark_itoa64_):00072             ;JSR  PRINTY         ; SHOW STRING RESULT
10AE 3410             (benchmark_itoa64_):00073             PSHS X
10B0 8E1072           (benchmark_itoa64_):00074             LDX  #I64
10B3 108E1042         (benchmark_itoa64_):00075             LDY  #SERBUF        ; CONVERT STRING BACK TO I64,
10B7 BD139B           (benchmark_itoa64_):00076             JSR  ATOI64    
                      (benchmark_itoa64_):00077             ;JSR  PRINT_U64X     ; SHOW BINARY RESULT
10BA 8E1072           (benchmark_itoa64_):00078             LDX  #I64           ; COMPARE RESULT WITH STASHED ORIGINAL
10BD CE107A           (benchmark_itoa64_):00079             LDU  #STASHED_I64
10C0 BD11E1           (benchmark_itoa64_):00080             JSR  CMP64_XU
10C3 270C             (benchmark_itoa64_):00081             BEQ  MATCHED
10C5                  (benchmark_itoa64_):00082         MISMATCH
10C5 8E107A           (benchmark_itoa64_):00083             LDX  #STASHED_I64
10C8 BD1145           (benchmark_itoa64_):00084             JSR  PRINT_U64X
10CB 8E1072           (benchmark_itoa64_):00085             LDX  #I64
10CE BD1145           (benchmark_itoa64_):00086             JSR  PRINT_U64X
10D1                  (benchmark_itoa64_):00087         MATCHED
10D1 3510             (benchmark_itoa64_):00088             PULS X
10D3 8C52A7           (benchmark_itoa64_):00089             CMPX #END_TEST_VECTORS
10D6 26C1             (benchmark_itoa64_):00090             BNE  TESTLOOP       ; IF HAVE MORE VALUES TO TEST, KEEP LOOPING,
10D8 8E106A           (benchmark_itoa64_):00091             LDX  #ENDTICKS      ; ELSE GET ENDING SYS TICKCOUNT,
10DB BDFEC1           (benchmark_itoa64_):00092             JSR  BF_RTC_GETTIX
10DE 8E106A           (benchmark_itoa64_):00093             LDX  #ENDTICKS
10E1 CE1062           (benchmark_itoa64_):00094             LDU  #STARTTICKS    ; CALC ELAPSED TICKS,
10E4 BD11C5           (benchmark_itoa64_):00095             JSR  SUB64_XU
10E7 108E102E         (benchmark_itoa64_):00096             LDY  #MSG_TOOK
10EB BDFEAC           (benchmark_itoa64_):00097             JSR  BF_UT_PUTS
10EE 108E1042         (benchmark_itoa64_):00098             LDY  #SERBUF        ; SHOW TEST DURATION IN TICKS,
10F2 BD132E           (benchmark_itoa64_):00099             JSR  ITOA64
10F5 108E1042         (benchmark_itoa64_):00100             LDY  #SERBUF
10F9 BDFEAC           (benchmark_itoa64_):00101             JSR  BF_UT_PUTS
10FC 108E1036         (benchmark_itoa64_):00102             LDY  #MSG_END
1100 BDFEAC           (benchmark_itoa64_):00103             JSR  BF_UT_PUTS
1103 BDFEAF           (benchmark_itoa64_):00104             JSR  BF_UT_WAITTX
1106 39               (benchmark_itoa64_):00105             RTS                 ; RETURN TO CALLER
                      (benchmark_itoa64_):00106         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00107         ; SHOW SYS TICKCOUNT AS DECIMAL UNTIL ESC PRESSED.
                      (benchmark_itoa64_):00108         ;------------------------------------------------------------------------------
1107                  (benchmark_itoa64_):00109         TICKSLOOP:
1107 BDFEA3           (benchmark_itoa64_):00110             JSR  BF_UT_GETC ; QUIT LOOP IF ESC RECEIVED
110A 811B             (benchmark_itoa64_):00111             CMPA #ESC
110C 271F             (benchmark_itoa64_):00112             BEQ  ELOOP
110E 8E106A           (benchmark_itoa64_):00113             LDX  #ENDTICKS
1111 BDFEC1           (benchmark_itoa64_):00114             JSR  BF_RTC_GETTIX ; GET LATEST TICKCOUNT.
1114 A61F             (benchmark_itoa64_):00115             LDA  -1,X       ; NOTE LOWEST BYTE OF IT, AND
1116 B11062           (benchmark_itoa64_):00116             CMPA STARTTICKS ; IF TICKCOUNT HASNT CHANGED,
1119 27EC             (benchmark_itoa64_):00117             BEQ  TICKSLOOP  ; TRY AGAIN. ELSE,
111B B71062           (benchmark_itoa64_):00118             STA  STARTTICKS ; STORE LSB OF NEW TICKCOUNT, 
111E 8E106A           (benchmark_itoa64_):00119             LDX  #ENDTICKS
1121 108E1042         (benchmark_itoa64_):00120             LDY  #SERBUF
1125 BD132E           (benchmark_itoa64_):00121             JSR  ITOA64     ; AND PRINT NEW TICKCOUNT.
1128 BD112E           (benchmark_itoa64_):00122             JSR  PRINTY
112B 20DA             (benchmark_itoa64_):00123             BRA  TICKSLOOP
112D                  (benchmark_itoa64_):00124         ELOOP:
112D 39               (benchmark_itoa64_):00125             RTS    
                      (benchmark_itoa64_):00126         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00127         ; PRINT STRING AT Y + CR/LF+NULL
                      (benchmark_itoa64_):00128         ;------------------------------------------------------------------------------
112E                  (benchmark_itoa64_):00129         PRINTY:
112E 860A             (benchmark_itoa64_):00130             LDA  #LF
1130 A7A0             (benchmark_itoa64_):00131             STA  ,Y+
1132 860D             (benchmark_itoa64_):00132             LDA  #CR
1134 A7A0             (benchmark_itoa64_):00133             STA  ,Y+
1136 8600             (benchmark_itoa64_):00134             LDA  #NUL
1138 A7A0             (benchmark_itoa64_):00135             STA  ,Y+
113A 108E1042         (benchmark_itoa64_):00136             LDY  #SERBUF
113E BDFEAC           (benchmark_itoa64_):00137             JSR  BF_UT_PUTS
1141 BDFEAF           (benchmark_itoa64_):00138             JSR  BF_UT_WAITTX
1144 39               (benchmark_itoa64_):00139             RTS
                      (benchmark_itoa64_):00140         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00141         ; PRINT I64 AT X AS HEX + CR/LF+NULL
                      (benchmark_itoa64_):00142         ;------------------------------------------------------------------------------
1145                  (benchmark_itoa64_):00143         PRINT_U64X:
1145 108E1042         (benchmark_itoa64_):00144             LDY  #SERBUF
1149 A600             (benchmark_itoa64_):00145             LDA  0,X
114B BD1188           (benchmark_itoa64_):00146             JSR  S_HEXY
114E A601             (benchmark_itoa64_):00147             LDA  1,X
1150 BD1188           (benchmark_itoa64_):00148             JSR  S_HEXY
1153 A602             (benchmark_itoa64_):00149             LDA  2,X
1155 BD1188           (benchmark_itoa64_):00150             JSR  S_HEXY
1158 A603             (benchmark_itoa64_):00151             LDA  3,X
115A BD1188           (benchmark_itoa64_):00152             JSR  S_HEXY
115D A604             (benchmark_itoa64_):00153             LDA  4,X
115F BD1188           (benchmark_itoa64_):00154             JSR  S_HEXY
1162 A605             (benchmark_itoa64_):00155             LDA  5,X
1164 BD1188           (benchmark_itoa64_):00156             JSR  S_HEXY
1167 A606             (benchmark_itoa64_):00157             LDA  6,X
1169 BD1188           (benchmark_itoa64_):00158             JSR  S_HEXY
116C A607             (benchmark_itoa64_):00159             LDA  7,X
116E BD1188           (benchmark_itoa64_):00160             JSR  S_HEXY
1171 860A             (benchmark_itoa64_):00161             LDA  #LF
1173 A7A0             (benchmark_itoa64_):00162             STA  ,Y+
1175 860D             (benchmark_itoa64_):00163             LDA  #CR
1177 A7A0             (benchmark_itoa64_):00164             STA  ,Y+
1179 8600             (benchmark_itoa64_):00165             LDA  #NUL
117B A7A0             (benchmark_itoa64_):00166             STA  ,Y+
117D 108E1042         (benchmark_itoa64_):00167             LDY  #SERBUF
1181 BDFEAC           (benchmark_itoa64_):00168             JSR  BF_UT_PUTS
1184 BDFEAF           (benchmark_itoa64_):00169             JSR  BF_UT_WAITTX
1187 39               (benchmark_itoa64_):00170             RTS
                      (benchmark_itoa64_):00171         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00172         ; CONVERTS VAL IN A TO HEX STRING AT Y. 
                      (benchmark_itoa64_):00173         ; DOES INCREMENT Y, BUT DOESN'T NULL-TERMINATE STRING.
                      (benchmark_itoa64_):00174         ;------------------------------------------------------------------------------
1188                  (benchmark_itoa64_):00175         S_HEXY:
1188 1F89             (benchmark_itoa64_):00176             TFR  A,B        ; SAVE ORIGINAL BINARY VALUE
118A 44               (benchmark_itoa64_):00177             LSRA            ; MOVE HIGH DIGIT TO LOW DIGIT
118B 44               (benchmark_itoa64_):00178             LSRA
118C 44               (benchmark_itoa64_):00179             LSRA
118D 44               (benchmark_itoa64_):00180             LSRA
118E 8109             (benchmark_itoa64_):00181             CMPA #9
1190 2302             (benchmark_itoa64_):00182             BLS  AD30       ; BRANCH IF HIGH DIGIT IS DECIMAL
1192 8B07             (benchmark_itoa64_):00183             ADDA #7         ; ELSE ADD 7 SO AFTER ADDING 'O' THE
                      (benchmark_itoa64_):00184                             ; CHARACTER WILL BE IN ‘'A'..'F'
1194                  (benchmark_itoa64_):00185         AD30:
1194 8B30             (benchmark_itoa64_):00186             ADDA #'0        ; ADD ASCII O TO MAKE A CHARACTER
1196 C40F             (benchmark_itoa64_):00187             ANDB #$0F       ; MASK OFF LOW DIGIT
1198 C109             (benchmark_itoa64_):00188             CMPB #9
119A 2302             (benchmark_itoa64_):00189             BLS AD3OLD      ; BRANCH IF LOW DIGIT IS DECIMAL
119C CB07             (benchmark_itoa64_):00190             ADDB #7         ; ELSE ADD 7 SO AFTER ADDING 'O! THE
                      (benchmark_itoa64_):00191                             ; CHARACTER WILL BE IN '‘A'..'F!
119E                  (benchmark_itoa64_):00192         AD3OLD:     
119E CB30             (benchmark_itoa64_):00193             ADDB #'0        ; ADD ASCII O TO MAKE A CHARACTER
11A0 A7A0             (benchmark_itoa64_):00194             STA ,Y+         ; INSERT HEX BYTES INTO DEST STRING AT X
11A2 E7A0             (benchmark_itoa64_):00195             STB ,Y+         ; AND NCREMENT X
11A4 39               (benchmark_itoa64_):00196             RTS 
                      (benchmark_itoa64_):00197         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00198         ; GIVEN AN I64 AT X, NEGATE IT IN PLACE BY SUBTRACTING IT FROM ZERO.
                      (benchmark_itoa64_):00199         ;------------------------------------------------------------------------------
11A5                  (benchmark_itoa64_):00200         NEGATE64:
11A5 CC0000           (benchmark_itoa64_):00201             LDD  #0
11A8 A306             (benchmark_itoa64_):00202             SUBD 6,X
11AA ED06             (benchmark_itoa64_):00203             STD  6,X
11AC CC0000           (benchmark_itoa64_):00204             LDD  #0
11AF 10A204           (benchmark_itoa64_):00205             SBCD 4,X
11B2 ED04             (benchmark_itoa64_):00206             STD  4,X
11B4 CC0000           (benchmark_itoa64_):00207             LDD  #0
11B7 10A202           (benchmark_itoa64_):00208             SBCD 2,X
11BA ED02             (benchmark_itoa64_):00209             STD  2,X
11BC CC0000           (benchmark_itoa64_):00210             LDD  #0
11BF 10A200           (benchmark_itoa64_):00211             SBCD 0,X
11C2 ED00             (benchmark_itoa64_):00212             STD  0,X
11C4 39               (benchmark_itoa64_):00213             RTS
                      (benchmark_itoa64_):00214         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00215         ; GIVEN I64'S AT X AND U, SUBTRACT U FROM X, LEAVING RESULT IN X.
                      (benchmark_itoa64_):00216         ;------------------------------------------------------------------------------
11C5                  (benchmark_itoa64_):00217         SUB64_XU:
11C5 EC06             (benchmark_itoa64_):00218             LDD  6,X
11C7 A346             (benchmark_itoa64_):00219             SUBD 6,U
11C9 ED06             (benchmark_itoa64_):00220             STD  6,X
11CB EC04             (benchmark_itoa64_):00221             LDD  4,X
11CD 10A244           (benchmark_itoa64_):00222             SBCD 4,U
11D0 ED04             (benchmark_itoa64_):00223             STD  4,X
11D2 EC02             (benchmark_itoa64_):00224             LDD  2,X
11D4 10A242           (benchmark_itoa64_):00225             SBCD 2,U
11D7 ED02             (benchmark_itoa64_):00226             STD  2,X
11D9 EC00             (benchmark_itoa64_):00227             LDD  0,X
11DB 10A240           (benchmark_itoa64_):00228             SBCD 0,U
11DE ED00             (benchmark_itoa64_):00229             STD  0,X
11E0 39               (benchmark_itoa64_):00230             RTS
                      (benchmark_itoa64_):00231         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00232         ; GIVEN I64'S AT X AND U, COMPARE X TO U.
                      (benchmark_itoa64_):00233         ;------------------------------------------------------------------------------
11E1                  (benchmark_itoa64_):00234         CMP64_XU:
11E1 1C7E             (benchmark_itoa64_):00235             ANDCC #$7E          ; CLEAR CARRY
11E3 EC00             (benchmark_itoa64_):00236             LDD  0,X
11E5 10A340           (benchmark_itoa64_):00237             CMPD 0,U
11E8 2613             (benchmark_itoa64_):00238             BNE  DONECMP64
11EA EC02             (benchmark_itoa64_):00239             LDD  2,X
11EC 10A342           (benchmark_itoa64_):00240             CMPD 2,U
11EF 260C             (benchmark_itoa64_):00241             BNE  DONECMP64
11F1 EC04             (benchmark_itoa64_):00242             LDD  4,X
11F3 10A344           (benchmark_itoa64_):00243             CMPD 4,U
11F6 2605             (benchmark_itoa64_):00244             BNE  DONECMP64
11F8 EC06             (benchmark_itoa64_):00245             LDD  6,X
11FA 10A346           (benchmark_itoa64_):00246             CMPD 6,U
11FD                  (benchmark_itoa64_):00247         DONECMP64:
11FD 39               (benchmark_itoa64_):00248             RTS      
                      (benchmark_itoa64_):00249         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00250         ; I64 POWERS OF 10, STARTING WITH 10^18
                      (benchmark_itoa64_):00251         ;------------------------------------------------------------------------------
11FE                  (benchmark_itoa64_):00252         POWERS:
11FE 0DE0B6B3A7640000 (benchmark_itoa64_):00253             FQB $0DE0B6B3,$A7640000     ; 1000000000000000000
1206 016345785D8A0000 (benchmark_itoa64_):00254             FQB $01634578,$5D8A0000     ; 100000000000000000
120E 002386F26FC10000 (benchmark_itoa64_):00255             FQB $002386F2,$6FC10000     ; 10000000000000000
1216 00038D7EA4C68000 (benchmark_itoa64_):00256             FQB $00038D7E,$A4C68000     ; 1000000000000000
121E 00005AF3107A4000 (benchmark_itoa64_):00257             FQB $00005AF3,$107A4000     ; 100000000000000
1226 000009184E72A000 (benchmark_itoa64_):00258             FQB $00000918,$4E72A000     ; 10000000000000
122E 000000E8D4A51000 (benchmark_itoa64_):00259             FQB $000000E8,$D4A51000     ; 1000000000000
1236 000000174876E800 (benchmark_itoa64_):00260             FQB $00000017,$4876E800     ; 100000000000
