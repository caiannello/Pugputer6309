                      (benchmark_itoa64_):00292         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00293         ; GIVEN AN I64 AT X, OUTPUTS IT AS A NULL-TERMINATED DECIMAL STRING AT Y.
                      (benchmark_itoa64_):00294         ; ON RETURN, X WILL BE PAST THE 8-BYTE INPUT, AND Y WILL POINT AT THE STR NULL.
                      (benchmark_itoa64_):00295         ;------------------------------------------------------------------------------
132E                  (benchmark_itoa64_):00296         ITOA64:
132E 10EC81           (benchmark_itoa64_):00297             LDQ  ,X++          ; STASH I64 INPUT VALUE AT X TO TEMP WORKING VAR
1331 3002             (benchmark_itoa64_):00298             LEAX 2,X
1333 10FD1072         (benchmark_itoa64_):00299             STQ  I64+0
1337 10EC81           (benchmark_itoa64_):00300             LDQ  ,X++
133A 3002             (benchmark_itoa64_):00301             LEAX 2,X
133C 10FD1076         (benchmark_itoa64_):00302             STQ  I64+4
1340 3410             (benchmark_itoa64_):00303             PSHS X
1342 B61072           (benchmark_itoa64_):00304             LDA  I64
1345 8480             (benchmark_itoa64_):00305             ANDA #$80
1347 270A             (benchmark_itoa64_):00306             BEQ  DIDNEG
1349 8E1072           (benchmark_itoa64_):00307             LDX  #I64           ; IF I64 IS NEGATIVE, NEGATE IT,
134C BD11A5           (benchmark_itoa64_):00308             JSR  NEGATE64
134F 862D             (benchmark_itoa64_):00309             LDA  #'-'           ; AND OUTPUT A MINUS SIGN.
1351 A7A0             (benchmark_itoa64_):00310             STA  ,Y+
1353                  (benchmark_itoa64_):00311         DIDNEG:
1353 8E1072           (benchmark_itoa64_):00312             LDX  #I64           ; X AT TMP64
1356 CE11FE           (benchmark_itoa64_):00313             LDU  #POWERS        ; U AT POWERS TABLE
1359 8601             (benchmark_itoa64_):00314             LDA  #1
135B B71084           (benchmark_itoa64_):00315             STA  LEADZ          ; IGNORING LEADING ZEROES
135E                  (benchmark_itoa64_):00316         IT64_LOOP:              ; FOR EACH POWER OF TEN (EACH DIGIT)
135E 8630             (benchmark_itoa64_):00317             LDA  #'0'
1360 B71082           (benchmark_itoa64_):00318             STA  DIGIT
1363                  (benchmark_itoa64_):00319         IT64_ILOOP:             ; CALCULATE A DIGIT
1363 BD11E1           (benchmark_itoa64_):00320             JSR  CMP64_XU       ; WHILE TMP64 >= POWER:
1366 2508             (benchmark_itoa64_):00321             BLO  DONE_ILOOP
1368 7C1082           (benchmark_itoa64_):00322             INC  DIGIT          ;     DIGIT++
136B BD11C5           (benchmark_itoa64_):00323             JSR  SUB64_XU       ;     TMP64 -= POWER
136E 20F3             (benchmark_itoa64_):00324             BRA  IT64_ILOOP
1370                  (benchmark_itoa64_):00325         DONE_ILOOP:
1370 B61084           (benchmark_itoa64_):00326             LDA  LEADZ          ; IF NOT IGNORING LEADING ZEROES,
1373 2712             (benchmark_itoa64_):00327             BEQ  ADDDIGIT       ; OUTPUT EVERY DIGIT.   
1375 B61082           (benchmark_itoa64_):00328             LDA  DIGIT
1378 8130             (benchmark_itoa64_):00329             CMPA #'0'
137A 2608             (benchmark_itoa64_):00330             BNE  NONZERO        ; DIGIT IS NONZERO.
137C 1183128E         (benchmark_itoa64_):00331             CMPU #POWERS+144    ; IF ALL ZEROES, DO OUTPUT THE LAST ONE.
1380 2702             (benchmark_itoa64_):00332             BEQ  NONZERO
1382 2008             (benchmark_itoa64_):00333             BRA  SKIPDIGIT      ; SKIP THIS ZERO DIGIT.
1384                  (benchmark_itoa64_):00334         NONZERO:
1384 7F1084           (benchmark_itoa64_):00335             CLR  LEADZ          ; DONE IGNORING ZEROES.
1387                  (benchmark_itoa64_):00336         ADDDIGIT:
1387 B61082           (benchmark_itoa64_):00337             LDA  DIGIT          ; ADD DIGIT TO OUTPUT
138A A7A0             (benchmark_itoa64_):00338             STA  ,Y+
138C                  (benchmark_itoa64_):00339         SKIPDIGIT:
138C 3348             (benchmark_itoa64_):00340             LEAU 8,U            ; POINT U AT NEXT (LOWER) POWER OF 10, IF ANY.
138E 11831296         (benchmark_itoa64_):00341             CMPU #POWERS+152    ; IF PLACE VALUES REMAINING,
1392 26CA             (benchmark_itoa64_):00342             BNE  IT64_LOOP      ; DO NEXT ONE.
1394                  (benchmark_itoa64_):00343         IT64_DONE:
1394 8600             (benchmark_itoa64_):00344             LDA  #NUL
1396 A7A4             (benchmark_itoa64_):00345             STA  ,Y
1398 3510             (benchmark_itoa64_):00346             PULS X
139A 39               (benchmark_itoa64_):00347             RTS
                      (benchmark_itoa64_):00348         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00349         ; GIVEN A NULL-TERMINATED DECIMAL STRING AT Y, OUTPUTS AN 8-BYTE I64 AT X.
                      (benchmark_itoa64_):00350         ; IF INPUT IS MALFORMED, RETURNS SMALLEST POSSIBLE INT64 IN X.
                      (benchmark_itoa64_):00351         ; ON RETURN, X AND Y WILL BE UNCHANGED.
                      (benchmark_itoa64_):00352         ;------------------------------------------------------------------------------
139B                  (benchmark_itoa64_):00353         ATOI64:
139B 3430             (benchmark_itoa64_):00354             PSHS X,Y    
                      (benchmark_itoa64_):00355             ; VALIDATE INPUT AND GET ITS LENGTH, AND BAIL OUT IF INVALID.
139D C600             (benchmark_itoa64_):00356             LDB  #0             ; BYTE COUNT
139F F71085           (benchmark_itoa64_):00357             STB  ISNEG
13A2                  (benchmark_itoa64_):00358         ATVAL:                  ; VALIDATION LOOP:
13A2 A6A4             (benchmark_itoa64_):00359             LDA  ,Y             ; GET NEXT CHAR OF STRING.
13A4 4D               (benchmark_itoa64_):00360             TSTA
13A5 2723             (benchmark_itoa64_):00361             BEQ  ATVAL_END      ; IF NULL, WE'RE AT END OF STRING.
13A7 812D             (benchmark_itoa64_):00362             CMPA #'-'           ; IF NEGATIVE SIGN.
13A9 2711             (benchmark_itoa64_):00363             BEQ  ATNEG
13AB 8130             (benchmark_itoa64_):00364             CMPA #'0'
13AD 251B             (benchmark_itoa64_):00365             BLO  ATVAL_END      ; IF OTHER NON-DIGIT WE'RE AT THE END OF STRING.
13AF 8139             (benchmark_itoa64_):00366             CMPA #'9'
13B1 2217             (benchmark_itoa64_):00367             BHI  ATVAL_END
13B3 5C               (benchmark_itoa64_):00368             INCB                ; COUNT DECIMAL DIGITS,
13B4 C116             (benchmark_itoa64_):00369             CMPB #22
13B6 2258             (benchmark_itoa64_):00370             BHI  AT64_FAIL      ; IF COUNT EXCEEDS 22, FAIL.
13B8 3121             (benchmark_itoa64_):00371             LEAY 1,Y            ; IDX TO NEXT CHAR OF STRING,
13BA 20E6             (benchmark_itoa64_):00372             BRA  ATVAL          ; AND KEEP LOOPING.
13BC                  (benchmark_itoa64_):00373         ATNEG:
13BC B61085           (benchmark_itoa64_):00374             LDA  ISNEG          ; IF WE'RE SEEING REPEATED NEGATIVE SIGNS,
13BF 264F             (benchmark_itoa64_):00375             BNE  AT64_FAIL      ; THEN FAIL.
13C1 8601             (benchmark_itoa64_):00376             LDA  #1
13C3 B71085           (benchmark_itoa64_):00377             STA  ISNEG          ; NOTE IS NEGATIVE NUM,
13C6 3121             (benchmark_itoa64_):00378             LEAY 1,Y            ; IDX TO NEXT CHAR OF STRING,
13C8 20D8             (benchmark_itoa64_):00379             BRA  ATVAL          ; AND KEEP LOOPING.
13CA                  (benchmark_itoa64_):00380         ATVAL_END:
13CA 5D               (benchmark_itoa64_):00381             TSTB
13CB 2743             (benchmark_itoa64_):00382             BEQ  AT64_FAIL      ; IF NO DIGITS, FAIL.
13CD F71083           (benchmark_itoa64_):00383             STB  NDIGITS
                      (benchmark_itoa64_):00384             ; CLEAR 8 BYTES AT X
13D0 CD00000000       (benchmark_itoa64_):00385             LDQ  #0
13D5 10ED00           (benchmark_itoa64_):00386             STQ  0,X
13D8 10ED04           (benchmark_itoa64_):00387             STQ  4,X    
                      (benchmark_itoa64_):00388             ; IF INPUT IS NEGATIVE, POINT U AT THE THE NEGATIVE POWERS TABLE,
                      (benchmark_itoa64_):00389             ; ELSE POUNT U AT POSITIVE POWERS TABLE 
13DB B61085           (benchmark_itoa64_):00390             LDA  ISNEG
13DE 2605             (benchmark_itoa64_):00391             BNE  NEGPWRS
13E0                  (benchmark_itoa64_):00392         DOPOSPWRS:
13E0 CE1326           (benchmark_itoa64_):00393             LDU  #NEGPOWERS+144
13E3 2003             (benchmark_itoa64_):00394             BRA  ATSTART
13E5                  (benchmark_itoa64_):00395         NEGPWRS:    
13E5 CE128E           (benchmark_itoa64_):00396             LDU  #POWERS+144
                      (benchmark_itoa64_):00397             ; LOOP BACKWARDS THROUGH INPUT STRING, STARTING AT THE ONES' PLACE,
                      (benchmark_itoa64_):00398             ; AND FOR EACH DIGIT, MULTIPLY BY THE POWER AT U AND SUM IN RESULT.
                      (benchmark_itoa64_):00399             ; THEN DECREMENT STRING POS BY ONE AND DECREMENT U BY EIGHT.
13E8                  (benchmark_itoa64_):00400         ATSTART:
13E8 F61083           (benchmark_itoa64_):00401             LDB  NDIGITS
13EB 313F             (benchmark_itoa64_):00402             LEAY -1,Y           ; REFERENCE CHAR AT ONES PLACE    
13ED                  (benchmark_itoa64_):00403         ATDIGLOOP:
13ED A6A4             (benchmark_itoa64_):00404             LDA  ,Y             ; GET DIGIT
13EF 7A1083           (benchmark_itoa64_):00405             DEC  NDIGITS        ; DECREMENT DIGITCOUNT
13F2 8030             (benchmark_itoa64_):00406             SUBA #'0'           ; CONVERT DIGIT TO DECIMAL
13F4 270E             (benchmark_itoa64_):00407             BEQ  ATZERO
13F6 B71082           (benchmark_itoa64_):00408             STA  DIGIT    
13F9                  (benchmark_itoa64_):00409         ATILOOP:    
13F9 BD11C5           (benchmark_itoa64_):00410             JSR  SUB64_XU
13FC 7A1082           (benchmark_itoa64_):00411             DEC  DIGIT
13FF B61082           (benchmark_itoa64_):00412             LDA  DIGIT
1402 26F5             (benchmark_itoa64_):00413             BNE  ATILOOP
1404                  (benchmark_itoa64_):00414         ATZERO:
1404 313F             (benchmark_itoa64_):00415             LEAY -1,Y           ; REF NEXT PLACE VAL IN STRING
1406 3358             (benchmark_itoa64_):00416             LEAU -8,U           ; AND NEXT PLACE VALUE IN POWERS TABLE
1408 F61083           (benchmark_itoa64_):00417             LDB  NDIGITS
140B 26E0             (benchmark_itoa64_):00418             BNE  ATDIGLOOP      ; LOOP FOR REMAINING PLACE VALUES
140D                  (benchmark_itoa64_):00419         AT64_DONE:
140D 3530             (benchmark_itoa64_):00420             PULS X,Y
140F 39               (benchmark_itoa64_):00421             RTS
1410                  (benchmark_itoa64_):00422         AT64_FAIL:
1410 3530             (benchmark_itoa64_):00423             PULS X,Y
1412 BD1416           (benchmark_itoa64_):00424             JSR SET_MINI64_X
1415 39               (benchmark_itoa64_):00425             RTS
                      (benchmark_itoa64_):00426         ;------------------------------------------------------------------------------
                      (benchmark_itoa64_):00427         ; WRITES INT64_MIN TO ADRESS IN X
                      (benchmark_itoa64_):00428         ;------------------------------------------------------------------------------
1416                  (benchmark_itoa64_):00429         SET_MINI64_X
1416 CD00001296       (benchmark_itoa64_):00430             LDQ  #NEGPOWERS+0
141B 10ED00           (benchmark_itoa64_):00431             STQ  0,X
141E CD0000129A       (benchmark_itoa64_):00432             LDQ  #NEGPOWERS+4
1423 10ED04           (benchmark_itoa64_):00433             STQ  4,X
1426 39               (benchmark_itoa64_):00434             RTS
