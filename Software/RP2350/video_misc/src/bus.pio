; The Pugputer's bus, as the card sees it: two state machines watching /CS.
;
; /CS is low from Q rising to E falling (the GAL qualifies its decode with E or Q), so it
; marks a whole bus cycle: it falls once the address is valid, and rises as E falls, when
; a write's data is to be taken.
;
; The pin numbers here are as the PIO sees them: its GPIO window starts at GPIO16 (see
; ../src/config.h), so GPIO32 is 16.
.define CS_N 16 ; GPIO32 /CS

; bus_read: serves the CPU's reads with no CPU in the way. The register's index (A0-A4,
; and SD-select as bit 5) becomes the address of its byte in the register copy, which a
; DMA fetches; the byte is driven onto D0-D7 until /CS rises.
;   in_base = A0 (GPIO42, 6 pins: A0-A4, SD-select), jmp_pin = R/W (GPIO33),
;   out_base = D0 (GPIO34, 8 pins), ISR shifts left, OSR right, no autopush or autopull.
;   X holds the register copy's address / 64 (it is 64-byte aligned), set once at start.
.program bus_read
top:
.wrap_target
    wait 0 gpio CS_N
    jmp pin read            ; R/W high: a read
    wait 1 gpio CS_N        ; a write: bus_events takes it
.wrap
read:
    mov isr, x
    in pins, 6              ; ISR = the byte's address
    push block              ; to the DMA, which sends the byte back
    pull block
    out pins, 8
    mov osr, ~null
    out pindirs, 8          ; drive D0-D7 ...
    wait 1 gpio CS_N        ; ... until the cycle ends
    mov osr, null
    out pindirs, 8
    jmp top

; bus_events: tells core 0 about every access, reads too (some have side effects, such
; as stepping a data port): a word into the RX FIFO, which a DMA moves into a ring in
; SRAM, then PIO interrupt 0.
;   bits 0-7 the data (a write's), 8-13 the index (A0-A4, SD-select), 14 set for a read.
;   in_base = D0 (GPIO34, 14 pins: D0-D7, A0-A4, SD-select), jmp_pin = R/W,
;   ISR shifts left, OSR right, no autopush or autopull.
.program bus_events
.wrap_target
    wait 0 gpio CS_N
    mov osr, pins           ; the address, as /CS falls
    out null, 8
    out x, 6                ; X = the index
    jmp pin read
    wait 1 gpio CS_N        ; a write: its data, as /CS rises (E falls) ...
    mov y, pins             ; ... at once: the 6309 holds it only briefly
    in null, 1
    jmp both
read:
    set y, 1
    in y, 1
both:
    in x, 6
    in y, 8                 ; the data (a read's is junk)
    push block              ; (a read's goes at once, so core 0 can get on with it)
    irq set 0
    wait 1 gpio CS_N
.wrap
