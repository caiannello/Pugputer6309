; The Pugputer's bus, as the card sees it: two state machines watching /CS.
;
; /CS is low from Q rising to E falling (the GAL qualifies its decode with E or Q), so it
; marks a whole bus cycle: it falls once the address is valid, and rises as E falls, when
; a write's data is to be taken.
;
; WAIT GPIO takes the absolute GPIO number: the PIO's window starts at GPIO16 (see
; ../src/config.h), and the SDK subtracts that base as it loads the program. (Writing 16
; here, the window-relative number, waits on GPIO16 -- a DVI pin.)
.define CS_N 32 ; GPIO32 /CS

; bus_read: serves the CPU's reads with no CPU in the way. The register's index (A0-A4,
; and SD-select as bit 5) becomes the address of its byte in the register copy, which a
; DMA fetches; the byte is driven onto D0-D7 until /CS rises.
;   in_base = A0 (GPIO42, 6 pins: A0-A4, SD-select), jmp_pin = R/W (GPIO33),
;   out_base = D0 (GPIO34, 8 pins), ISR shifts left, OSR right, no autopush or autopull.
;   X holds the register copy's address / 64 (it is 64-byte aligned), set once at start.
.program bus_read
top:
.wrap_target
    wait 0 gpio CS_N
    jmp pin read            ; R/W high: a read
    wait 1 gpio CS_N        ; a write: bus_events takes it
.wrap
read:
    mov isr, x
    in pins, 6              ; ISR = the byte's address
    push block              ; to the DMA, which sends the byte back
    pull block
    out pins, 8
    mov osr, ~null
    out pindirs, 8          ; drive D0-D7 ...
    wait 1 gpio CS_N        ; ... until the cycle ends
    mov osr, null
    out pindirs, 8
    jmp top

; bus_events: tells core 0 about every access, reads too (some have side effects, such
; as stepping a data port): a word into the RX FIFO, which a DMA moves into a ring in
; SRAM, then PIO interrupt 0.
;   bits 0-7 the data (a write's; a read's is what the card drove), 8-13 the index (A0-A4,
;   SD-select), 14 set for a read, 16-21 the index as it was when /CS fell.
;   in_base = D0 (GPIO34, 14 pins: D0-D7, A0-A4, SD-select), jmp_pin = R/W,
;   ISR shifts left, OSR right, no autopush or autopull.
; The index that counts is the one as /CS rises, when everything has long settled. The one
; as /CS falls is kept for the diagnostics: the index must be settled by then too, as
; bus_read takes it then. (With VIDCARD.PLD revision 01 it often wasn't: SD-select came
; from the same GAL as /CS, qualified with the CPU card's /IO, and rose as /CS fell.
; Revision 02 makes it from the address alone.)
.program bus_events
.wrap_target
    wait 0 gpio CS_N
    mov osr, pins           ; as /CS falls
    out null, 8
    in osr, 6               ; (bits 16-21, once the rest is in) the index then
    in null, 1
    jmp pin read
    in null, 1              ; bit 14: a write
    jmp both
read:
    set x, 1
    in x, 1                 ; bit 14: a read
both:
    wait 1 gpio CS_N        ; as /CS rises (E falls): a write's data, and the index ...
    in pins, 14             ; ... at once: the 6309 holds them only briefly
    push block
    irq set 0
.wrap
